pkgname=avala-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Agents you can trust without watching'
arch=('x86_64')
url='https://github.com/rick-dev-creator/avala'
license=('MIT')
depends=('gcc-libs' 'glibc' 'zlib' 'openssl' 'icu' 'fontconfig' 'libx11' 'libice' 'libsm' 'libxi' 'libxrandr' 'libxcursor' 'wayland' 'libxkbcommon' 'libsecret' 'git')
optdepends=('claude-code: the Claude Code harness' 'github-cli: GitHub repositories and pull requests' 'tea: Gitea repositories and pull requests')
provides=('avala')
conflicts=('avala')
options=('!strip' '!debug')
source=('avala-@VERSION@-linux-x64.tar.gz::https://github.com/rick-dev-creator/avala/releases/download/v@VERSION@/avala-@VERSION@-linux-x64.tar.gz')
sha256sums=('@SHA256@')

package() {
  install -d "$pkgdir/opt/avala" "$pkgdir/usr/bin"
  cp -a 'avala-@VERSION@/.' "$pkgdir/opt/avala/"
  rm -r "$pkgdir/opt/avala/avala.desktop" "$pkgdir/opt/avala/avala.png" "$pkgdir/opt/avala/icons" "$pkgdir/opt/avala/LICENSE"
  ln -s /opt/avala/Avala "$pkgdir/usr/bin/avala"
  sed 's/^Exec=Avala$/Exec=avala/' 'avala-@VERSION@/avala.desktop' | install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/avala.desktop"
  install -d "$pkgdir/usr/share/icons"
  cp -a 'avala-@VERSION@/icons/hicolor' "$pkgdir/usr/share/icons/"
  install -Dm644 'avala-@VERSION@/LICENSE' "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

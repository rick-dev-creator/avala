root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,axaml,json}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_diagnostic.IDE0161.severity = error
dotnet_diagnostic.RS0030.severity = error
dotnet_diagnostic.VSTHRD002.severity = error
dotnet_diagnostic.VSTHRD100.severity = error
dotnet_diagnostic.VSTHRD101.severity = error
dotnet_diagnostic.VSTHRD103.severity = error
dotnet_diagnostic.VSTHRD110.severity = error
dotnet_diagnostic.VSTHRD200.severity = error
dotnet_diagnostic.MVVMTK0032.severity = none
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.VSTHRD003.severity = none

[**/obj/**/XunitAutoGeneratedEntryPoint.cs]
dotnet_diagnostic.RS0030.severity = none

[src/Avala.Sdk/Domain/GuardedTransitions.cs]
dotnet_diagnostic.RS0030.severity = none

{
  "build": {
    "content": [ { "files": [ "**/*.{md,yml}" ], "exclude": [ "_site/**", "template/**" ] } ],
    "resource": [ { "files": [ "media/**" ] } ],
    "output": "_site",
    "template": [ "default", "modern", "template" ],

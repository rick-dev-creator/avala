<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:regions="using:Avala.Fixtures.Violating.Regions"
             x:Class="Avala.Fixtures.Violating.Views.UntypedView"
             Background="#8DA2FB">
  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Comic Sans MS" />
    </Style>
  </UserControl.Styles>
  <StackPanel>
    <TextBlock Text="{ReflectionBinding Name}" FontSize="13" FontWeight="SemiBold" />
    <Border CornerRadius="14" BoxShadow="0 2 8 0 #4D000000" />
    <Button Content="Save" Click="OnSaveClicked" />
    <Button>
      <Path Data="M3 8H13" />
    </Button>
    <ContentControl regions:RegionHost.Region="Shell.Sidebar" />
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pane="using:Avala.Preview.Pane"
             x:Class="Avala.Preview.UI.RunScriptView"
             x:ClassModifier="internal"
             x:DataType="pane:IRunScriptViewModel">
  <Design.DataContext>
    <pane:DesignRunScriptViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Button#Run Path.icon">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsShown}">
    <TextBlock x:Name="Problem"
               Classes="caption attention"
               Text="{Binding Problem}"
               IsVisible="{Binding HasProblem}"
               MaxWidth="220"
               TextTrimming="CharacterEllipsis"
               ToolTip.Tip="{Binding Problem}"
               VerticalAlignment="Center" />
    <Button x:Name="Run" Classes="line" Command="{Binding ToggleCommand}" ToolTip.Tip="Run the project in its worktree on its own ports">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Path Classes="icon small" Data="{StaticResource IconStop}" IsVisible="{Binding IsRunning}" />
        <Path Classes="icon small" Data="{StaticResource IconPlay}" IsVisible="{Binding !IsRunning}" />
        <TextBlock x:Name="RunLabel" Classes="chip-label" Text="{Binding Label}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </StackPanel>
</UserControl>

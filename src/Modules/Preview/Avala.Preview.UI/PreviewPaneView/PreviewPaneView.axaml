<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pane="using:Avala.Preview.Pane"
             xmlns:ui="using:Avala.Preview.UI"
             x:Class="Avala.Preview.UI.PreviewPaneView"
             x:ClassModifier="internal"
             x:DataType="pane:IPreviewPaneViewModel">
  <Design.DataContext>
    <pane:DesignPreviewPaneViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Button.glyph Path.icon, ToggleButton.glyph Path.icon">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>
    <Style Selector="Border#AddressPill">
      <Setter Property="Background" Value="{DynamicResource FillInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderPillBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
      <Setter Property="Padding" Value="{DynamicResource PaddingPill}" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Panel#Stage.framed">
      <Setter Property="Background" Value="{DynamicResource SurfaceCanvasBrush}" />
    </Style>
    <Style Selector="Panel#Stage.framed Panel#Device">
      <Setter Property="Margin" Value="28" />
    </Style>
    <Style Selector="Panel#Stage.framed Border#Body">
      <Setter Property="Background" Value="{DynamicResource DeviceBodyBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DeviceRimBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowFloat}" />
    </Style>
    <Style Selector="Panel#Stage.framed Border#Screen">
      <Setter Property="Background" Value="{DynamicResource DeviceIslandBrush}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Panel#Device.phone Border#Body">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusDevicePhone}" />
    </Style>
    <Style Selector="Panel#Device.phone Border#Screen">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusDevicePhoneScreen}" />
    </Style>
    <Style Selector="Panel#Device.android Border#Body">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusDeviceAndroid}" />
    </Style>
    <Style Selector="Panel#Device.android Border#Screen">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusDeviceAndroidScreen}" />
    </Style>
    <Style Selector="Panel#Device.tablet Border#Body">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusDeviceTablet}" />
    </Style>
    <Style Selector="Panel#Device.tablet Border#Screen">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusDeviceTabletScreen}" />
    </Style>
    <Style Selector="Panel#Device Border.part">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Panel#Device.phone Border#Island">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Width" Value="104" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusDeviceIsland}" />
      <Setter Property="Background" Value="{DynamicResource DeviceIslandBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,22,0,0" />
    </Style>
    <Style Selector="Panel#Device.phone.turned Border#Island">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="104" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="22,0,0,0" />
    </Style>
    <Style Selector="Panel#Device.android Border#Lens">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusDeviceLens}" />
      <Setter Property="Background" Value="{DynamicResource DeviceIslandBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,22,0,0" />
    </Style>
    <Style Selector="Panel#Device.tablet Border#Lens">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusDeviceLensSmall}" />
      <Setter Property="Background" Value="{DynamicResource DeviceLensBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,7,0,0" />
    </Style>
    <Style Selector="Panel#Device.android.turned Border#Lens">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="22,0,0,0" />
    </Style>
    <Style Selector="Panel#Device.tablet.turned Border#Lens">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="7,0,0,0" />
    </Style>
    <Style Selector="Panel#Device.phone Border.button, Panel#Device.android Border.button">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Width" Value="3" />
      <Setter Property="Background" Value="{DynamicResource DeviceButtonBrush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Panel#Device.turned Border.button">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel#Device Border#Power">
      <Setter Property="Height" Value="78" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,196,-3,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusDeviceButtonRight}" />
    </Style>
    <Style Selector="Panel#Device Border#VolumeUp">
      <Setter Property="Height" Value="56" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="-3,176,0,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusDeviceButtonLeft}" />
    </Style>
    <Style Selector="Panel#Device Border#VolumeDown">
      <Setter Property="Height" Value="56" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="-3,244,0,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusDeviceButtonLeft}" />
    </Style>
    <Style Selector="Border#RefusalBar">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="{DynamicResource PaddingRow}" />
    </Style>
  </UserControl.Styles>
  <DockPanel Background="{DynamicResource SurfaceWindowBrush}">
    <Border x:Name="Toolbar"
            DockPanel.Dock="Top"
            Padding="10,10,10,9"
            BorderBrush="{DynamicResource EdgeBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
        <Button x:Name="Back"
                Classes="glyph"
                Command="{Binding BackCommand}"
                ToolTip.Tip="Back"
                AutomationProperties.Name="Back">
          <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconBack}" />
        </Button>
        <Button x:Name="Reload"
                Grid.Column="1"
                Classes="glyph"
                Command="{Binding ReloadCommand}"
                ToolTip.Tip="Reload"
                AutomationProperties.Name="Reload">
          <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconRetry}" />
        </Button>
        <Border x:Name="AddressPill" Grid.Column="2" Margin="8,0">
          <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="Address" Classes="mono" Text="{Binding Address}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Ellipse x:Name="LiveDot" Classes="dot" Classes.hollow="{Binding !IsLive}" />
            <TextBlock x:Name="State" Classes="caption" Text="{Binding State}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <ContentControl x:Name="DeviceFrame" Grid.Column="3" Content="{Binding Frame}" />
        <ToggleButton x:Name="Network"
                      Grid.Column="4"
                      Classes="glyph"
                      IsChecked="{Binding AllowsNetwork, Mode=OneWay}"
                      Command="{Binding ToggleNetworkCommand}"
                      ToolTip.Tip="Allow network: let this preview load scripts and data from other sites until Avala restarts"
                      AutomationProperties.Name="Allow network">
          <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconWeb}" />
        </ToggleButton>
        <Button x:Name="OpenInBrowser"
                Grid.Column="5"
                Classes="glyph"
                Command="{Binding OpenInBrowserCommand}"
                ToolTip.Tip="Open in browser"
                AutomationProperties.Name="Open in browser">
          <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconExternal}" />
        </Button>
        <Button x:Name="Close"
                Grid.Column="6"
                Classes="glyph"
                Command="{Binding CloseCommand}"
                ToolTip.Tip="Close preview"
                AutomationProperties.Name="Close preview">
          <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconCross}" />
        </Button>
      </Grid>
    </Border>
    <Border x:Name="RefusalBar" DockPanel.Dock="Top" IsVisible="{Binding HasRefusal}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="Refusal" Text="{Binding Refusal}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button x:Name="OpenRefused" Grid.Column="1" Classes="primary" Margin="10,0,0,0" Content="Open in browser" Command="{Binding OpenRefusedCommand}" />
        <Button x:Name="DismissRefusal" Grid.Column="2" Classes="ghost" Margin="6,0,0,0" Content="Stay here" Command="{Binding DismissRefusalCommand}" />
      </Grid>
    </Border>
    <Panel x:Name="Stage" Classes.framed="{Binding Frame.IsFramed}">
      <Panel x:Name="Device"
             IsVisible="{Binding IsEmbedded}"
             MaxWidth="{Binding Frame.OuterWidth}"
             MaxHeight="{Binding Frame.OuterHeight}"
             Classes.phone="{Binding Frame.IsPhone}"
             Classes.android="{Binding Frame.IsAndroid}"
             Classes.tablet="{Binding Frame.IsTablet}"
             Classes.turned="{Binding Frame.IsTurned}">
        <Border x:Name="Body" />
        <Border x:Name="Screen" Margin="{Binding Frame.Bezel, Converter={x:Static ui:DeviceInsets.Around}}">
          <ContentControl x:Name="Page" Content="{Binding Surface}" />
        </Border>
        <Border x:Name="Island" Classes="part" />
        <Border x:Name="Lens" Classes="part" />
        <Border x:Name="Power" Classes="part button" />
        <Border x:Name="VolumeUp" Classes="part button" />
        <Border x:Name="VolumeDown" Classes="part button" />
      </Panel>
      <StackPanel x:Name="Notice"
                  IsVisible="{Binding !IsEmbedded}"
                  MaxWidth="320"
                  Spacing="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <TextBlock x:Name="NoticeText" Classes="secondary" Text="{Binding Notice}" TextWrapping="Wrap" TextAlignment="Center" />
        <Button x:Name="NoticeOpen"
                Classes="line"
                HorizontalAlignment="Center"
                Content="Open in browser"
                Command="{Binding OpenInBrowserCommand}" />
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>

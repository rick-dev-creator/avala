<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Avala.ClaudeCode.Settings"
             x:Class="Avala.ClaudeCode.UI.ClaudeCodeLoginView"
             x:ClassModifier="internal"
             x:DataType="settings:IClaudeCodeLoginViewModel">
  <Design.DataContext>
    <settings:DesignClaudeCodeLoginViewModel />
  </Design.DataContext>
  <Border Classes="grouped">
    <StackPanel>
      <StackPanel Margin="16,12" Spacing="8">
        <DockPanel>
          <Border DockPanel.Dock="Right" Classes="segments" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="Small"
                      Classes="segment"
                      Classes.selected="{Binding IsSmall}"
                      Content="150k"
                      Command="{Binding ChooseCommand}"
                      CommandParameter="{x:Static settings:CompactChoice.Small}"
                      ToolTip.Tip="Summarize at about 117k tokens"
                      AutomationProperties.Name="Compact at 150 thousand tokens" />
              <Button x:Name="Standard"
                      Classes="segment"
                      Classes.selected="{Binding IsStandard}"
                      Content="250k"
                      Command="{Binding ChooseCommand}"
                      CommandParameter="{x:Static settings:CompactChoice.Standard}"
                      ToolTip.Tip="Avala's default · summarize at about 217k tokens"
                      AutomationProperties.Name="Compact at 250 thousand tokens" />
              <Button x:Name="Large"
                      Classes="segment"
                      Classes.selected="{Binding IsLarge}"
                      Content="500k"
                      Command="{Binding ChooseCommand}"
                      CommandParameter="{x:Static settings:CompactChoice.Large}"
                      ToolTip.Tip="Summarize at about 467k tokens"
                      AutomationProperties.Name="Compact at 500 thousand tokens" />
              <Button x:Name="Full"
                      Classes="segment"
                      Classes.selected="{Binding IsFull}"
                      Content="1M"
                      Command="{Binding ChooseCommand}"
                      CommandParameter="{x:Static settings:CompactChoice.Full}"
                      ToolTip.Tip="Claude Code's own default when started by Avala · summarize at about 967k tokens"
                      AutomationProperties.Name="Compact at one million tokens" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="LoginName" Classes="strong" Text="{Binding Name}" />
            <TextBlock x:Name="Where" Classes="caption" Text="{Binding Where}" />
          </StackPanel>
        </DockPanel>
        <TextBlock x:Name="Summary" Classes="caption" Text="{Binding Summary}" TextWrapping="Wrap" />
        <TextBlock x:Name="Custom" Classes="caption attention" Text="{Binding Custom}" IsVisible="{Binding HasCustom}" />
      </StackPanel>
      <Border Classes="separator" Margin="16,0" />
      <DockPanel Margin="16,12">
        <ToggleSwitch x:Name="AutoCompact"
                      DockPanel.Dock="Right"
                      OnContent=""
                      OffContent=""
                      IsChecked="{Binding AutoCompact, Mode=OneWay}"
                      Command="{Binding ToggleAutoCompactCommand}"
                      AutomationProperties.Name="Summarize automatically" />
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Summarize automatically" />
          <TextBlock Classes="caption" Text="Claude Code's own compaction, when the conversation reaches its window." TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <Border Classes="separator" Margin="16,0" />
      <DockPanel Margin="16,12">
        <ToggleSwitch x:Name="IdleCompaction"
                      DockPanel.Dock="Right"
                      OnContent=""
                      OffContent=""
                      IsChecked="{Binding IdleCompaction, Mode=OneWay}"
                      Command="{Binding ToggleIdleCompactionCommand}"
                      AutomationProperties.Name="Summarize while idle" />
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Summarize while idle" />
          <TextBlock Classes="caption" Text="Compacts a long conversation before its cache expires, so the next message is cheaper." TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <DockPanel Margin="16,0,16,12" IsVisible="{Binding HasProblem}">
        <Button x:Name="Retry" DockPanel.Dock="Right" Classes="link" Content="Try again" Command="{Binding RetryCommand}" />
        <TextBlock x:Name="Problem" Classes="caption failure" Text="{Binding Problem}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:newJob="using:Avala.Workbench.NewJob"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.NewJobView"
             x:ClassModifier="internal"
             x:DataType="newJob:INewJobViewModel">
  <Design.DataContext>
    <newJob:DesignNewJobViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusButton}" />
      <Setter Property="Background" Value="{DynamicResource FillInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderInputBrush}" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="pageHeader">
        <TextBlock x:Name="Title" Classes="pageTitle" Text="{Binding Title}" VerticalAlignment="Center" />
      </Border>
      <ScrollViewer>
        <StackPanel Margin="24,36,24,48" Spacing="16" MaxWidth="640">
          <TextBlock Classes="title" Text="What should the agent do?" />
          <Border Classes="float arrive-snappy">
            <StackPanel Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Repository" />
                <ContentControl x:Name="Repository" Content="{Binding RepositoryPicker}" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Instruction" />
                <TextBox x:Name="Instruction"
                         Text="{Binding Instruction}"
                         AcceptsReturn="True"
                         MinHeight="132"
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource FontSizeReading}"
                         PlaceholderText="Fix the failing test in money/minor_test.go without changing the public API.">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SubmitCommand}" />
                    <KeyBinding Gesture="Ctrl+Shift+Enter" Command="{Binding StartWithoutRepositoryCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
              </StackPanel>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
                <StackPanel Spacing="6">
                  <TextBlock Classes="section" Text="Connection" />
                  <ComboBox x:Name="Connection"
                            ItemsSource="{Binding Options}"
                            SelectedValueBinding="{Binding Name, x:DataType=newJob:IConnectionOptionViewModel}"
                            SelectedValue="{Binding Connection, Converter={x:Static states:Kept.Selection}}"
                            HorizontalContentAlignment="Stretch" />
                </StackPanel>
                <TextBlock x:Name="Route"
                           Grid.Row="1"
                           Classes="caption fade-in"
                           Classes.attention="{Binding IsRouteAttention}"
                           TextWrapping="Wrap"
                           Text="{Binding Route}"
                           IsVisible="{Binding Route, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Classes="section" Text="Autonomy" />
                  <ComboBox x:Name="Autonomy" ItemsSource="{Binding Autonomies}" SelectedItem="{Binding Autonomy, Converter={x:Static states:Kept.Selection}}" />
                </StackPanel>
                <TextBlock x:Name="AutonomyNote"
                           Grid.Row="1"
                           Grid.Column="1"
                           Classes="caption fade-in"
                           TextWrapping="Wrap"
                           Text="{Binding AutonomyNote}" />
              </Grid>
              <ContentControl x:Name="JobOptions" Content="{Binding JobOptions}" />
              <Border x:Name="Error"
                      Classes="quiet"
                      BorderBrush="{DynamicResource FailureBorderBrush}"
                      Padding="12,8"
                      IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock x:Name="ErrorText" Classes="caption failure" Text="{Binding Error}" TextWrapping="Wrap" />
              </Border>
              <DockPanel>
                <Button x:Name="Submit"
                        DockPanel.Dock="Right"
                        Classes="primary"
                        Content="Start"
                        ToolTip.Tip="Ctrl+Enter · Ctrl+Shift+Enter starts without a repository"
                        Command="{Binding SubmitCommand}" />
                <TextBlock x:Name="Submitted"
                           Classes="caption fade-in"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Submitted}"
                           IsVisible="{Binding Submitted, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
    <Panel x:Name="CloneSheet" IsVisible="{Binding RepositoryField.Cloning.IsOpen}">
      <Border Background="{DynamicResource ScrimSheetBrush}" Classes="fade-in" />
      <ContentControl x:Name="CloneSheetContent" Content="{Binding RepositoryField.Cloning}" />
    </Panel>
    <Panel x:Name="ConnectSheet" IsVisible="{Binding RepositoryField.Cloning.Connect.IsOpen}">
      <Border Background="{DynamicResource ScrimSheetBrush}" Classes="fade-in" />
      <ContentControl x:Name="ConnectSheetContent" Content="{Binding RepositoryField.Cloning.Connect}" />
    </Panel>
  </Panel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:newjob="using:Avala.Workbench.NewJob"
             x:Class="Avala.Workbench.UI.NewJobView"
             x:ClassModifier="internal"
             x:DataType="newjob:INewJobViewModel">
  <Design.DataContext>
    <newjob:DesignNewJobViewModel />
  </Design.DataContext>
  <StackPanel Margin="24,16" Spacing="8" MaxWidth="{DynamicResource ReadingWidth}" HorizontalAlignment="Left">
    <TextBlock Classes="title" Text="{Binding Title}" Margin="0,0,0,8" />
    <TextBlock Classes="section" Text="Repository" />
    <AutoCompleteBox x:Name="Repository" Text="{Binding Repository}" ItemsSource="{Binding Repositories}" />
    <TextBlock Classes="section" Text="Instruction" />
    <TextBox x:Name="Instruction"
             Text="{Binding Instruction}"
             AcceptsReturn="True"
             MinHeight="120"
             TextWrapping="Wrap"
             PlaceholderText="What should the agent do?">
      <TextBox.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SubmitCommand}" />
      </TextBox.KeyBindings>
    </TextBox>
    <TextBlock Classes="section" Text="Connection" />
    <ComboBox x:Name="Connection" ItemsSource="{Binding Connections}" SelectedItem="{Binding Connection}" />
    <CheckBox x:Name="Supervised" Content="Supervised, even if the repository declares more autonomy" IsChecked="{Binding Supervised}" />
    <Button x:Name="Submit" Classes="primary" Content="Submit" Command="{Binding SubmitCommand}" HorizontalAlignment="Left" />
    <TextBlock x:Name="Error"
               Classes="caption failure"
               Text="{Binding Error}"
               TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock x:Name="Submitted"
               Classes="caption"
               Text="{Binding Submitted}"
               IsVisible="{Binding Submitted, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>

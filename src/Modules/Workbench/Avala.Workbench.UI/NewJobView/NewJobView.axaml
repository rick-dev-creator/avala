<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:newJob="using:Avala.Workbench.NewJob"
             x:Class="Avala.Workbench.UI.NewJobView"
             x:ClassModifier="internal"
             x:DataType="newJob:INewJobViewModel">
  <Design.DataContext>
    <newJob:DesignNewJobViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="AutoCompleteBox, ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusButton}" />
      <Setter Property="Background" Value="{DynamicResource FillInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderInputBrush}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="pageHeader">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="caption" Text="Ctrl+Enter submits" VerticalAlignment="Center" />
        <TextBlock x:Name="Title" Classes="pageTitle" Text="{Binding Title}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="24,36,24,48" Spacing="16" MaxWidth="640">
        <StackPanel Spacing="2">
          <TextBlock Classes="title" Text="What should the agent do?" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="The job runs in its own worktree of the repository, under the repository's rules, and comes back to you for review." />
        </StackPanel>
        <Border Classes="float arrive-snappy">
          <StackPanel Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Classes="section" Text="Repository" />
              <AutoCompleteBox x:Name="Repository"
                               Text="{Binding Repository}"
                               ItemsSource="{Binding Repositories}"
                               FilterMode="ContainsOrdinal"
                               PlaceholderText="~/code/repository" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="section" Text="Instruction" />
              <TextBox x:Name="Instruction"
                       Text="{Binding Instruction}"
                       AcceptsReturn="True"
                       MinHeight="132"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeReading}"
                       PlaceholderText="Fix the failing test in money/minor_test.go without changing the public API.">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SubmitCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Connection" />
                <ComboBox x:Name="Connection" ItemsSource="{Binding Connections}" SelectedItem="{Binding Connection}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="section" Text="Autonomy" />
                <CheckBox x:Name="Supervised" IsChecked="{Binding Supervised}">
                  <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="Supervised: ask me before anything a rule does not allow" />
                </CheckBox>
              </StackPanel>
            </Grid>
            <Border x:Name="Error"
                    Classes="quiet"
                    BorderBrush="{DynamicResource FailureBorderBrush}"
                    Padding="12,8"
                    IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock x:Name="ErrorText" Classes="caption failure" Text="{Binding Error}" TextWrapping="Wrap" />
            </Border>
            <DockPanel>
              <Button x:Name="Submit" DockPanel.Dock="Right" Classes="primary" Content="Start the job" Command="{Binding SubmitCommand}" />
              <TextBlock x:Name="Submitted"
                         Classes="caption fade-in"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Submitted}"
                         IsVisible="{Binding Submitted, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:Avala.Workbench.Inspector"
             x:Class="Avala.Workbench.UI.AutonomySectionView"
             x:ClassModifier="internal"
             x:DataType="inspector:AutonomySectionViewModel">
  <StackPanel Spacing="4">
    <TextBlock Text="{Binding Autonomy}" />
    <TextBlock Text="{Binding Connection}" Opacity="0.7" />
  </StackPanel>
</UserControl>

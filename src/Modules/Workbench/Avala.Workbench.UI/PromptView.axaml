<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             x:Class="Avala.Workbench.UI.PromptView"
             x:ClassModifier="internal"
             x:DataType="conversation:PromptViewModel">
  <StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding Origin}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Outcome}" Opacity="0.6" />
    </StackPanel>
    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>

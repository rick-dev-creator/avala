<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docs="using:Avala.Workbench.Docs"
             x:Class="Avala.Workbench.UI.DocsPaneView"
             x:ClassModifier="internal"
             x:DataType="docs:IDocsPaneViewModel">
  <Design.DataContext>
    <docs:DesignDocsPaneViewModel />
  </Design.DataContext>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Button.glyph Path.icon">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>
    <Style Selector="Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
    </Style>
    <Style Selector="Border#PaneHeader">
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
    </Style>
  </UserControl.Styles>
  <Border x:Name="Surface" IsVisible="{Binding IsOpen}">
    <DockPanel>
      <Border x:Name="PaneHeader" DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="18,0,10,0" Height="44">
        <DockPanel>
          <Button x:Name="Close"
                  DockPanel.Dock="Right"
                  Classes="glyph"
                  Command="{Binding CloseCommand}"
                  ToolTip.Tip="Close"
                  AutomationProperties.Name="Close the docs pane">
            <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconCross}" />
          </Button>
          <Button x:Name="OpenSite"
                  DockPanel.Dock="Right"
                  Classes="glyph"
                  IsVisible="{Binding CanOpenSite}"
                  Command="{Binding OpenSiteCommand}"
                  ToolTip.Tip="Open the docs site"
                  AutomationProperties.Name="Open the docs site">
            <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconWeb}" />
          </Button>
          <TextBlock Classes="strong" Text="Docs" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <ScrollViewer>
        <StackPanel Margin="12,12,12,20" Spacing="14">
          <Border Classes="grouped" ClipToBounds="True">
            <StackPanel>
              <DockPanel Margin="14,12,14,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Ellipse Classes="dot accent" IsVisible="{Binding IsWriting}" />
                  <TextBlock x:Name="State" Classes="caption" Text="{Binding State}" />
                </StackPanel>
                <TextBlock x:Name="Feature" Classes="strong" Text="{Binding Feature}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <TextBlock x:Name="Problem" Classes="caption" Margin="14,0,14,4" TextWrapping="Wrap" Text="{Binding Problem}" IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ContentControl x:Name="Player" Height="480" Content="{Binding Player}" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="SiteHint" Classes="caption" Margin="4,0" TextWrapping="Wrap" Text="{Binding SiteHint}" IsVisible="{Binding SiteHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ContentControl x:Name="History" Content="{Binding History}" />
          <StackPanel Spacing="4" IsVisible="{Binding !!Others.Count}">
            <TextBlock Classes="caption" Margin="4,0" Text="In this repository" />
            <ItemsControl x:Name="Others" ItemsSource="{Binding Others}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>

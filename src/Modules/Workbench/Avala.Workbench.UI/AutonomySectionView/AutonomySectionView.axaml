<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:Avala.Workbench.Inspector"
             xmlns:ui="using:Avala.Components.UI"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.AutonomySectionView"
             x:ClassModifier="internal"
             x:DataType="inspector:IAutonomySectionViewModel">
  <Design.DataContext>
    <inspector:DesignAutonomySectionViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.value.tertiary">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
  </UserControl.Styles>
  <ui:Fold x:Name="Section" Header="Autonomy &amp; connection" Fact="{Binding Fact}">
    <StackPanel Margin="28,0,12,12" Spacing="7">
      <TextBlock x:Name="Loading" Classes="caption" theme:Motion.Loop="Pulse" Text="Reading…" IsVisible="{Binding !IsLoaded}" />
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsLoaded}">
        <TextBlock Classes="caption secondary" Text="Autonomy" />
        <TextBlock x:Name="Autonomy"
                   Grid.Column="1"
                   Classes="caption"
                   Margin="12,0,0,0"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextAlignment="Right"
                   TextWrapping="Wrap"
                   Text="{Binding Autonomy}" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsLoaded}">
        <TextBlock Classes="caption secondary" Text="Connection" />
        <TextBlock x:Name="Connection"
                   Grid.Column="1"
                   Classes="caption"
                   Margin="12,0,0,0"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextAlignment="Right"
                   TextWrapping="Wrap"
                   Text="{Binding Connection}" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Model, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="caption secondary" Text="Ran with" />
        <TextBlock x:Name="Model"
                   Grid.Column="1"
                   Classes="caption"
                   Margin="12,0,0,0"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextAlignment="Right"
                   TextWrapping="Wrap"
                   Text="{Binding Model}" />
      </Grid>
      <TextBlock x:Name="Reason"
                 Classes="caption"
                 TextWrapping="Wrap"
                 Text="{Binding Reason}"
                 IsVisible="{Binding Reason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ItemsControl x:Name="Compared" ItemsSource="{Binding Compared}" IsVisible="{Binding !!Compared.Count}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="inspector:CapacityLine">
            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
              <TextBlock x:Name="ComparedConnection"
                         Classes="caption value"
                         Classes.tertiary="{Binding !IsChosen}"
                         Text="{Binding Connection}" />
              <TextBlock x:Name="CapacityReading"
                         Grid.Column="1"
                         Classes="caption"
                         Classes.attention="{Binding IsAtLimit}"
                         Margin="12,0,0,0"
                         TextAlignment="Right"
                         TextWrapping="Wrap"
                         Text="{Binding Reading, Converter={x:Static states:Texts.Unbroken}}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="Waiting"
                 Classes="caption attention"
                 TextWrapping="Wrap"
                 Text="{Binding Waiting, Converter={x:Static states:Texts.Unbroken}}"
                 IsVisible="{Binding Waiting, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ItemsControl x:Name="Handoffs" ItemsSource="{Binding Handoffs}" IsVisible="{Binding !!Handoffs.Count}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="inspector:HandoffLine">
            <StackPanel Margin="0,2" Spacing="2">
              <TextBlock x:Name="HandoffMoved"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Text="{Binding Moved, Converter={x:Static states:Texts.Unbroken}}"
                         IsVisible="{Binding Moved, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock x:Name="HandoffSpent" Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Spent, Converter={x:Static states:Texts.Unbroken}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ui:Fold>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Avala.Workbench.Settings"
             x:Class="Avala.Workbench.UI.MachineSettingsView"
             x:ClassModifier="internal"
             x:DataType="settings:MachineSettingsViewModel">
  <StackPanel Spacing="8">
    <TextBlock Text="{Binding Error}" Foreground="IndianRed" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding ConnectionsFile, StringFormat='connections.json: {0}'}" VerticalAlignment="Center" />
      <Button Content="Open connections.json" Command="{Binding OpenConnectionsCommand}" />
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Connections}" />
    <TextBlock Text="{Binding SupervisionFile, StringFormat='supervision.json: {0}'}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding Silence, StringFormat='Silence window: {0}'}" VerticalAlignment="Center" />
      <TextBox Width="100" Text="{Binding SilenceDraft}" />
      <Button Content="Save" Command="{Binding SaveSilenceCommand}" />
    </StackPanel>
    <TextBlock Text="{Binding Resources, StringFormat='resources.json: {0}'}" />
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             xmlns:events="using:Avala.Agents.Contracts.Events"
             x:Class="Avala.Workbench.UI.PlanView"
             x:ClassModifier="internal"
             x:DataType="conversation:PlanViewModel">
  <StackPanel>
    <TextBlock Text="{Binding Progress, StringFormat='Plan · {0}'}" FontWeight="SemiBold" />
    <ItemsControl ItemsSource="{Binding Steps}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="events:PlanStep">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Status}" Opacity="0.6" />
            <TextBlock Text="{Binding Title}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

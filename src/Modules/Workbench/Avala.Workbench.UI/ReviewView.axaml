<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:review="using:Avala.Workbench.Review"
             x:Class="Avala.Workbench.UI.ReviewView"
             x:ClassModifier="internal"
             x:DataType="review:ReviewViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10">
      <TextBlock Text="{Binding Verdict}" FontSize="18" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Exceptions}" IsVisible="{Binding HasExceptions}" />
      <TextBlock Text="{Binding Quiet}" Opacity="0.6" />
      <TextBlock Text="{Binding Changes}" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Files}" />
      <TextBox Text="{Binding Feedback}" PlaceholderText="Feedback for another round" AcceptsReturn="True" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Approve" Command="{Binding ApproveCommand}" />
        <Button Content="Send back" Command="{Binding SendBackCommand}" />
        <Button Content="Discard…" Command="{Binding RequestDiscardCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConfirmingDiscard}">
        <TextBlock Text="Discard the job and its worktree?" VerticalAlignment="Center" />
        <Button Content="Discard" Command="{Binding ConfirmDiscardCommand}" />
        <Button Content="Keep it" Command="{Binding CancelDiscardCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Conflicts}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

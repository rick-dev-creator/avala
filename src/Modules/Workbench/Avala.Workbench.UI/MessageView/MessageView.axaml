<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             xmlns:markdown="using:Avala.Components.UI.Markdown"
             x:Class="Avala.Workbench.UI.MessageView"
             x:ClassModifier="internal"
             x:DataType="conversation:IMessageViewModel"
             Classes="fade-in"
             Margin="0,10">
  <Design.DataContext>
    <conversation:DesignMessageViewModel />
  </Design.DataContext>
  <StackPanel Spacing="6">
    <markdown:MarkdownText x:Name="Text"
                           Classes="reading"
                           Classes.streaming="{Binding IsStreaming}"
                           Markdown="{Binding Text}"
                           IsLive="{Binding IsStreaming}"
                           LinkCommand="{Binding OpenLinkCommand}" />
    <TextBlock x:Name="LinkNotice"
               Classes="caption"
               TextWrapping="Wrap"
               Text="{Binding LinkNotice}"
               IsVisible="{Binding LinkNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>

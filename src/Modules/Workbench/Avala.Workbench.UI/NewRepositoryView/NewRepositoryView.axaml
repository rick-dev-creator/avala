<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:choice="using:Avala.Workbench.RepositoryChoice"
             x:Class="Avala.Workbench.UI.NewRepositoryView"
             x:ClassModifier="internal"
             x:DataType="choice:INewRepositoryViewModel">
  <Design.DataContext>
    <choice:DesignNewRepositoryViewModel />
  </Design.DataContext>
  <Border Classes="quiet" Padding="12,10">
    <StackPanel Spacing="8">
      <TextBlock Classes="section" Text="New repository" />
      <TextBlock x:Name="ParentFolder"
                 Classes="caption"
                 TextWrapping="Wrap"
                 Text="{Binding Parent, StringFormat='In {0}'}" />
      <TextBox x:Name="NewRepositoryName"
               Text="{Binding Name}"
               PlaceholderText="Name of the folder"
               AutomationProperties.Name="Name of the new repository">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
          <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <TextBlock x:Name="CreationError"
                 Classes="caption failure"
                 TextWrapping="Wrap"
                 Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="Create" Classes="primary" Content="Create" Command="{Binding CreateCommand}" />
        <Button x:Name="CancelCreation" Content="Cancel" Command="{Binding CancelCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

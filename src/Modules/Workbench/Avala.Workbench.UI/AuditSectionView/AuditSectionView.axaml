<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:Avala.Workbench.Inspector"
             x:Class="Avala.Workbench.UI.AuditSectionView"
             x:ClassModifier="internal"
             x:DataType="inspector:IAuditSectionViewModel">
  <Design.DataContext>
    <inspector:DesignAuditSectionViewModel />
  </Design.DataContext>
  <Expander x:Name="Section">
    <Expander.Header>
      <TextBlock Classes="section" Text="Decisions and assumptions" />
    </Expander.Header>
    <StackPanel Spacing="4">
      <TextBlock x:Name="Loading" Classes="caption pulse" Text="Reading…" IsVisible="{Binding !IsLoaded}" />
      <TextBlock x:Name="Summary" Classes="strong" Text="{Binding Summary}" TextWrapping="Wrap" />
      <ItemsControl x:Name="Decisions" ItemsSource="{Binding Decisions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl x:Name="Assumptions" ItemsSource="{Binding Assumptions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption attention" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Expander>
</UserControl>

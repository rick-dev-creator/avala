<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:Avala.Workbench.Inspector"
             xmlns:ui="using:Avala.Components.UI"
             x:Class="Avala.Workbench.UI.AuditSectionView"
             x:ClassModifier="internal"
             x:DataType="inspector:IAuditSectionViewModel">
  <Design.DataContext>
    <inspector:DesignAuditSectionViewModel />
  </Design.DataContext>
  <ui:Fold x:Name="Section"
           Header="Decisions"
           Fact="{Binding Fact}"
           Classes.attention="{Binding IsAttention}">
    <StackPanel Margin="28,0,12,12" Spacing="7">
      <TextBlock x:Name="Loading" Classes="caption pulse" Text="Reading…" IsVisible="{Binding !IsLoaded}" />
      <TextBlock x:Name="Summary"
                 Classes="caption"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Text="{Binding Summary}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ItemsControl x:Name="Decisions" ItemsSource="{Binding Decisions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="7" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption secondary" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="AssumptionsHeading"
                 Classes="section"
                 Margin="0,4,0,0"
                 Text="Assumptions"
                 IsVisible="{Binding !!Assumptions.Count}" />
      <ItemsControl x:Name="Assumptions" ItemsSource="{Binding Assumptions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="7" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption secondary" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ui:Fold>
</UserControl>

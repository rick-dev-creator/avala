<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Avala.Workbench.Overview"
             x:Class="Avala.Workbench.UI.DelegationView"
             x:ClassModifier="internal"
             x:DataType="overview:DelegationViewModel">
  <Grid ColumnDefinitions="240,*">
    <ItemsControl ItemsSource="{Binding Orchestrators}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="overview:OrchestratorViewModel">
          <Button HorizontalAlignment="Stretch"
                  Background="Transparent"
                  Command="{Binding $parent[UserControl].((overview:DelegationViewModel)DataContext).SelectCommand}"
                  CommandParameter="{Binding}">
            <ContentControl Content="{Binding}" />
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="8" Margin="12,0">
        <ItemsControl ItemsSource="{Binding Children}" />
        <TextBlock Text="Refused" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Refused}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

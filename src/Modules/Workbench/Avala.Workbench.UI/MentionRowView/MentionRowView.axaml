<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.MentionRowView"
             x:ClassModifier="internal"
             x:DataType="conversation:IMentionRowViewModel">
  <Design.DataContext>
    <conversation:DesignMentionRowViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Button#Row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="Button#Row:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button#Row.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="Path.kind">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock#Detail">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
  </UserControl.Styles>
  <Button x:Name="Row"
          Classes.selected="{Binding IsSelected}"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          Padding="8,5"
          Focusable="False"
          Command="{Binding ChooseCommand}"
          AutomationProperties.Name="{Binding Label, StringFormat='Mention {0}'}">
    <Grid ColumnDefinitions="Auto,Auto,*">
      <Panel Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
        <Path x:Name="FileIcon" Classes="icon kind" Data="{StaticResource IconFileEdit}" IsVisible="{Binding Kind, Converter={x:Static states:EnumIs.Any}, ConverterParameter='File'}" />
        <Path x:Name="FolderIcon" Classes="icon kind" Data="{StaticResource IconFolder}" IsVisible="{Binding Kind, Converter={x:Static states:EnumIs.Any}, ConverterParameter='Folder'}" />
        <Path x:Name="CommitIcon" Classes="icon kind" Data="{StaticResource IconCommit}" IsVisible="{Binding Kind, Converter={x:Static states:EnumIs.Any}, ConverterParameter='Commit'}" />
        <Path x:Name="NoteIcon" Classes="icon kind" Data="{StaticResource IconDocument}" IsVisible="{Binding Kind, Converter={x:Static states:EnumIs.Any}, ConverterParameter='Note'}" />
        <Path x:Name="JobIcon" Classes="icon kind" Data="{StaticResource IconMessage}" IsVisible="{Binding Kind, Converter={x:Static states:EnumIs.Any}, ConverterParameter='Job'}" />
      </Panel>
      <TextBlock x:Name="Label" Grid.Column="1" TextTrimming="CharacterEllipsis" MaxWidth="320" VerticalAlignment="Center" Text="{Binding Label}" />
      <TextBlock x:Name="Detail" Grid.Column="2" Classes="caption" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Detail}" />
    </Grid>
  </Button>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Avala.Workbench.Settings"
             x:Class="Avala.Workbench.UI.MachineConnectionView"
             x:ClassModifier="internal"
             x:DataType="settings:IMachineConnectionViewModel">
  <Design.DataContext>
    <settings:DesignMachineConnectionViewModel />
  </Design.DataContext>
  <DockPanel Margin="0,12">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
      <Border x:Name="Default" Classes="tag" IsVisible="{Binding IsDefault}">
        <TextBlock Text="default" />
      </Border>
      <Button x:Name="Edit" Classes="link" Content="Edit" IsVisible="{Binding IsDeclared}" Command="{Binding EditCommand}" />
      <Button x:Name="Remove" Classes="link" Content="Remove" IsVisible="{Binding IsDeclared}" Command="{Binding RemoveCommand}" />
    </StackPanel>
    <StackPanel>
      <TextBlock x:Name="ConnectionName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="Provider" Classes="caption" Text="{Binding Provider}" />
        <TextBlock Classes="caption" Text="·" />
        <TextBlock x:Name="Source" Classes="caption" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="caption" Text="·" />
        <TextBlock x:Name="Origin" Classes="caption" Text="{Binding Origin}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</UserControl>

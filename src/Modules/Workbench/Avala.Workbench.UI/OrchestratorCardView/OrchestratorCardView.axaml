<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:elapsed="using:Avala.Components.UI.Elapsed"
             xmlns:overview="using:Avala.Workbench.Overview"
             xmlns:presenting="using:Avala.Workbench.Presenting"
             xmlns:graphs="using:Avala.Components.UI.Graphs"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.OrchestratorCardView"
             x:ClassModifier="internal"
             x:DataType="overview:IOrchestratorCardViewModel"
             graphs:Graph.Depth="{Binding Place.Depth}"
             graphs:Graph.Edge="{Binding Place.Edge}">
  <Design.DataContext>
    <overview:DesignOrchestratorCardViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Border.share">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
      <Setter Property="Background" Value="{DynamicResource ShareMiddleBrush}" />
    </Style>
    <Style Selector="Border.share.kept">
      <Setter Property="Background" Value="{DynamicResource ShareStrongBrush}" />
    </Style>
    <Style Selector="Arc#Ring">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Arc#Ring.attention">
      <Setter Property="Stroke" Value="{DynamicResource AttentionBrush}" />
    </Style>
    <Style Selector="Button#Fold Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.tally.attention">
      <Setter Property="Foreground" Value="{DynamicResource AttentionBrush}" />
    </Style>
  </UserControl.Styles>
  <Button x:Name="Open"
          Classes="bare"
          AutomationProperties.Name="{Binding Title}"
          Command="{Binding OpenCommand}"
          CommandParameter="{Binding Job}">
    <Border x:Name="Card"
            Classes="node"
            Classes.viewing="{Binding IsViewing}"
            Classes.attention="{Binding Place.IsWaiting}"
            Classes.alert="{Binding Place.IsAlert}"

            CornerRadius="{DynamicResource RadiusOrchestrator}"
            BoxShadow="{DynamicResource ShadowOrchestrator}"
            Padding="18,16">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="tag" IsVisible="{Binding Harness, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Harness, Converter={x:Static graphs:Graph.Initials}}" />
          </Border>
          <TextBlock x:Name="Source" Classes="caption">
            <Run Text="{Binding Harness}" />
            <Run Text="{Binding Connection, StringFormat=' · {0} · orchestrator'}" />
          </TextBlock>
        </StackPanel>
        <DockPanel>
          <ContentControl x:Name="State" DockPanel.Dock="Right" Content="{Binding Place}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock x:Name="Title" Classes="pageTitle" Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock x:Name="Doing" Classes="caption secondary" Text="{Binding Doing}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Detail" Classes="caption secondary" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
        <WrapPanel x:Name="Glance" Orientation="Horizontal" ItemSpacing="10" LineSpacing="4">
          <StackPanel x:Name="ContextGauge" Orientation="Horizontal" Spacing="5" IsVisible="{Binding Context.IsShown}">
            <Panel Width="13" Height="13" VerticalAlignment="Center">
              <Ellipse Stroke="{DynamicResource HubTrackBrush}" StrokeThickness="2.4" />
              <Arc x:Name="Ring"
                   Classes.attention="{Binding Context.IsNear}"
                   StartAngle="-90"
                   SweepAngle="{Binding Context.Used, Converter={x:Static graphs:Graph.Degrees}}"
                   StrokeThickness="2.4"
                   StrokeLineCap="Round" />
            </Panel>
            <TextBlock x:Name="ContextLeft" Classes="hint" Text="{Binding Context.Left, StringFormat='{}{0} context left'}" VerticalAlignment="Center" />
            <Border x:Name="Compacted" Classes="tag" VerticalAlignment="Center" IsVisible="{Binding Context.Compacted}">
              <TextBlock Text="compacted" />
            </Border>
          </StackPanel>
          <TextBlock x:Name="Tokens" Classes="hint" Text="{Binding Tokens, StringFormat='{}{0} in the tree'}" VerticalAlignment="Center" IsVisible="{Binding Tokens, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </WrapPanel>
        <StackPanel Spacing="5">
          <TextBlock x:Name="Budget" Classes="hint" Text="{Binding Budget}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="Spent" Classes="hint" Text="{Binding Spent}" TextTrimming="CharacterEllipsis" />
          <ItemsControl x:Name="Shares" ItemsSource="{Binding Shares}" IsVisible="{Binding HasBudget}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <graphs:ShareBar Gap="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="presenting:BudgetShare">
                <Border Classes="share" Classes.kept="{Binding IsKept}" graphs:Graph.Weight="{Binding Weight}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel>
            <Button x:Name="Fold"
                    DockPanel.Dock="Right"
                    Classes="bare"
                    Padding="4,0"
                    IsVisible="{Binding Place.HasBranches}"
                    AutomationProperties.Name="Fold or unfold its sub-agents"
                    Command="{Binding Place.FoldCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="Branches" Classes="hint" Text="{Binding Place.Branches}" />
                <Panel Width="9" Height="9" VerticalAlignment="Center">
                  <Path Classes="icon" Width="9" Height="9" Data="{StaticResource IconChevronRight}" IsVisible="{Binding Place.IsFolded}" />
                  <Path Classes="icon" Width="9" Height="9" Data="{StaticResource IconChevronDown}" IsVisible="{Binding !Place.IsFolded}" />
                </Panel>
              </StackPanel>
            </Button>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <elapsed:ElapsedText x:Name="Elapsed" Classes="hint" Since="{Binding Since}" IsVisible="{Binding IsTiming}" />
            <TextBlock x:Name="Took" Classes="hint" Text="{Binding Took}" IsVisible="{Binding !IsTiming}" />
          </StackPanel>
          </DockPanel>
          <TextBlock x:Name="ShareNote" Classes="hint" FontSize="{DynamicResource FontSizeSection}" Text="{Binding ShareNote}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Button>
</UserControl>

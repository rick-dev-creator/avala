<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Avala.Workbench.Overview"
             x:Class="Avala.Workbench.UI.DelegationNodeView"
             x:ClassModifier="internal"
             x:DataType="overview:DelegationNodeViewModel">
  <StackPanel Spacing="2">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding Depth}" Opacity="0.4" />
      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Status}" Opacity="0.6" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding Harness}" Opacity="0.6" />
      <TextBlock Text="{Binding Connection}" Opacity="0.6" />
      <TextBlock Text="{Binding Activity}" />
      <TextBlock Text="{Binding Spent}" />
      <TextBlock Text="{Binding Carve}" Opacity="0.6" />
    </StackPanel>
  </StackPanel>
</UserControl>

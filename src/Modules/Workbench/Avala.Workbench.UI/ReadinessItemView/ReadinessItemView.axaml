<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:privacy="using:Avala.Components.UI.Privacy"
             xmlns:readiness="using:Avala.Workbench.Readiness"
             x:Class="Avala.Workbench.UI.ReadinessItemView"
             x:ClassModifier="internal"
             x:DataType="readiness:IReadinessItemViewModel">
  <Design.DataContext>
    <readiness:DesignReadinessItemViewModel />
  </Design.DataContext>
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4">
    <Panel Width="16" VerticalAlignment="Center">
      <Path x:Name="Done" Classes="icon small" Data="{StaticResource IconCheck}" Stroke="{DynamicResource DotDoneBrush}" IsVisible="{Binding IsDone}" />
      <Path x:Name="Missing" Classes="icon small" Data="{StaticResource IconAttention}" Stroke="{DynamicResource AttentionBrush}" IsVisible="{Binding !IsDone}" />
    </Panel>
    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
      <TextBlock x:Name="Text" privacy:PersonalDetails.Text="{Binding Text}" TextWrapping="Wrap" Classes.secondary="{Binding IsDone}" />
      <Border Classes="code" Padding="10,6" HorizontalAlignment="Left" IsVisible="{Binding Command, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <SelectableTextBlock x:Name="Command" Classes="mono" Text="{Binding Command}" />
      </Border>
      <ItemsControl x:Name="Accounts" ItemsSource="{Binding Accounts}" IsVisible="{Binding !!Accounts.Count}" />
      <TextBlock x:Name="Error"
                 Classes="caption failure"
                 Text="{Binding Error}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
    <Button x:Name="Act"
            Grid.Column="2"
            VerticalAlignment="Center"
            Classes="primary"
            Padding="12,3"
            Content="{Binding Action}"
            Command="{Binding ActCommand}"
            IsVisible="{Binding Action, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </Grid>
</UserControl>

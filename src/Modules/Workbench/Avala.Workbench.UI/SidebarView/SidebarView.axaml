<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sidebar="using:Avala.Workbench.Sidebar"
             x:Class="Avala.Workbench.UI.SidebarView"
             x:ClassModifier="internal"
             x:DataType="sidebar:ISidebarViewModel">
  <Design.DataContext>
    <sidebar:DesignSidebarViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="TextBlock.group">
      <Setter Property="Margin" Value="10,4" />
      <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="ItemsControl.rows">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Spacing="1" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="Row" x:DataType="sidebar:IJobRowViewModel">
      <Button Classes="row"
              Classes.selected="{Binding IsSelected}"
              Command="{Binding $parent[UserControl].((sidebar:ISidebarViewModel)DataContext).SelectCommand}"
              CommandParameter="{Binding}">
        <ContentControl ClipToBounds="False" Content="{Binding}" />
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel Spacing="14">
    <Border x:Name="NoJobs" Classes="empty" Margin="0,8,0,0" IsVisible="{Binding IsEmpty}">
      <StackPanel Spacing="4">
        <TextBlock Classes="strong" Text="No jobs yet" HorizontalAlignment="Center" />
        <TextBlock Classes="caption"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Text="Start one with + above. It runs in its own worktree." />
      </StackPanel>
    </Border>
    <StackPanel x:Name="NeedsYouGroup" Spacing="1" IsVisible="{Binding !!NeedsYou.Count}">
      <TextBlock Classes="section group" Text="Needs you" />
      <ItemsControl x:Name="NeedsYou" Classes="rows" ItemsSource="{Binding NeedsYou}" ItemTemplate="{StaticResource Row}" />
    </StackPanel>
    <StackPanel x:Name="RunningGroup" Spacing="1" IsVisible="{Binding !!Running.Count}">
      <TextBlock Classes="section group" Text="Running" />
      <ItemsControl x:Name="Running" Classes="rows" ItemsSource="{Binding Running}" ItemTemplate="{StaticResource Row}" />
    </StackPanel>
    <StackPanel x:Name="ReadyForReviewGroup" Spacing="1" IsVisible="{Binding !!ReadyForReview.Count}">
      <TextBlock Classes="section group" Text="Ready for review" />
      <ItemsControl x:Name="ReadyForReview" Classes="rows" ItemsSource="{Binding ReadyForReview}" ItemTemplate="{StaticResource Row}" />
    </StackPanel>
    <StackPanel x:Name="DoneGroup" Spacing="1" IsVisible="{Binding !!Done.Count}">
      <TextBlock Classes="section group" Text="Done" />
      <ItemsControl x:Name="Done" Classes="rows" ItemsSource="{Binding Done}" ItemTemplate="{StaticResource Row}" />
    </StackPanel>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sidebar="using:Avala.Workbench.Sidebar"
             x:Class="Avala.Workbench.UI.SidebarView"
             x:ClassModifier="internal"
             x:DataType="sidebar:ISidebarViewModel">
  <Design.DataContext>
    <sidebar:DesignSidebarViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="TextBlock.group">
      <Setter Property="Margin" Value="10,4" />
      <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="Border.children">
      <Setter Property="Margin" Value="13,0,0,4" />
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Button.row.child">
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="ItemsControl.rows">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Spacing="1" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="Button#NewProject">
      <Setter Property="Padding" Value="5" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="Row" x:DataType="sidebar:ISidebarRow">
      <StackPanel>
        <Button Classes="row"
                Classes.child="{Binding IsChild}"
                Classes.selected="{Binding IsSelected}"
                Command="{Binding $parent[UserControl].((sidebar:ISidebarViewModel)DataContext).SelectCommand}"
                CommandParameter="{Binding}">
          <ContentControl ClipToBounds="False" Content="{Binding}" />
        </Button>
        <Border Classes="children" IsVisible="{Binding !!Children.Count}">
          <ItemsControl Classes="rows" ItemsSource="{Binding Children}" ItemTemplate="{DynamicResource Row}" />
        </Border>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel Spacing="14">
    <StackPanel x:Name="NeedsYouGroup" Spacing="1" IsVisible="{Binding !!NeedsYou.Count}">
      <TextBlock Classes="section group" Text="Needs you" />
      <ItemsControl x:Name="NeedsYou" Classes="rows" ItemsSource="{Binding NeedsYou}" ItemTemplate="{StaticResource Row}" />
    </StackPanel>
    <StackPanel x:Name="ProjectsGroup" Spacing="1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="section group" Text="Projects" VerticalAlignment="Center" />
        <Button x:Name="NewProject"
                Grid.Column="1"
                Classes="glyph"
                Command="{Binding CreateProjectCommand}"
                ToolTip.Tip="New project"
                AutomationProperties.Name="New project">
          <Path Classes="icon small" Data="{StaticResource IconFolderNew}" />
        </Button>
      </Grid>
      <ItemsControl x:Name="Projects" Classes="rows" ItemsSource="{Binding Projects}" />
    </StackPanel>
    <ContentControl x:Name="Chats" Content="{Binding Chats}" IsVisible="{Binding Chats.HasRows}" />
  </StackPanel>
</UserControl>

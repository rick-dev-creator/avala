<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Avala.Workbench.Overview"
             x:Class="Avala.Workbench.UI.OrchestratorView"
             x:ClassModifier="internal"
             x:DataType="overview:OrchestratorViewModel">
  <StackPanel>
    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
    <TextBlock Text="{Binding Status}" Opacity="0.6" FontSize="12" />
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sidebar="using:Avala.Workbench.Sidebar"
             x:Class="Avala.Workbench.UI.SidebarView"
             x:ClassModifier="internal"
             x:DataType="sidebar:SidebarViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="Row" x:DataType="sidebar:JobRowViewModel">
      <Button HorizontalAlignment="Stretch"
              Background="Transparent"
              Command="{Binding $parent[UserControl].((sidebar:SidebarViewModel)DataContext).SelectCommand}"
              CommandParameter="{Binding}">
        <ContentControl Content="{Binding}" />
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Margin="8" Spacing="4">
      <TextBlock Text="{Binding PendingDecisions, StringFormat='{}{0} pending decisions'}"
                 IsVisible="{Binding HasPendingDecisions}" />
      <TextBlock Text="Needs you" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding NeedsYou}" ItemTemplate="{StaticResource Row}" />
      <TextBlock Text="Running" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Running}" ItemTemplate="{StaticResource Row}" />
      <TextBlock Text="Ready for review" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding ReadyForReview}" ItemTemplate="{StaticResource Row}" />
      <TextBlock Text="Done" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource Row}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             x:Class="Avala.Workbench.UI.ChildAskingView"
             x:ClassModifier="internal"
             x:DataType="conversation:IChildAskingViewModel"
             Classes="arrive-snappy"
             Margin="0,10">
  <Design.DataContext>
    <conversation:DesignChildAskingViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Border#Card">
      <Setter Property="Background" Value="{DynamicResource SurfaceFloatBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
      <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
    </Style>
  </UserControl.Styles>
  <Border x:Name="Card">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <Ellipse Width="6" Height="6" Fill="{DynamicResource AttentionBrush}" VerticalAlignment="Center" IsVisible="{Binding IsWaiting}" />
        <TextBlock x:Name="Headline" Grid.Column="1" Classes="caption" TextWrapping="Wrap" Text="{Binding Headline}" />
      </Grid>
      <SelectableTextBlock x:Name="Asking" Classes="body" TextWrapping="Wrap" Text="{Binding Asking}" />
      <TextBlock x:Name="Status" Classes="caption" TextWrapping="Wrap" Text="{Binding Status}" />
    </StackPanel>
  </Border>
</UserControl>

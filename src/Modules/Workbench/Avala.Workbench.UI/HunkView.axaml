<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:review="using:Avala.Workbench.Review"
             x:Class="Avala.Workbench.UI.HunkView"
             x:ClassModifier="internal"
             x:DataType="review:HunkViewModel">
  <StackPanel>
    <TextBlock Text="{Binding Header}" FontFamily="monospace" Opacity="0.6" />
    <ItemsControl ItemsSource="{Binding Lines}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <TextBlock Text="{Binding}" FontFamily="monospace" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

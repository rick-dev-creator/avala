<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Avala.Workbench.Overview"
             x:Class="Avala.Workbench.UI.ConnectionsView"
             x:ClassModifier="internal"
             x:DataType="overview:ConnectionsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding FileNote}" Opacity="0.7" />
      <ItemsControl ItemsSource="{Binding Connections}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

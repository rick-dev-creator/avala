<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Avala.Workbench.Settings"
             x:Class="Avala.Workbench.UI.ConnectionEditorView"
             x:ClassModifier="internal"
             x:DataType="settings:IConnectionEditorViewModel">
  <Design.DataContext>
    <settings:DesignConnectionEditorViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="ComboBox">
      <Setter Property="MinWidth" Value="260" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusButton}" />
      <Setter Property="Background" Value="{DynamicResource FillInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderInputBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Width" Value="110" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="8">
    <Border x:Name="Confirm"
            Classes="quiet"
            Padding="12,8"
            IsVisible="{Binding Removing, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button x:Name="Keep" Content="Keep" Command="{Binding KeepCommand}" />
          <Button x:Name="ConfirmRemove" Classes="destructive" Content="Remove" Command="{Binding RemoveCommand}" />
        </StackPanel>
        <TextBlock x:Name="RemoveQuestion"
                   Classes="caption"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{Binding Removing, StringFormat='Remove {0} from connections.json? Jobs already running on it go on.'}" />
      </DockPanel>
    </Border>
    <TextBlock x:Name="Error"
               Classes="caption failure"
               TextWrapping="Wrap"
               Text="{Binding Error}"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Border x:Name="Form" Classes="grouped" Padding="16,14" IsVisible="{Binding IsOpen}">
      <StackPanel Spacing="10">
        <TextBlock x:Name="Title" Classes="section" Text="{Binding Title}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="label" Text="Name" />
          <TextBox x:Name="NameField" Width="260" Text="{Binding Name}" PlaceholderText="claude-team" AutomationProperties.Name="Connection name" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="label" Text="Harness" />
          <ComboBox x:Name="Provider" ItemsSource="{Binding Providers}" SelectedIndex="{Binding Provider}" AutomationProperties.Name="Harness" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="label" Text="Credential" />
          <ComboBox x:Name="Source" ItemsSource="{Binding Sources}" SelectedIndex="{Binding Source}" AutomationProperties.Name="Credential source" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding NeedsReference}">
          <TextBlock Classes="label" Text="Where" />
          <TextBox x:Name="Reference" Width="360" Classes="mono" Text="{Binding Reference}" AutomationProperties.Name="Credential reference" />
        </StackPanel>
        <TextBlock x:Name="ReferenceHint" Classes="caption" TextWrapping="Wrap" Text="{Binding ReferenceHint}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="CancelConnection" Content="Cancel" Command="{Binding CancelCommand}" />
          <Button x:Name="SaveConnection" Classes="primary" Content="Save to connections.json" Command="{Binding SaveCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Avala.Workbench.Settings"
             xmlns:appearance="using:Avala.Sdk.Appearance"
             xmlns:copying="using:Avala.Components.UI.Copying"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:styling="using:Avalonia.Styling"
             x:Class="Avala.Workbench.UI.AppearanceView"
             x:ClassModifier="internal"
             x:DataType="settings:IAppearanceViewModel">
  <Design.DataContext>
    <settings:DesignAppearanceViewModel />
  </Design.DataContext>
  <StackPanel Spacing="8">
    <DockPanel>
      <TextBlock x:Name="AppearanceFile" DockPanel.Dock="Right" Classes="hint" Text="{Binding File, StringFormat='appearance.json: {0}'}" VerticalAlignment="Bottom" />
      <TextBlock Classes="section" Text="Display" VerticalAlignment="Bottom" />
    </DockPanel>
    <Border x:Name="AppearanceError"
            Classes="quiet"
            Padding="12,8"
            IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Classes="caption failure" Text="{Binding Error}" TextWrapping="Wrap" />
    </Border>
    <Border Classes="grouped">
      <StackPanel>
        <StackPanel Margin="16,12" Spacing="12">
          <DockPanel>
            <Border DockPanel.Dock="Right" Classes="segments" VerticalAlignment="Center">
              <Button x:Name="FollowSystem"
                      Classes="segment"
                      Classes.selected="{Binding FollowsSystem}"
                      Content="System"
                      Command="{Binding ChooseThemeCommand}"
                      CommandParameter="{x:Static appearance:ThemeChoice.System}" />
            </Border>
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Theme" />
              <TextBlock Classes="caption" Text="System picks Night or Day from the operating system's dark or light mode." TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <WrapPanel x:Name="Themes" ItemSpacing="10" LineSpacing="10">
            <Button x:Name="ChooseDark"
                    Classes="swatch"
                    Classes.selected="{Binding IsDark}"
                    AutomationProperties.Name="Night theme"
                    Command="{Binding ChooseThemeCommand}"
                    CommandParameter="{x:Static appearance:ThemeChoice.Dark}">
              <StackPanel Spacing="6">
                <ThemeVariantScope RequestedThemeVariant="{x:Static styling:ThemeVariant.Dark}">
                  <Border Classes="swatch-face">
                    <Grid ColumnDefinitions="22,*" RowDefinitions="*,Auto">
                      <Border Grid.RowSpan="2" Background="{DynamicResource SurfacePanelBrush}" />
                      <StackPanel Grid.Column="1" Margin="8,8,8,0" Spacing="4">
                        <Border Classes="swatch-line" Background="{DynamicResource TextPrimaryBrush}" Width="34" />
                        <Border Classes="swatch-line" Background="{DynamicResource TextTertiaryBrush}" Width="24" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,8" Spacing="4">
                        <Border Classes="swatch-dot" Background="{DynamicResource AccentBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource SystemBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource VerifiedBrush}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </ThemeVariantScope>
                <TextBlock Classes="caption" Text="Night" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ChooseLight"
                    Classes="swatch"
                    Classes.selected="{Binding IsLight}"
                    AutomationProperties.Name="Day theme"
                    Command="{Binding ChooseThemeCommand}"
                    CommandParameter="{x:Static appearance:ThemeChoice.Light}">
              <StackPanel Spacing="6">
                <ThemeVariantScope RequestedThemeVariant="{x:Static styling:ThemeVariant.Light}">
                  <Border Classes="swatch-face">
                    <Grid ColumnDefinitions="22,*" RowDefinitions="*,Auto">
                      <Border Grid.RowSpan="2" Background="{DynamicResource SurfacePanelBrush}" />
                      <StackPanel Grid.Column="1" Margin="8,8,8,0" Spacing="4">
                        <Border Classes="swatch-line" Background="{DynamicResource TextPrimaryBrush}" Width="34" />
                        <Border Classes="swatch-line" Background="{DynamicResource TextTertiaryBrush}" Width="24" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,8" Spacing="4">
                        <Border Classes="swatch-dot" Background="{DynamicResource AccentBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource SystemBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource VerifiedBrush}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </ThemeVariantScope>
                <TextBlock Classes="caption" Text="Day" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ChooseTide"
                    Classes="swatch"
                    Classes.selected="{Binding IsTide}"
                    AutomationProperties.Name="Tide theme"
                    Command="{Binding ChooseThemeCommand}"
                    CommandParameter="{x:Static appearance:ThemeChoice.Tide}">
              <StackPanel Spacing="6">
                <ThemeVariantScope RequestedThemeVariant="{x:Static theme:Themes.Tide}">
                  <Border Classes="swatch-face">
                    <Grid ColumnDefinitions="22,*" RowDefinitions="*,Auto">
                      <Border Grid.RowSpan="2" Background="{DynamicResource SurfacePanelBrush}" />
                      <StackPanel Grid.Column="1" Margin="8,8,8,0" Spacing="4">
                        <Border Classes="swatch-line" Background="{DynamicResource TextPrimaryBrush}" Width="34" />
                        <Border Classes="swatch-line" Background="{DynamicResource TextTertiaryBrush}" Width="24" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,8" Spacing="4">
                        <Border Classes="swatch-dot" Background="{DynamicResource AccentBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource SystemBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource VerifiedBrush}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </ThemeVariantScope>
                <TextBlock Classes="caption" Text="Tide" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ChooseUnit"
                    Classes="swatch"
                    Classes.selected="{Binding IsUnit}"
                    AutomationProperties.Name="Unit theme"
                    Command="{Binding ChooseThemeCommand}"
                    CommandParameter="{x:Static appearance:ThemeChoice.Unit}">
              <StackPanel Spacing="6">
                <ThemeVariantScope RequestedThemeVariant="{x:Static theme:Themes.Unit}">
                  <Border Classes="swatch-face">
                    <Grid ColumnDefinitions="22,*" RowDefinitions="*,Auto">
                      <Border Grid.RowSpan="2" Background="{DynamicResource SurfacePanelBrush}" />
                      <StackPanel Grid.Column="1" Margin="8,8,8,0" Spacing="4">
                        <Border Classes="swatch-line" Background="{DynamicResource TextPrimaryBrush}" Width="34" />
                        <Border Classes="swatch-line" Background="{DynamicResource TextTertiaryBrush}" Width="24" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,8" Spacing="4">
                        <Border Classes="swatch-dot" Background="{DynamicResource AccentBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource SystemBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource VerifiedBrush}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </ThemeVariantScope>
                <TextBlock Classes="caption" Text="Unit" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ChooseAsh"
                    Classes="swatch"
                    Classes.selected="{Binding IsAsh}"
                    AutomationProperties.Name="Ash theme"
                    Command="{Binding ChooseThemeCommand}"
                    CommandParameter="{x:Static appearance:ThemeChoice.Ash}">
              <StackPanel Spacing="6">
                <ThemeVariantScope RequestedThemeVariant="{x:Static theme:Themes.Ash}">
                  <Border Classes="swatch-face">
                    <Grid ColumnDefinitions="22,*" RowDefinitions="*,Auto">
                      <Border Grid.RowSpan="2" Background="{DynamicResource SurfacePanelBrush}" />
                      <StackPanel Grid.Column="1" Margin="8,8,8,0" Spacing="4">
                        <Border Classes="swatch-line" Background="{DynamicResource TextPrimaryBrush}" Width="34" />
                        <Border Classes="swatch-line" Background="{DynamicResource TextTertiaryBrush}" Width="24" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,8" Spacing="4">
                        <Border Classes="swatch-dot" Background="{DynamicResource AccentBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource SystemBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource VerifiedBrush}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </ThemeVariantScope>
                <TextBlock Classes="caption" Text="Ash" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ChooseBloom"
                    Classes="swatch"
                    Classes.selected="{Binding IsBloom}"
                    AutomationProperties.Name="Bloom theme"
                    Command="{Binding ChooseThemeCommand}"
                    CommandParameter="{x:Static appearance:ThemeChoice.Bloom}">
              <StackPanel Spacing="6">
                <ThemeVariantScope RequestedThemeVariant="{x:Static theme:Themes.Bloom}">
                  <Border Classes="swatch-face">
                    <Grid ColumnDefinitions="22,*" RowDefinitions="*,Auto">
                      <Border Grid.RowSpan="2" Background="{DynamicResource SurfacePanelBrush}" />
                      <StackPanel Grid.Column="1" Margin="8,8,8,0" Spacing="4">
                        <Border Classes="swatch-line" Background="{DynamicResource TextPrimaryBrush}" Width="34" />
                        <Border Classes="swatch-line" Background="{DynamicResource TextTertiaryBrush}" Width="24" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,8" Spacing="4">
                        <Border Classes="swatch-dot" Background="{DynamicResource AccentBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource SystemBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource VerifiedBrush}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </ThemeVariantScope>
                <TextBlock Classes="caption" Text="Bloom" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ChooseSignal"
                    Classes="swatch"
                    Classes.selected="{Binding IsSignal}"
                    AutomationProperties.Name="Signal theme"
                    Command="{Binding ChooseThemeCommand}"
                    CommandParameter="{x:Static appearance:ThemeChoice.Signal}">
              <StackPanel Spacing="6">
                <ThemeVariantScope RequestedThemeVariant="{x:Static theme:Themes.Signal}">
                  <Border Classes="swatch-face">
                    <Grid ColumnDefinitions="22,*" RowDefinitions="*,Auto">
                      <Border Grid.RowSpan="2" Background="{DynamicResource SurfacePanelBrush}" />
                      <StackPanel Grid.Column="1" Margin="8,8,8,0" Spacing="4">
                        <Border Classes="swatch-line" Background="{DynamicResource TextPrimaryBrush}" Width="34" />
                        <Border Classes="swatch-line" Background="{DynamicResource TextTertiaryBrush}" Width="24" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,8" Spacing="4">
                        <Border Classes="swatch-dot" Background="{DynamicResource AccentBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource SystemBrush}" />
                        <Border Classes="swatch-dot" Background="{DynamicResource VerifiedBrush}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </ThemeVariantScope>
                <TextBlock Classes="caption" Text="Signal" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
        <Border Classes="separator" Margin="16,0" />
        <DockPanel Margin="16,12">
          <Border DockPanel.Dock="Right" Classes="segments" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="MotionFollowSystem"
                      Classes="segment"
                      Classes.selected="{Binding MotionFollowsSystem}"
                      Content="System"
                      Command="{Binding ChooseMotionCommand}"
                      CommandParameter="{x:Static appearance:MotionChoice.System}" />
              <Button x:Name="ReduceMotion"
                      Classes="segment"
                      Classes.selected="{Binding IsMotionReduced}"
                      Content="On"
                      Command="{Binding ChooseMotionCommand}"
                      CommandParameter="{x:Static appearance:MotionChoice.Reduced}" />
              <Button x:Name="FullMotion"
                      Classes="segment"
                      Classes.selected="{Binding IsMotionFull}"
                      Content="Off"
                      Command="{Binding ChooseMotionCommand}"
                      CommandParameter="{x:Static appearance:MotionChoice.Full}" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Reduce motion" />
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="Stops the pulse, the spinners, the thinking shimmer, the fades and the sliding panels. System follows the operating system's reduced motion setting." />
          </StackPanel>
        </DockPanel>
        <Border Classes="separator" Margin="16,0" />
        <DockPanel Margin="16,12">
          <Border DockPanel.Dock="Right" Classes="segments" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ReadComfortably"
                      Classes="segment"
                      Classes.selected="{Binding IsReadingComfortable}"
                      Content="Comfortable"
                      Command="{Binding ChooseReadingCommand}"
                      CommandParameter="{x:Static appearance:ReadingChoice.Comfortable}" />
              <Button x:Name="ReadWide"
                      Classes="segment"
                      Classes.selected="{Binding IsReadingWide}"
                      Content="Wide"
                      Command="{Binding ChooseReadingCommand}"
                      CommandParameter="{x:Static appearance:ReadingChoice.Wide}" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Reading width" />
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="How wide conversations and reviews grow as the window grows. Wide uses more of a large or full-screen window." />
          </StackPanel>
        </DockPanel>
        <Border Classes="separator" Margin="16,0" />
        <DockPanel Margin="16,12">
          <ToggleSwitch x:Name="SendWithCommandEnter"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        OnContent="{x:Null}"
                        OffContent="{x:Null}"
                        IsChecked="{Binding SendsWithCommandEnter, Mode=OneWay}"
                        Command="{Binding ToggleSendKeyCommand}"
                        AutomationProperties.Name="Send with Command or Control and Return" />
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="SendWithLabel" Text="{Binding Source={x:Static copying:Hotkeys.CommandEnterLabel}, StringFormat='Send with {0}'}" />
            <TextBlock Classes="caption" Text="When off, Enter sends and Shift+Enter adds a line." TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
        <Border Classes="separator" Margin="16,0" />
        <DockPanel Margin="16,12">
          <ToggleSwitch x:Name="HidePersonalDetails"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        OnContent="{x:Null}"
                        OffContent="{x:Null}"
                        IsChecked="{Binding PersonalDetails.IsHidden, Mode=OneWay}"
                        Command="{Binding PersonalDetails.ToggleCommand}"
                        AutomationProperties.Name="Hide personal details" />
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Hide personal details" />
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="Masks emails, sign-in names, account names and your home folder in paths, on screen and in exported conversations. Useful when recording a demo." />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

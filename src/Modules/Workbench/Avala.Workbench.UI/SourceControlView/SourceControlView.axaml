<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accounts="using:Avala.Workbench.Accounts"
             x:Class="Avala.Workbench.UI.SourceControlView"
             x:ClassModifier="internal"
             x:DataType="accounts:ISourceControlViewModel">
  <Design.DataContext>
    <accounts:DesignSourceControlViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="ItemsControl#Accounts > ContentPresenter:not(:nth-child(1))">
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Path.add">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="8">
    <TextBlock Classes="section" Margin="4,0" Text="Source control" />
    <Border Classes="grouped">
      <StackPanel>
        <ItemsControl x:Name="Accounts" Margin="16,0" ItemsSource="{Binding Accounts}" />
        <Border Classes="separator" Margin="16,0" IsVisible="{Binding !!Accounts.Count}" />
        <Button x:Name="Connect"
                Classes="link emphasis"
                HorizontalContentAlignment="Left"
                Padding="16,11"
                FontSize="{DynamicResource FontSizeBody}"
                Command="{Binding ConnectCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon add" Data="{StaticResource IconPlus}" />
            <TextBlock Text="Connect…" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
    <TextBlock x:Name="Error"
               Classes="caption failure"
               Margin="4,0"
               TextWrapping="Wrap"
               Text="{Binding Error}"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>

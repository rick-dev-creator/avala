<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accounts="using:Avala.Workbench.Accounts"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.ConnectSheetView"
             x:ClassModifier="internal"
             x:DataType="accounts:IConnectSheetViewModel">
  <Design.DataContext>
    <accounts:DesignConnectSheetViewModel />
  </Design.DataContext>
  <Border x:Name="Sheet" Classes="sheet" theme:Motion.Enter="Sheet">
    <StackPanel Spacing="16">
      <TextBlock Classes="heading" Text="Connect an account" />
      <Border Classes="segments" HorizontalAlignment="Left">
        <ItemsControl x:Name="Kinds" ItemsSource="{Binding Kinds}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Border>
      <TextBox x:Name="Host"
               Text="{Binding Host}"
               PlaceholderText="https://git.example.com"
               AutomationProperties.Name="Host"
               IsVisible="{Binding NeedsHost}" />
      <Border Classes="segments" HorizontalAlignment="Left" IsVisible="{Binding OffersCli}">
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="UseCli"
                        Classes="segment"
                        IsChecked="{Binding UsesCli}"
                        Content="{Binding Cli}"
                        AutomationProperties.Name="Sign in with the command-line tool" />
          <ToggleButton x:Name="UseToken"
                        Classes="segment"
                        IsChecked="{Binding UsesToken}"
                        Content="Token"
                        AutomationProperties.Name="Sign in with a token variable" />
        </StackPanel>
      </Border>
      <StackPanel x:Name="CliSignIn" Spacing="10" IsVisible="{Binding UsesCli}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse x:Name="CliDot"
                   Classes="dot"
                   Classes.attention="{Binding CliState, Converter={x:Static states:EnumIs.Any}, ConverterParameter='SignedOut,Missing'}" />
          <TextBlock x:Name="CliStatus" Text="{Binding CliStatus}" VerticalAlignment="Center" />
        </StackPanel>
        <DockPanel x:Name="CliFix" IsVisible="{Binding CliState, Converter={x:Static states:EnumIs.Any}, ConverterParameter='SignedOut,Missing'}">
          <Button x:Name="CheckAgain"
                  DockPanel.Dock="Right"
                  Classes="fix"
                  Margin="10,0,0,0"
                  Content="Check again"
                  Command="{Binding CheckAgainCommand}" />
          <Border Classes="code" Padding="10,6" IsVisible="{Binding CliState, Converter={x:Static states:EnumIs.Any}, ConverterParameter=SignedOut}">
            <SelectableTextBlock x:Name="SignInCommand" Classes="mono" Text="{Binding SignInCommand}" VerticalAlignment="Center" />
          </Border>
        </DockPanel>
      </StackPanel>
      <TextBox x:Name="TokenVariable"
               Classes="mono"
               Text="{Binding TokenVariable}"
               PlaceholderText="TOKEN_VARIABLE"
               AutomationProperties.Name="Name of the environment variable that holds the token"
               ToolTip.Tip="The name of an environment variable: Avala never stores the token"
               IsVisible="{Binding UsesToken}">
        <TextBox.InnerLeftContent>
          <TextBlock Classes="caption mono" Margin="10,0,0,0" VerticalAlignment="Center" Text="$" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <TextBlock x:Name="Error"
                 Classes="caption failure"
                 TextWrapping="Wrap"
                 Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="Cancel" Content="Cancel" Command="{Binding CancelCommand}" />
        <Button x:Name="Connect" Classes="primary" Content="Connect" Command="{Binding ConnectCommand}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:copying="using:Avala.Components.UI.Copying"
             xmlns:navigation="using:Avala.Workbench.Navigation"
             xmlns:ui="using:Avala.Components.UI"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.WorkbenchView"
             x:ClassModifier="internal"
             x:DataType="navigation:IWorkbenchViewModel">
  <Design.DataContext>
    <navigation:DesignWorkbenchViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Button.glyph > Path.icon">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>
    <Style Selector="Button.glyph > Path.icon.solid">
      <Setter Property="Stroke" Value="{x:Null}" />
      <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>
    <Style Selector="Panel#HeaderChrome[(theme|Chrome.IsFocusMode)=True]">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel#PreviewChrome[(theme|Chrome.IsFocusMode)=True]">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ItemsControl#ConversationRegion Button">
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style Selector="Border#PreviewGrip">
      <Setter Property="Width" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="TextBlock#JobTitle">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeReading}" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style Selector="ItemsControl#JobHeaderRegion">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="Border#Header.stacked ItemsControl#JobHeaderRegion">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Border#Header.compact TextBlock.chip-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border#Header.quiet ContentControl#Pill">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <DockPanel>
      <Panel x:Name="HeaderChrome" DockPanel.Dock="Top">
        <Border x:Name="Header"
                Padding="28,12,18,12"
                BorderBrush="{DynamicResource EdgeBrush}"
                BorderThickness="0,0,0,1"
                IsVisible="{Binding Conversation, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid x:Name="HeaderRow" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" Margin="{DynamicResource ChromeLeading}">
            <StackPanel x:Name="HeaderTitle" VerticalAlignment="Center">
              <TextBlock x:Name="JobTitle" Classes="strong" Text="{Binding Conversation.Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="Place" Classes="caption" Text="{Binding Conversation.Place}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ItemsControl x:Name="JobHeaderRegion"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Regions.Header}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ContentControl x:Name="Pill"
                            ClipToBounds="False"
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Content="{Binding Conversation.Pill}" />
            <Button x:Name="OpenReview"
                    Grid.Column="3"
                    Classes="primary"
                    Margin="12,0,0,0"
                    Content="Review"
                    Command="{Binding OpenReviewCommand}"
                    IsVisible="{Binding $self.IsEffectivelyEnabled}"
                    ToolTip.Tip="{Binding Source={x:Static copying:Hotkeys.ReviewLabel}, StringFormat='Open the review ({0})'}"
                    HotKey="{x:Static copying:Hotkeys.Review}" />
            <Button x:Name="More"
                    Grid.Column="4"
                    Classes="glyph"
                    Margin="12,0,0,0"
                    ToolTip.Tip="More"
                    AutomationProperties.Name="More actions for this job">
              <Path Classes="icon solid" Width="15" Height="15" Data="{StaticResource IconMore}" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem x:Name="CopyMarkdown"
                            Header="Copy as Markdown"
                            Command="{Binding Conversation.CopyMarkdownCommand}">
                    <MenuItem.Icon>
                      <Path Classes="icon" Data="{StaticResource IconCopy}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem x:Name="Export"
                            Header="Export…"
                            Command="{Binding Conversation.ExportCommand}">
                    <MenuItem.Icon>
                      <Path Classes="icon" Data="{StaticResource IconSave}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem x:Name="StopSession"
                            Header="Stop Session"
                            Command="{Binding Conversation.Composer.StopCommand}">
                    <MenuItem.Icon>
                      <Path Classes="icon" Data="{StaticResource IconStop}" />
                    </MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="ToggleInspector"
                    Grid.Column="5"
                    Margin="4,0,0,0"
                    Classes="glyph"
                    Classes.selected="{Binding IsInspectorOpen}"
                    Command="{Binding ToggleInspectorCommand}"
                    HotKey="{x:Static copying:Hotkeys.Inspector}"
                    ToolTip.Tip="{Binding Source={x:Static copying:Hotkeys.InspectorLabel}, StringFormat='Inspector ({0})'}"
                    AutomationProperties.Name="Toggle inspector">
              <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconInspector}" />
            </Button>
          </Grid>
        </Border>
      </Panel>
      <Grid x:Name="Split" ColumnDefinitions="*,Auto" states:Widths.Report="{Binding Regions.FitCommand}">
        <DockPanel>
          <ItemsControl x:Name="ConversationRegion"
                        DockPanel.Dock="Top"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding Conversation, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ItemsSource="{Binding Regions.Conversation}" />
          <Panel>
            <ui:Stage x:Name="Conversation" Keeps="4" Content="{Binding Conversation}" />
            <ContentControl x:Name="Welcome" Content="{Binding Welcome}" IsVisible="{Binding Conversation, Converter={x:Static ObjectConverters.IsNull}}" />
          </Panel>
        </DockPanel>
        <Panel x:Name="PreviewChrome" Grid.Column="1">
          <Panel x:Name="PreviewPane"
                 Width="{Binding Regions.PreviewWidth}"
                 IsVisible="{Binding Regions.IsPreviewOpen}"
                 ClipToBounds="True"
                 states:Resizer.FromLeft="True"
                 states:Resizer.Command="{Binding Regions.ResizePreviewCommand}"
                 states:Resizer.Committed="{Binding Regions.RememberPreviewCommand}"
                 states:Resizer.Reset="{Binding Regions.ResetPreviewWidthCommand}">
            <ItemsControl x:Name="PreviewRegion" ItemsSource="{Binding Regions.Preview}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Panel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Classes="edge" HorizontalAlignment="Left" />
            <Border x:Name="PreviewGrip"
                    Classes="grip"
                    HorizontalAlignment="Left"
                    ToolTip.Tip="Drag to resize, double-click to reset"
                    AutomationProperties.Name="Resize preview" />
          </Panel>
        </Panel>
      </Grid>
    </DockPanel>
    <Panel x:Name="ReviewSheet" IsVisible="{Binding Review, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border x:Name="ReviewScrim" Background="{DynamicResource ScrimSheetBrush}" theme:Motion.Enter="Fade" theme:Motion.When="{Binding Review, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Margin="20,40,20,20" Spacing="10" VerticalAlignment="Top">
        <ContentControl x:Name="Candidates" Content="{Binding Candidates}" />
        <ContentControl x:Name="Review" Content="{Binding Review}" />
      </StackPanel>
    </Panel>
  </Panel>
</UserControl>

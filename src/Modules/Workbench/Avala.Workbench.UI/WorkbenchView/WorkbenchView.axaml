<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:navigation="using:Avala.Workbench.Navigation"
             x:Class="Avala.Workbench.UI.WorkbenchView"
             x:ClassModifier="internal"
             x:DataType="navigation:IWorkbenchViewModel">
  <Design.DataContext>
    <navigation:DesignWorkbenchViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Button.glyph Path.icon">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>
    <Style Selector="TextBlock#JobTitle">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeReading}" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <DockPanel>
      <Border x:Name="Header"
              DockPanel.Dock="Top"
              Padding="28,12,18,12"
              BorderBrush="{DynamicResource EdgeBrush}"
              BorderThickness="0,0,0,1"
              IsVisible="{Binding Conversation, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="JobTitle" Classes="strong" Text="{Binding Conversation.Title}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Place" Classes="caption" Text="{Binding Conversation.Place}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <ContentControl x:Name="Pill"
                          ClipToBounds="False"
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Content="{Binding Conversation.Pill}" />
          <Button x:Name="OpenReview"
                  Grid.Column="2"
                  Classes="primary"
                  Margin="12,0,0,0"
                  Content="Review"
                  Command="{Binding OpenReviewCommand}"
                  IsVisible="{Binding $self.IsEffectivelyEnabled}"
                  ToolTip.Tip="Open the review (Ctrl+R)"
                  HotKey="Ctrl+R" />
          <Button x:Name="ToggleInspector"
                  Grid.Column="3"
                  Classes="glyph"
                  Classes.selected="{Binding IsInspectorOpen}"
                  Margin="12,0,0,0"
                  Command="{Binding ToggleInspectorCommand}"
                  HotKey="Ctrl+I"
                  ToolTip.Tip="Inspector (Ctrl+I)"
                  AutomationProperties.Name="Toggle inspector">
            <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconInspector}" />
          </Button>
        </Grid>
      </Border>
      <Panel>
        <ContentControl x:Name="Conversation" Content="{Binding Conversation}" />
        <Border x:Name="NoJob"
                Classes="empty"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding Conversation, Converter={x:Static ObjectConverters.IsNull}}">
          <StackPanel Spacing="6">
            <TextBlock Classes="strong" Text="No job selected" HorizontalAlignment="Center" />
            <TextBlock Classes="caption" Text="Choose a job in the sidebar to follow its conversation." HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Panel>
    </DockPanel>
    <Panel x:Name="ReviewSheet" IsVisible="{Binding Review, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border x:Name="ReviewScrim" Background="{DynamicResource ScrimSheetBrush}" Classes.fade-in="{Binding Review, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ContentControl x:Name="Review" Content="{Binding Review}" Margin="20,40,20,20" VerticalAlignment="Top" />
    </Panel>
  </Panel>
</UserControl>

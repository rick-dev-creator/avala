<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:copying="using:Avala.Components.UI.Copying"
             xmlns:privacy="using:Avala.Components.UI.Privacy"
             xmlns:cards="using:Avala.Workbench.Cards"
             x:Class="Avala.Workbench.UI.PermissionCardView"
             x:ClassModifier="internal"
             x:DataType="cards:IPermissionCardViewModel"
             theme:Motion.Enter="Arrive"
             Classes.waiting="{Binding AwaitsYou}"
             Margin="0,10">
  <Design.DataContext>
    <cards:DesignPermissionCardViewModel />
  </Design.DataContext>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="{x:Static copying:Hotkeys.CommandEnter}" Command="{Binding AllowCommand}" />
    <KeyBinding Gesture="{x:Static copying:Hotkeys.CommandBack}" Command="{Binding DenyCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Border#Card">
      <Setter Property="Background" Value="{DynamicResource SurfaceFloatBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowRaised}" />
      <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="Path#Mark">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Path#Mark.allowed">
      <Setter Property="Data" Value="{StaticResource IconCheck}" />
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Path#Mark.denied">
      <Setter Property="Data" Value="{StaticResource IconCross}" />
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="6">
    <Border x:Name="Card" IsVisible="{Binding AwaitsYou}">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource AttentionBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="Headline" Grid.Column="1" Classes="caption attention" Text="{Binding Headline}" />
          <TextBlock x:Name="Verdict" Grid.Column="2" Classes="caption" Text="{Binding Verdict}" />
        </Grid>
        <TextBlock x:Name="Title" Classes="body" TextWrapping="Wrap" Text="{Binding Title}" />
        <Border Classes="well">
          <ScrollViewer x:Name="TargetScroll" MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
            <SelectableTextBlock x:Name="Target" Classes="mono" TextWrapping="Wrap" privacy:PersonalDetails.Scrubbed="{Binding Target}" />
          </ScrollViewer>
        </Border>
        <TextBlock x:Name="Writes"
                   Classes="caption attention"
                   TextWrapping="Wrap"
                   privacy:PersonalDetails.Scrubbed="{Binding Writes}"
                   IsVisible="{Binding Writes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel x:Name="NoteField" Spacing="6" IsVisible="{Binding #AddNote.IsChecked}">
          <TextBlock Classes="label" Text="Note for the agent" />
          <TextBox x:Name="Note"
                   Text="{Binding Note}"
                   TextWrapping="Wrap"
                   PlaceholderText="Say why, or what to do instead"
                   AutomationProperties.Name="Note for the agent" />
        </StackPanel>
        <ContentControl x:Name="Scope" Content="{Binding Scope}" />
        <Grid x:Name="Answer" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <ToggleButton x:Name="AddNote"
                        Classes="quiet"
                        Content="Add a note"
                        VerticalAlignment="Center" />
          <Button x:Name="Deny"
                  Grid.Column="2"
                  Content="Deny"
                  Command="{Binding DenyCommand}"
                  ToolTip.Tip="{Binding Source={x:Static copying:Hotkeys.CommandBackLabel}, StringFormat='Deny ({0})'}" />
          <Button x:Name="Allow"
                  Grid.Column="3"
                  Classes="primary"
                  Content="Allow"
                  Command="{Binding AllowCommand}"
                  ToolTip.Tip="{Binding Source={x:Static copying:Hotkeys.CommandEnterLabel}, StringFormat='Allow ({0})'}" />
        </Grid>
      </StackPanel>
    </Border>
    <Grid x:Name="Resolved"
          ColumnDefinitions="14,Auto,*"
          ColumnSpacing="10"
          Margin="10,6"
          theme:Motion.Enter="Fold"
          theme:Motion.When="{Binding !AwaitsYou}"
          IsVisible="{Binding !AwaitsYou}">
      <Path x:Name="Mark"
            Classes="icon"
            Classes.allowed="{Binding IsAllowed}"
            Classes.denied="{Binding IsDenied}"
            VerticalAlignment="Center" />
      <TextBlock x:Name="Outcome" Grid.Column="1" Classes="secondary" Text="{Binding Verdict}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2"
                 Classes="mono tertiary"
                 Margin="4,0,0,0"
                 FontSize="{DynamicResource FontSizeCode}"
                 privacy:PersonalDetails.Scrubbed="{Binding Target}"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
    </Grid>
    <TextBlock x:Name="Notice"
               Classes="caption"
               Margin="10,0"
               TextWrapping="Wrap"
               Text="{Binding Notice}"
               IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock x:Name="Error"
               Classes="caption failure"
               Margin="10,0"
               TextWrapping="Wrap"
               Text="{Binding Error}"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>

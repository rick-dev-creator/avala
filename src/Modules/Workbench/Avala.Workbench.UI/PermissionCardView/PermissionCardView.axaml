<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="using:Avala.Workbench.Cards"
             x:Class="Avala.Workbench.UI.PermissionCardView"
             x:ClassModifier="internal"
             x:DataType="cards:IPermissionCardViewModel">
  <Design.DataContext>
    <cards:DesignPermissionCardViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Border#Card.waiting">
      <Setter Property="BorderBrush" Value="{DynamicResource AttentionBorderBrush}" />
    </Style>
  </UserControl.Styles>
  <Border x:Name="Card"
          Classes="card"
          Classes.waiting="{Binding AwaitsYou}"
          BorderThickness="1"
          Padding="{DynamicResource PaddingCard}">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="Title" Classes="strong" Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock x:Name="Verdict"
                   Grid.Column="1"
                   Classes="caption"
                   Classes.attention="{Binding AwaitsYou}"
                   Text="{Binding Verdict}"
                   Margin="12,0,0,0" />
      </Grid>
      <Border Classes="well">
        <SelectableTextBlock x:Name="Target" Classes="mono" Text="{Binding Target}" TextWrapping="Wrap" />
      </Border>
      <StackPanel x:Name="Answer" Spacing="8" IsVisible="{Binding AwaitsYou}">
        <TextBox x:Name="Note" Text="{Binding Note}" PlaceholderText="A note for the agent" />
        <CheckBox x:Name="DontAskAgain" Content="Don't ask again" IsChecked="{Binding DontAskAgain}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="Allow" Classes="primary" Content="Allow" Command="{Binding AllowCommand}" />
          <Button x:Name="Deny" Classes="destructive" Content="Deny" Command="{Binding DenyCommand}" />
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="Error"
                 Classes="caption failure"
                 TextWrapping="Wrap"
                 Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Border>
</UserControl>

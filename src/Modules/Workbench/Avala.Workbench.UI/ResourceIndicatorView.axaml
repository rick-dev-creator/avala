<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="using:Avala.Workbench.Resources"
             x:Class="Avala.Workbench.UI.ResourceIndicatorView"
             x:ClassModifier="internal"
             x:DataType="resources:ResourceIndicatorViewModel">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock Text="{Binding Memory}" FontSize="12" Opacity="0.7" />
    <TextBlock Text="{Binding Leftovers, StringFormat='{}{0} left over'}" FontSize="12" IsVisible="{Binding HasLeftovers}" />
  </StackPanel>
</UserControl>

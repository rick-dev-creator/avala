<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:usage="using:Avala.Workbench.Usage"
             x:Class="Avala.Workbench.UI.LimitView"
             x:ClassModifier="internal"
             x:DataType="usage:ILimitViewModel">
  <Design.DataContext>
    <usage:DesignLimitViewModel />
  </Design.DataContext>
  <StackPanel Spacing="7">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock x:Name="UsedText" FontSize="{DynamicResource FontSizeMono}" Classes.attention="{Binding IsNear}" Text="{Binding UsedText}" />
        <TextBlock x:Name="Resets" Classes="tertiary" FontSize="{DynamicResource FontSizeMono}" Text="{Binding Resets, StringFormat=' · {0}'}" />
      </StackPanel>
      <TextBlock x:Name="Window" Classes="secondary" FontSize="{DynamicResource FontSizeMono}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <Panel>
      <ProgressBar x:Name="Used" Classes="bar thick" Classes.attention="{Binding IsNear}" Value="{Binding Used}" VerticalAlignment="Center" />
      <ProgressBar x:Name="Hold" Classes="marker" Classes.attention="{Binding IsNear}" Height="14" Value="{Binding Hold}" IsVisible="{Binding HasHold}" />
    </Panel>
    <TextBlock x:Name="HoldAt" Classes="caption" Text="{Binding HoldAt}" IsVisible="{Binding IsNear}" />
  </StackPanel>
</UserControl>

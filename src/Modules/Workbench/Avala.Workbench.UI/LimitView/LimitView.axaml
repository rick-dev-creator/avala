<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:usage="using:Avala.Workbench.Usage"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.LimitView"
             x:ClassModifier="internal"
             x:DataType="usage:ILimitViewModel">
  <Design.DataContext>
    <usage:DesignLimitViewModel />
  </Design.DataContext>
  <StackPanel Spacing="6">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
        <TextBlock x:Name="UsedText" Classes="medium" Classes.attention="{Binding IsNear}" Classes.tertiary="{Binding IsExpired}" Text="{Binding UsedText}" TextWrapping="NoWrap" />
        <TextBlock x:Name="UsedWord" Classes="secondary" Classes.attention="{Binding IsNear}" Text=" used" TextWrapping="NoWrap" IsVisible="{Binding !IsExpired}" />
      </StackPanel>
      <TextBlock x:Name="Window" Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
    </DockPanel>
    <Panel>
      <ProgressBar x:Name="Used" Classes="bar thick" Classes.attention="{Binding IsNear}" Value="{Binding Used}" VerticalAlignment="Center" />
      <ProgressBar x:Name="Hold" Classes="marker" Classes.attention="{Binding IsNear}" Height="14" Value="{Binding Hold}" IsVisible="{Binding HasHold}" />
    </Panel>
    <TextBlock x:Name="Resets" Classes="caption" Text="{Binding Resets, Converter={x:Static states:Texts.Sentence}}" TextWrapping="Wrap" />
    <TextBlock x:Name="Outside" Classes="caption" Text="{Binding Outside}" IsVisible="{Binding Outside, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>

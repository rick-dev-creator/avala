<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Avala.Workbench.Overview"
             x:Class="Avala.Workbench.UI.ConnectionCardView"
             x:ClassModifier="internal"
             x:DataType="overview:IConnectionCardViewModel">
  <Design.DataContext>
    <overview:DesignConnectionCardViewModel />
  </Design.DataContext>
  <Border Classes="card" Padding="{DynamicResource PaddingCard}">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="ConnectionName" Classes="heading mono" Text="{Binding Name}" />
          <TextBlock x:Name="Default" Classes="caption" Text="default" IsVisible="{Binding IsDefault}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="Cost" Grid.Column="1" Text="{Binding Cost}" VerticalAlignment="Center" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="Provider" Classes="caption" Text="{Binding Provider}" />
        <TextBlock x:Name="Account" Classes="caption" Text="{Binding Account}" />
      </StackPanel>
      <ItemsControl x:Name="Limits" ItemsSource="{Binding Limits}" />
      <ItemsControl x:Name="Agents" ItemsSource="{Binding Agents}" />
    </StackPanel>
  </Border>
</UserControl>

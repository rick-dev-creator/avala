<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:newJob="using:Avala.Workbench.NewJob"
             x:Class="Avala.Workbench.UI.NewJobView"
             x:ClassModifier="internal"
             x:DataType="newJob:NewJobViewModel">
  <StackPanel Margin="16" Spacing="8" MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Text="Repository" />
    <AutoCompleteBox Text="{Binding Repository}" ItemsSource="{Binding Repositories}" />
    <TextBlock Text="Instruction" />
    <TextBox Text="{Binding Instruction}" AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap" />
    <TextBlock Text="Connection" />
    <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding Connection}" />
    <CheckBox Content="Supervised, even if the repository declares more autonomy" IsChecked="{Binding Supervised}" />
    <Button Content="Submit" Command="{Binding SubmitCommand}" />
    <TextBlock Text="{Binding Error}" Foreground="IndianRed" />
    <TextBlock Text="{Binding Submitted}" Opacity="0.7" />
  </StackPanel>
</UserControl>

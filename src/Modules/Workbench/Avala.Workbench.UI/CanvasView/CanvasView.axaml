<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             x:Class="Avala.Workbench.UI.CanvasView"
             x:ClassModifier="internal"
             x:DataType="conversation:ICanvasViewModel"
             Classes="arrive-snappy"
             Margin="0,10">
  <Design.DataContext>
    <conversation:DesignCanvasViewModel />
  </Design.DataContext>
  <Border x:Name="Figure"
          Background="{DynamicResource SurfaceCanvasBrush}"
          BorderBrush="{DynamicResource SeparatorBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource RadiusCard}"
          ClipToBounds="True">
    <ContentControl x:Name="Surface" Content="{Binding Surface}" />
  </Border>
</UserControl>

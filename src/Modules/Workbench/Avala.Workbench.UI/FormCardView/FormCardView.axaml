<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="using:Avala.Workbench.Cards"
             x:Class="Avala.Workbench.UI.FormCardView"
             x:ClassModifier="internal"
             x:DataType="cards:IFormCardViewModel"
             Classes="arrive-snappy"
             Classes.waiting="{Binding AwaitsYou}"
             Margin="0,10">
  <Design.DataContext>
    <cards:DesignFormCardViewModel />
  </Design.DataContext>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SubmitCommand}" />
    <KeyBinding Gesture="Ctrl+Back" Command="{Binding DeclineCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Border#Card">
      <Setter Property="Background" Value="{DynamicResource SurfaceFloatBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowRaised}" />
      <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="6">
    <Border x:Name="Card" IsVisible="{Binding AwaitsYou}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource AttentionBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="Headline" Grid.Column="1" Classes="caption attention" Text="{Binding Headline}" />
          <TextBlock x:Name="Verdict" Grid.Column="2" Classes="caption" Text="{Binding Verdict}" />
        </Grid>
        <TextBlock x:Name="Title" Classes="heading" TextWrapping="Wrap" Text="{Binding Title}" />
        <TextBlock x:Name="Context"
                   Classes="body secondary"
                   TextWrapping="Wrap"
                   Text="{Binding Context}"
                   IsVisible="{Binding Context, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ItemsControl x:Name="Fields" Margin="0,4,0,0" ItemsSource="{Binding Fields}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <StackPanel x:Name="NoteField" Spacing="6" IsVisible="{Binding #AddNote.IsChecked}">
          <TextBlock Classes="caption" Text="Note for the agent if you decline" />
          <TextBox x:Name="Note"
                   Text="{Binding Note}"
                   TextWrapping="Wrap"
                   PlaceholderText="Say why, or what to do instead"
                   AutomationProperties.Name="Note for the agent" />
        </StackPanel>
        <Grid x:Name="Answer" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,2,0,0">
          <TextBlock Classes="caption" VerticalAlignment="Center" Text="Or reply in your own words below" TextTrimming="CharacterEllipsis" />
          <ToggleButton x:Name="AddNote"
                        Grid.Column="1"
                        Classes="quiet"
                        Content="Add a note"
                        VerticalAlignment="Center" />
          <Button x:Name="Decline"
                  Grid.Column="2"
                  Content="Decline"
                  Command="{Binding DeclineCommand}"
                  ToolTip.Tip="Decline (Ctrl+Backspace)" />
          <Button x:Name="Submit"
                  Grid.Column="3"
                  Classes="primary"
                  Content="Answer"
                  Command="{Binding SubmitCommand}"
                  ToolTip.Tip="Answer (Ctrl+Enter)" />
        </Grid>
      </StackPanel>
    </Border>
    <Grid x:Name="Resolved"
          ColumnDefinitions="14,*"
          ColumnSpacing="10"
          Margin="10,6"
          Classes.fold-in="{Binding !AwaitsYou}"
          IsVisible="{Binding !AwaitsYou}">
      <Path Classes="icon" Data="{StaticResource IconCheck}" VerticalAlignment="Center" />
      <TextBlock x:Name="Outcome"
                 Grid.Column="1"
                 Classes="secondary"
                 Text="{Binding Verdict}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center" />
    </Grid>
    <TextBlock x:Name="Error"
               Classes="caption failure"
               Margin="10,0"
               TextWrapping="Wrap"
               Text="{Binding Error}"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>

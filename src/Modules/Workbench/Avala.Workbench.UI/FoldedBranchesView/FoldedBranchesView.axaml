<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Avala.Workbench.Overview"
             xmlns:graphs="using:Avala.Components.UI.Graphs"
             x:Class="Avala.Workbench.UI.FoldedBranchesView"
             x:ClassModifier="internal"
             x:DataType="overview:IFoldedBranchesViewModel"
             graphs:Graph.Depth="{Binding Place.Depth}"
             graphs:Graph.Edge="{Binding Place.Edge}">
  <Design.DataContext>
    <overview:DesignFoldedBranchesViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Button#Fold Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
  </UserControl.Styles>
  <Button x:Name="Fold"
          Classes="bare"
          Width="280"
          HorizontalContentAlignment="Stretch"
          AutomationProperties.Name="{Binding Text, StringFormat='Settled sub-agents: {0}'}"
          Command="{Binding Place.FoldCommand}">
    <Border Classes="fold" Padding="12,7" CornerRadius="{DynamicResource RadiusNode}" BorderThickness="1" BorderBrush="{DynamicResource EdgeBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Panel Width="10" Height="10" VerticalAlignment="Center">
          <Path Classes="icon" Width="10" Height="10" Data="{StaticResource IconChevronRight}" IsVisible="{Binding Place.IsFolded}" />
          <Path Classes="icon" Width="10" Height="10" Data="{StaticResource IconChevronDown}" IsVisible="{Binding !Place.IsFolded}" />
        </Panel>
        <TextBlock x:Name="Text" Classes="caption" Text="{Binding Text}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Button>
</UserControl>

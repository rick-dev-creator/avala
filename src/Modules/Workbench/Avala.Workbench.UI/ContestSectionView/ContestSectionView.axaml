<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:Avala.Workbench.Inspector"
             xmlns:ui="using:Avala.Components.UI"
             x:Class="Avala.Workbench.UI.ContestSectionView"
             x:ClassModifier="internal"
             x:DataType="inspector:IContestSectionViewModel">
  <Design.DataContext>
    <inspector:DesignContestSectionViewModel />
  </Design.DataContext>
  <ui:Fold x:Name="Section" Header="Contest" Fact="{Binding Fact}" IsExpanded="True" IsVisible="{Binding IsContested}">
    <StackPanel Margin="28,0,12,12" Spacing="7">
      <TextBlock x:Name="Status"
                 Classes="caption"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Text="{Binding Status}"
                 TextWrapping="Wrap" />
      <ItemsControl x:Name="Ranking" ItemsSource="{Binding Ranking}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="7" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption secondary" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ui:Fold>
</UserControl>

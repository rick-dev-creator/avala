<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:Avala.Workbench.Inspector"
             x:Class="Avala.Workbench.UI.EvidenceSectionView"
             x:ClassModifier="internal"
             x:DataType="inspector:IEvidenceSectionViewModel">
  <Design.DataContext>
    <inspector:DesignEvidenceSectionViewModel />
  </Design.DataContext>
  <Expander x:Name="Section" IsExpanded="True">
    <Expander.Header>
      <TextBlock Classes="section" Text="Evidence" />
    </Expander.Header>
    <StackPanel Spacing="4">
      <TextBlock x:Name="Loading" Classes="caption pulse" Text="Reading…" IsVisible="{Binding !IsLoaded}" />
      <TextBlock x:Name="Summary" Classes="strong" Text="{Binding Summary}" TextWrapping="Wrap" />
      <ItemsControl x:Name="Attempts" ItemsSource="{Binding Attempts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Expander>
</UserControl>

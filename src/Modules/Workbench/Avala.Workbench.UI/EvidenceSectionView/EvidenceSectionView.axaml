<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:Avala.Workbench.Inspector"
             xmlns:ui="using:Avala.Components.UI"
             x:Class="Avala.Workbench.UI.EvidenceSectionView"
             x:ClassModifier="internal"
             x:DataType="inspector:IEvidenceSectionViewModel">
  <Design.DataContext>
    <inspector:DesignEvidenceSectionViewModel />
  </Design.DataContext>
  <ui:Fold x:Name="Section" Header="Evidence" Fact="{Binding Fact}">
    <StackPanel Margin="28,0,12,12" Spacing="7">
      <Border x:Name="Loading" Classes="placeholder" theme:Motion.Enter="Linger" IsVisible="{Binding !IsLoaded}" AutomationProperties.Name="Reading" />
      <TextBlock x:Name="Summary"
                 Classes="caption"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Text="{Binding Summary}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ItemsControl x:Name="Attempts" ItemsSource="{Binding Attempts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="7" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption secondary" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="ReportedTitle"
                 Classes="caption"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Text="{Binding ReportedTitle}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding ReportedTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ItemsControl x:Name="Reported" ItemsSource="{Binding Reported}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption secondary" FontFamily="{DynamicResource MonoFont}" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="Lacks"
                 Classes="caption secondary"
                 Text="{Binding Lacks}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding Lacks, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Button x:Name="DeclareChecks"
              Classes="ghost"
              HorizontalAlignment="Left"
              FontSize="{DynamicResource FontSizeCaption}"
              Content="Declare checks"
              Command="{Binding DeclareChecksCommand}"
              IsVisible="{Binding Lacks, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </ui:Fold>
</UserControl>

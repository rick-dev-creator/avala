<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Avala.Workbench.Settings"
             x:Class="Avala.Workbench.UI.RuleFileView"
             x:ClassModifier="internal"
             x:DataType="settings:IRuleFileViewModel">
  <Design.DataContext>
    <settings:DesignRuleFileViewModel />
  </Design.DataContext>
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock x:Name="Path" Classes="mono" Text="{Binding Path}" VerticalAlignment="Center" />
    <TextBlock x:Name="Status" Text="{Binding Status}" VerticalAlignment="Center" />
    <TextBlock x:Name="Commit" Classes="caption mono" Text="{Binding Commit}" VerticalAlignment="Center" />
    <TextBlock x:Name="Edited" Classes="caption attention" Text="edited in the checkout" IsVisible="{Binding EditedInCheckout}" VerticalAlignment="Center" />
  </StackPanel>
</UserControl>

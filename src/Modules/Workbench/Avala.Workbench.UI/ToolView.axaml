<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             x:Class="Avala.Workbench.UI.ToolView"
             x:ClassModifier="internal"
             x:DataType="conversation:ToolViewModel">
  <StackPanel>
    <Button Background="Transparent" Command="{Binding ToggleCommand}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding Kind}" Opacity="0.6" />
        <TextBlock Text="{Binding Title}" FontFamily="monospace" />
        <TextBlock Text="{Binding Outcome}" Opacity="0.6" />
      </StackPanel>
    </Button>
    <SelectableTextBlock Text="{Binding Output}"
                         FontFamily="monospace"
                         TextWrapping="Wrap"
                         IsVisible="{Binding IsExpanded}" />
  </StackPanel>
</UserControl>

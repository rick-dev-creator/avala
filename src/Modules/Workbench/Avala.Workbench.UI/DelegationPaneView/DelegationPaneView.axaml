<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:overview="using:Avala.Workbench.Overview"
             xmlns:graphs="using:Avala.Components.UI.Graphs"
             x:Class="Avala.Workbench.UI.DelegationPaneView"
             x:ClassModifier="internal"
             x:DataType="overview:IDelegationPaneViewModel">
  <Design.DataContext>
    <overview:DesignDelegationPaneViewModel />
  </Design.DataContext>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Button.glyph Path.icon">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>
    <Style Selector="Border#Surface">
      <Setter Property="Background" Value="{DynamicResource SurfaceCanvasBrush}" />
    </Style>
    <Style Selector="Border#PaneHeader, Border#PaneFooter">
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
    </Style>
  </UserControl.Styles>
  <Border x:Name="Surface" IsVisible="{Binding IsOpen}">
    <DockPanel>
      <Border x:Name="PaneHeader" DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="18,0,10,0" Height="44">
        <DockPanel>
          <Button x:Name="Close"
                  DockPanel.Dock="Right"
                  Classes="glyph"
                  Command="{Binding CloseCommand}"
                  ToolTip.Tip="Close"
                  AutomationProperties.Name="Close the delegation tree">
            <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconCross}" />
          </Button>
          <TextBlock x:Name="Caption" DockPanel.Dock="Right" Classes="caption" Margin="0,0,8,0" Text="{Binding Caption}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock x:Name="Title" Classes="section" Text="Delegation" VerticalAlignment="Center" />
            <TextBlock Classes="jp" Text="委任" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="PaneFooter" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="18,10">
        <TextBlock x:Name="Footer" Classes="caption" Text="{Binding Footer}" TextTrimming="CharacterEllipsis" />
      </Border>
      <ContentControl x:Name="ReadProblem" DockPanel.Dock="Top" Margin="16,12,16,0" Content="{Binding ReadProblem}" IsVisible="{Binding ReadProblem.IsShown}" />
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ContentControl x:Name="Tree" Margin="16" Content="{Binding Tree}" IsVisible="{Binding HasTree}" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>

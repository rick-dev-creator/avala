<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="using:Avala.Workbench.Resources"
             x:Class="Avala.Workbench.UI.StaleWorktreeView"
             x:ClassModifier="internal"
             x:DataType="resources:StaleWorktreeViewModel">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock Text="{Binding Path}" FontFamily="monospace" />
    <TextBlock Text="{Binding Reason}" Opacity="0.6" />
  </StackPanel>
</UserControl>

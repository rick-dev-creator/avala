<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:usage="using:Avala.Workbench.Usage"
             x:Class="Avala.Workbench.UI.LimitView"
             x:ClassModifier="internal"
             x:DataType="usage:LimitViewModel">
  <StackPanel Spacing="2">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding Window}" />
      <TextBlock Text="{Binding UsedText}" />
      <TextBlock Text="{Binding Resets}" Opacity="0.6" />
    </StackPanel>
    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Used}" />
    <TextBlock Text="{Binding HoldAt}" Opacity="0.6" FontSize="12" />
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Avala.Workbench.Settings"
             x:Class="Avala.Workbench.UI.CapsView"
             x:ClassModifier="internal"
             x:DataType="settings:CapsViewModel">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock Text="{Binding Scope}" Opacity="0.6" />
    <TextBlock Text="{Binding Caps}" />
  </StackPanel>
</UserControl>

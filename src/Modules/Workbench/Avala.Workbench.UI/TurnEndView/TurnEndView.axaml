<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.TurnEndView"
             x:ClassModifier="internal"
             x:DataType="conversation:ITurnEndViewModel"
             Classes="fade-in"
             Margin="0,8">
  <Design.DataContext>
    <conversation:DesignTurnEndViewModel />
  </Design.DataContext>
  <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
    <Border Classes="separator" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
      <TextBlock x:Name="Summary"
                 Classes="caption"
                 Classes.failure="{Binding Outcome, Converter={x:Static states:EnumIs.Any}, ConverterParameter=Failed}"
                 Text="{Binding Summary}" />
      <TextBlock Classes="caption" Text="·" />
      <TextBlock x:Name="Tokens" Classes="caption" Text="{Binding Tokens, StringFormat='{}{0:N0} tokens'}" />
      <TextBlock Classes="caption"
                 Text="·"
                 IsVisible="{Binding Cost, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock x:Name="Cost"
                 Classes="caption"
                 Text="{Binding Cost}"
                 IsVisible="{Binding Cost, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
    <Border Grid.Column="2" Classes="separator" VerticalAlignment="Center" />
  </Grid>
</UserControl>

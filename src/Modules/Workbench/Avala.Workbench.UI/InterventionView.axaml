<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:usage="using:Avala.Workbench.Usage"
             x:Class="Avala.Workbench.UI.InterventionView"
             x:ClassModifier="internal"
             x:DataType="usage:InterventionViewModel">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock Text="{Binding At}" Opacity="0.6" />
    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
    <TextBlock Text="{Binding Reason}" />
    <TextBlock Text="{Binding Detail}" Opacity="0.6" />
  </StackPanel>
</UserControl>

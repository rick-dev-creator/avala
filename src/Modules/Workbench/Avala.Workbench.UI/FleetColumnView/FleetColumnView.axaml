<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fleet="using:Avala.Workbench.FleetActivity"
             x:Class="Avala.Workbench.UI.FleetColumnView"
             x:ClassModifier="internal"
             x:DataType="fleet:IFleetColumnViewModel">
  <Design.DataContext>
    <fleet:DesignFleetColumnViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="ProgressBar.layer">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="ProgressBar.column.stacked">
      <Setter Property="Foreground" Value="{DynamicResource ShareFaintBrush}" />
    </Style>
    <Style Selector="ProgressBar.layer.cacheWrite">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="ProgressBar.layer.reasoning">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ProgressBar.layer.output">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ProgressBar.layer.input">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ProgressBar.previous">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="Transparent" />
    </Style>
    <Style Selector="ProgressBar.previous /template/ Border#PART_Indicator">
      <Setter Property="BorderBrush" Value="{DynamicResource MeterMarkerBrush}" />
      <Setter Property="BorderThickness" Value="0,2,0,0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="ColumnCell" RowDefinitions="*,20" Margin="2,0" ToolTip.Tip="{Binding Tip}" Background="Transparent">
    <Panel>
      <ProgressBar x:Name="ColumnBar" Classes="column" Classes.stacked="{Binding IsStacked}" Value="{Binding Share}" />
      <ProgressBar x:Name="CacheWriteLayer" Classes="layer cacheWrite" Value="{Binding CacheWriteReach}" IsVisible="{Binding IsStacked}" />
      <ProgressBar x:Name="ReasoningLayer" Classes="layer reasoning" Value="{Binding ReasoningReach}" IsVisible="{Binding IsStacked}" />
      <ProgressBar x:Name="OutputLayer" Classes="layer output" Value="{Binding OutputReach}" IsVisible="{Binding IsStacked}" />
      <ProgressBar x:Name="InputLayer" Classes="layer input" Value="{Binding InputReach}" IsVisible="{Binding IsStacked}" />
      <ProgressBar x:Name="PreviousMark" Classes="previous" Value="{Binding Previous}" IsVisible="{Binding HasPrevious}" />
    </Panel>
    <TextBlock x:Name="TickText" Grid.Row="1" Classes="hint" Text="{Binding Tick}" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextWrapping="NoWrap" />
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Avala.Workbench.Settings"
             x:Class="Avala.Workbench.UI.CheckView"
             x:ClassModifier="internal"
             x:DataType="settings:ICheckViewModel">
  <Design.DataContext>
    <settings:DesignCheckViewModel />
  </Design.DataContext>
  <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="10" Margin="0,10">
    <TextBlock x:Name="CheckName" FontSize="{DynamicResource FontSizeMono}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="Command" Grid.Column="1" Classes="caption mono" Text="{Binding Command}" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="Timeout" Grid.Column="2" Classes="caption" Text="{Binding Timeout}" />
  </Grid>
</UserControl>

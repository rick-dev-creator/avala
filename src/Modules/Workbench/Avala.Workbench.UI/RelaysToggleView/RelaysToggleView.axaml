<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Avala.Workbench.Overview"
             x:Class="Avala.Workbench.UI.RelaysToggleView"
             x:ClassModifier="internal"
             x:DataType="overview:IRelaysToggleViewModel">
  <Design.DataContext>
    <overview:DesignRelaysToggleViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Button.glyph Path.icon">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>
  </UserControl.Styles>
  <Button x:Name="Relays"
          Classes="glyph"
          Classes.selected="{Binding IsOpen}"
          IsVisible="{Binding IsShown}"
          Command="{Binding ToggleCommand}"
          ToolTip.Tip="Relays · Elastic Harness Chaining"
          AutomationProperties.Name="Toggle the relays">
    <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconRelay}" />
  </Button>
</UserControl>

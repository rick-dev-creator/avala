<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:Avala.Workbench.Inspector"
             x:Class="Avala.Workbench.UI.WorktreeSectionView"
             x:ClassModifier="internal"
             x:DataType="inspector:WorktreeSectionViewModel">
  <StackPanel Spacing="4">
    <TextBlock Text="{Binding Branch}" FontFamily="monospace" />
    <TextBlock Text="{Binding Base}" FontFamily="monospace" Opacity="0.7" />
    <TextBlock Text="{Binding Path}" FontFamily="monospace" Opacity="0.7" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Ports}" Opacity="0.7" />
  </StackPanel>
</UserControl>

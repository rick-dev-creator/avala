<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:Avala.Workbench.Inspector"
             x:Class="Avala.Workbench.UI.DelegationSectionView"
             x:ClassModifier="internal"
             x:DataType="inspector:DelegationSectionViewModel">
  <StackPanel Spacing="4">
    <TextBlock Text="No delegation" Opacity="0.6" IsVisible="{Binding IsEmpty}" />
    <TextBlock Text="{Binding Parent}" />
    <ItemsControl ItemsSource="{Binding Children}" />
  </StackPanel>
</UserControl>

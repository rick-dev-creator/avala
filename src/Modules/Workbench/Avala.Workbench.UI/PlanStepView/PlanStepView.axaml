<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.PlanStepView"
             x:ClassModifier="internal"
             x:DataType="conversation:IPlanStepViewModel">
  <Design.DataContext>
    <conversation:DesignPlanStepViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Grid.step TextBlock.step">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Grid.step.done TextBlock.step">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="Grid.step.active TextBlock.step">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="13,*"
        ColumnSpacing="10"
        Classes="step"
        Classes.done="{Binding Status, Converter={x:Static states:EnumIs.Any}, ConverterParameter=Done}"
        Classes.active="{Binding Status, Converter={x:Static states:EnumIs.Any}, ConverterParameter=InProgress}">
    <Path x:Name="StepDone"
          Width="13"
          Height="13"
          Stretch="Uniform"
          StrokeThickness="1.6"
          StrokeLineCap="Round"
          StrokeJoin="Round"
          Stroke="{DynamicResource TextTertiaryBrush}"
          Data="{StaticResource IconCheck}"
          VerticalAlignment="Center"
          IsVisible="{Binding Status, Converter={x:Static states:EnumIs.Any}, ConverterParameter=Done}" />
    <Ellipse x:Name="StepInProgress"
             Width="7"
             Height="7"
             Fill="{DynamicResource TextPrimaryBrush}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             IsVisible="{Binding Status, Converter={x:Static states:EnumIs.Any}, ConverterParameter=InProgress}" />
    <Ellipse x:Name="StepPending"
             Width="11"
             Height="11"
             Stroke="{DynamicResource DotPendingBrush}"
             StrokeThickness="1.5"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             IsVisible="{Binding Status, Converter={x:Static states:EnumIs.Any}, ConverterParameter=Pending}" />
    <TextBlock x:Name="StepTitle" Grid.Column="1" Classes="step" Text="{Binding Title}" VerticalAlignment="Center" />
  </Grid>
</UserControl>

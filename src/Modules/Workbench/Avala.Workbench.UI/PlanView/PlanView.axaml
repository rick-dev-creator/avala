<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             x:Class="Avala.Workbench.UI.PlanView"
             x:ClassModifier="internal"
             x:DataType="conversation:IPlanViewModel"
             theme:Motion.Enter="Arrive"
             Margin="0,10">
  <Design.DataContext>
    <conversation:DesignPlanViewModel />
  </Design.DataContext>
  <Border BorderBrush="{DynamicResource SeparatorBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource RadiusBlock}"
          Padding="14,12">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="caption" Text="Plan" />
        <TextBlock x:Name="Progress" Grid.Column="1" Classes="caption" Text="{Binding Progress}" />
      </Grid>
      <ItemsControl x:Name="Steps" ItemsSource="{Binding Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accounts="using:Avala.Workbench.Accounts"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.AccountRowView"
             x:ClassModifier="internal"
             x:DataType="accounts:IAccountRowViewModel">
  <Design.DataContext>
    <accounts:DesignAccountRowViewModel />
  </Design.DataContext>
  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Margin="0,10">
    <Border Classes="mark">
      <Path x:Name="Logo" Classes="logo" Data="{Binding Logo, Converter={x:Static states:PathData.Parsed}}" />
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock x:Name="Login" Text="{Binding Login}" TextTrimming="CharacterEllipsis" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="Host" Classes="caption" Text="{Binding Host}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Problem"
                   Classes="caption attention"
                   Text="{Binding Problem}"
                   IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </StackPanel>
    <Border x:Name="SignIn"
            Grid.Column="2"
            Classes="tag"
            IsVisible="{Binding SignIn, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding SignIn}" />
    </Border>
    <Panel Grid.Column="3" VerticalAlignment="Center" MinWidth="56">
      <Button x:Name="Add"
              Classes="primary"
              Padding="12,3"
              HorizontalAlignment="Right"
              Content="Add"
              IsVisible="{Binding IsDetected}"
              Command="{Binding AddCommand}" />
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" IsVisible="{Binding !IsDetected}">
        <Ellipse x:Name="Status"
                 Classes="dot"
                 Classes.attention="{Binding State, Converter={x:Static states:EnumIs.Any}, ConverterParameter=Attention}"
                 ToolTip.Tip="{Binding Problem}" />
        <Button x:Name="Remove"
                Classes="glyph"
                ToolTip.Tip="Remove"
                AutomationProperties.Name="Remove"
                Command="{Binding RemoveCommand}">
          <Path Classes="icon small" Data="{StaticResource IconCross}" Stroke="{DynamicResource TextTertiaryBrush}" />
        </Button>
      </StackPanel>
    </Panel>
  </Grid>
</UserControl>

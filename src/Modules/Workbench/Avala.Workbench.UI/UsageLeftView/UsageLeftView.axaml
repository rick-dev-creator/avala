<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:usage="using:Avala.Workbench.Usage"
             x:Class="Avala.Workbench.UI.UsageLeftView"
             x:ClassModifier="internal"
             x:DataType="usage:IUsageLeftViewModel">
  <Design.DataContext>
    <usage:DesignUsageLeftViewModel />
  </Design.DataContext>
  <Button x:Name="Open"
          Classes="line"
          IsVisible="{Binding IsShown}"
          Command="{Binding OpenCommand}"
          AutomationProperties.Name="{Binding Summary}">
    <ToolTip.Tip>
      <StackPanel Width="320" Spacing="12">
        <TextBlock x:Name="Connection" Classes="caption secondary" Text="{Binding Connection, StringFormat='Usage left on {0}'}" TextTrimming="CharacterEllipsis" />
        <ItemsControl x:Name="Windows" ItemsSource="{Binding Windows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Classes="caption tertiary" Text="Open Usage for this connection" />
      </StackPanel>
    </ToolTip.Tip>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <ProgressBar x:Name="Used" Classes="bar thick" Classes.attention="{Binding IsNear}" Width="28" Value="{Binding Used}" VerticalAlignment="Center" />
      <TextBlock x:Name="Left" FontSize="{DynamicResource FontSizeMono}" Classes.attention="{Binding IsNear}" Text="{Binding Left}" VerticalAlignment="Center" />
    </StackPanel>
  </Button>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:usage="using:Avala.Workbench.Usage"
             xmlns:graphs="using:Avala.Components.UI.Graphs"
             x:Class="Avala.Workbench.UI.UsageLeftView"
             x:ClassModifier="internal"
             x:DataType="usage:IUsageLeftViewModel">
  <Design.DataContext>
    <usage:DesignUsageLeftViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Arc#Ring">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Arc#Ring.attention">
      <Setter Property="Stroke" Value="{DynamicResource AttentionBrush}" />
    </Style>
  </UserControl.Styles>
  <Button x:Name="Open"
          Classes="line"
          IsVisible="{Binding IsShown}"
          Command="{Binding OpenCommand}"
          ToolTip.Placement="Bottom"
          ToolTip.VerticalOffset="6"
          AutomationProperties.Name="{Binding Summary}">
    <ToolTip.Tip>
      <StackPanel x:Name="Detail" Width="{DynamicResource TipWidth}" Margin="2,4" Spacing="14">
        <DockPanel>
          <TextBlock x:Name="LeftDetail" DockPanel.Dock="Right" Classes="medium" Classes.attention="{Binding IsNear}" Text="{Binding Left}" Margin="12,0,0,0" TextWrapping="NoWrap" VerticalAlignment="Center" />
          <TextBlock x:Name="Connection" Classes="strong" Text="{Binding Connection}" FontSize="{DynamicResource FontSizeBody}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
        </DockPanel>
        <ItemsControl x:Name="Windows" ItemsSource="{Binding Windows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="14" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock x:Name="More" Classes="caption" Text="{Binding More}" IsVisible="{Binding More, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,-6,0,0" />
        <TextBlock x:Name="HoldAt" Classes="caption attention" Text="{Binding HoldAt}" IsVisible="{Binding HoldAt, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Margin="0,-6,0,0" />
        <StackPanel Spacing="6">
          <Border Classes="separator" Margin="0,0,0,4" />
          <TextBlock x:Name="Shared" Classes="caption" Text="{Binding Shared}" TextWrapping="Wrap" />
          <TextBlock x:Name="OpenHint" Classes="caption" Text="Click to open Usage for this connection." TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ToolTip.Tip>
    <StackPanel Orientation="Horizontal" Spacing="7">
      <Panel x:Name="Gauge" Width="16" Height="16" VerticalAlignment="Center">
        <Ellipse Margin="1" Stroke="{DynamicResource HubTrackBrush}" StrokeThickness="2.5" />
        <Arc x:Name="Ring"
             Margin="1"
             Classes.attention="{Binding IsNear}"
             StartAngle="-90"
             SweepAngle="{Binding Used, Converter={x:Static graphs:Graph.Degrees}}"
             StrokeThickness="2.5"
             StrokeLineCap="Round" />
      </Panel>
      <TextBlock x:Name="Left" FontSize="{DynamicResource FontSizeMono}" Classes.attention="{Binding IsNear}" Text="{Binding Left}" VerticalAlignment="Center" />
    </StackPanel>
  </Button>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="using:Avala.Workbench.Resources"
             x:Class="Avala.Workbench.UI.ResourceIndicatorView"
             x:ClassModifier="internal"
             x:DataType="resources:IResourceIndicatorViewModel">
  <Design.DataContext>
    <resources:DesignResourceIndicatorViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Button#Open">
      <Setter Property="Background" Value="{DynamicResource FillQuietBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusRow}" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button#Open:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
    </Style>
  </UserControl.Styles>
  <Button x:Name="Open" Command="{Binding OpenCommand}" ToolTip.Tip="Open resources">
    <StackPanel Spacing="9">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="Scope" Classes="caption secondary" Text="{Binding Scope}" />
        <Path Grid.Column="1"
              Classes="icon small"
              Width="9"
              Height="9"
              Stroke="{DynamicResource TextTertiaryBrush}"
              Data="{StaticResource IconChevronRight}"
              VerticalAlignment="Center" />
      </Grid>
      <Grid ColumnDefinitions="*,12,*">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="caption" Text="Memory" FontSize="{DynamicResource FontSizeHint}" />
            <TextBlock x:Name="Memory"
                       Grid.Column="1"
                       FontSize="{DynamicResource FontSizeHint}"
                       Text="{Binding Memory}" />
          </Grid>
        </StackPanel>
        <ContentControl x:Name="Cpu" Grid.Column="2" Content="{Binding Cpu}" />
      </Grid>
      <StackPanel x:Name="LeftoversLine" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasLeftovers}">
        <Ellipse Width="6" Height="6" Fill="{DynamicResource AttentionBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="Leftovers"
                   Classes="caption attention"
                   Text="{Binding Leftovers, StringFormat='{}{0} left over'}" />
      </StackPanel>
    </StackPanel>
  </Button>
</UserControl>

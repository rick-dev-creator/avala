<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inspector="using:Avala.Workbench.Inspector"
             x:Class="Avala.Workbench.UI.EvidenceSectionView"
             x:ClassModifier="internal"
             x:DataType="inspector:EvidenceSectionViewModel">
  <StackPanel Spacing="4">
    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
    <ItemsControl ItemsSource="{Binding Attempts}" />
  </StackPanel>
</UserControl>

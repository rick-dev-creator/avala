<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:usage="using:Avala.Workbench.Usage"
             x:Class="Avala.Workbench.UI.UsageWindowView"
             x:ClassModifier="internal"
             x:DataType="usage:IUsageWindowViewModel">
  <Design.DataContext>
    <usage:DesignUsageWindowViewModel />
  </Design.DataContext>
  <Border Classes="quiet" Padding="14,10" Margin="0,0,0,8">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="Label" Classes="strong" Text="{Binding Label}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="Cost" Text="{Binding Cost}" />
          <TextBlock x:Name="Tokens" Classes="caption" Text="{Binding Tokens}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
      <WrapPanel>
        <TextBlock Classes="caption" Margin="0,0,12,0" Text="{Binding Input, StringFormat='input {0:N0}'}" />
        <TextBlock Classes="caption" Margin="0,0,12,0" Text="{Binding Output, StringFormat='output {0:N0}'}" />
        <TextBlock Classes="caption" Margin="0,0,12,0" Text="{Binding CacheRead, StringFormat='cache read {0:N0}'}" />
        <TextBlock Classes="caption" Margin="0,0,12,0" Text="{Binding CacheWrite, StringFormat='cache write {0:N0}'}" />
        <TextBlock Classes="caption" Text="{Binding Reasoning, StringFormat='reasoning {0:N0}'}" />
      </WrapPanel>
      <TextBlock x:Name="Turns" Classes="caption" Text="{Binding Turns}" />
      <TextBlock x:Name="Unpriced"
                 Classes="caption"
                 Text="{Binding Unpriced}"
                 IsVisible="{Binding Unpriced, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Border>
</UserControl>

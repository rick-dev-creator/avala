<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:usage="using:Avala.Workbench.Usage"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.UsageRangeView"
             x:ClassModifier="internal"
             x:DataType="usage:IUsageRangeViewModel">
  <Design.DataContext>
    <usage:DesignUsageRangeViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Border#Segments">
      <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>
    <ContainerQuery Name="Range" Query="max-width:520">
      <Style Selector="Border#Segments">
        <Setter Property="DockPanel.Dock" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,10,0,0" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <StackPanel Spacing="10" Container.Name="Range" Container.Sizing="Width">
    <DockPanel>
      <Border x:Name="Segments" Classes="segments" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ShowToday"
                  Classes="segment"
                  Classes.selected="{Binding ShowsToday}"
                  Content="Today"
                  Command="{Binding ShowTodayCommand}" />
          <Button x:Name="ShowWeek"
                  Classes="segment"
                  Classes.selected="{Binding ShowsWeek}"
                  Content="7 days"
                  Command="{Binding ShowWeekCommand}" />
          <Button x:Name="ShowMonth"
                  Classes="segment"
                  Classes.selected="{Binding ShowsMonth}"
                  Content="30 days"
                  Command="{Binding ShowMonthCommand}" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock x:Name="RangeTitle" Classes="section" Text="Usage by day" />
        <TextBlock x:Name="Caption" Classes="caption" Text="{Binding Caption, Converter={x:Static states:Texts.Unbroken}}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
    <ContentControl x:Name="Total" Content="{Binding Total}" />
    <ItemsControl x:Name="Days" ItemsSource="{Binding Days}" Grid.IsSharedSizeScope="True" />
  </StackPanel>
</UserControl>

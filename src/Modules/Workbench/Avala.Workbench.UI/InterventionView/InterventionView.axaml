<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:usage="using:Avala.Workbench.Usage"
             x:Class="Avala.Workbench.UI.InterventionView"
             x:ClassModifier="internal"
             x:DataType="usage:IInterventionViewModel">
  <Design.DataContext>
    <usage:DesignInterventionViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="WrapPanel#What">
      <Setter Property="Grid.Column" Value="1" />
    </Style>
    <ContainerQuery Name="Intervention" Query="max-width:472">
      <Style Selector="TextBlock#At">
        <Setter Property="Grid.ColumnSpan" Value="2" />
      </Style>
      <Style Selector="WrapPanel#What">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="0,2,0,0" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <Grid ColumnDefinitions="128,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" Container.Name="Intervention" Container.Sizing="Width">
    <TextBlock x:Name="At" Classes="tertiary" FontSize="{DynamicResource FontSizeMono}" Text="{Binding At}" />
    <WrapPanel x:Name="What" ItemSpacing="6">
      <TextBlock x:Name="Title" FontSize="{DynamicResource FontSizeMono}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="Reason" Classes="attention" FontSize="{DynamicResource FontSizeMono}" Text="{Binding Reason, StringFormat='held: {0}'}" TextWrapping="Wrap" />
      <TextBlock x:Name="Detail" Classes="secondary" FontSize="{DynamicResource FontSizeMono}" Text="{Binding Detail, StringFormat='— {0}'}" TextWrapping="Wrap" />
    </WrapPanel>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:trimming="using:Avala.Components.UI.Trimming"
             xmlns:usage="using:Avala.Workbench.Usage"
             x:Class="Avala.Workbench.UI.ConnectionMeterView"
             x:ClassModifier="internal"
             x:DataType="usage:IConnectionMeterViewModel">
  <Design.DataContext>
    <usage:DesignConnectionMeterViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Border#Meter.focused">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock#Cost">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <ContainerQuery Name="Meter" Query="max-width:472">
      <Style Selector="TextBlock#Cost">
        <Setter Property="DockPanel.Dock" Value="Bottom" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <Border x:Name="Meter" Classes="grouped" Classes.focused="{Binding IsFocused}" theme:Motion.Enter="Arrive" Padding="22,20" Container.Name="Meter" Container.Sizing="Width">
    <StackPanel Spacing="18">
      <StackPanel Spacing="2">
        <DockPanel>
          <TextBlock x:Name="Cost" Text="{Binding Cost, StringFormat='{}{0} in total'}" VerticalAlignment="Bottom" />
          <WrapPanel ItemSpacing="10">
            <TextBlock x:Name="ConnectionName" Classes="heading" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
            <TextBlock x:Name="Provider" Classes="caption" Text="{Binding Provider}" VerticalAlignment="Bottom" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" trimming:TrimmedTip.IsOffered="True" />
          </WrapPanel>
        </DockPanel>
        <TextBlock x:Name="Tokens" Classes="caption" TextWrapping="Wrap">
          <Run Text="{Binding Tokens}" />
          <Run Text=" · " />
          <Run Text="{Binding Caps}" />
        </TextBlock>
        <TextBlock x:Name="Unpriced" Classes="caption" Text="{Binding Unpriced}" IsVisible="{Binding Unpriced, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <TextBlock x:Name="NoLimits" Classes="caption" Text="This connection reports no usage limit." IsVisible="{Binding !Limits.Count}" />
      <ItemsControl x:Name="Limits" ItemsSource="{Binding Limits}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="18" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <TextBlock x:Name="Shared" Classes="caption" Text="{Binding Shared}" IsVisible="{Binding !!Limits.Count}" TextWrapping="Wrap" Margin="0,-8,0,0" />
    </StackPanel>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:usage="using:Avala.Workbench.Usage"
             x:Class="Avala.Workbench.UI.ConnectionMeterView"
             x:ClassModifier="internal"
             x:DataType="usage:IConnectionMeterViewModel">
  <Design.DataContext>
    <usage:DesignConnectionMeterViewModel />
  </Design.DataContext>
  <Border Classes="card" Padding="{DynamicResource PaddingCard}" Margin="0,0,0,8">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="ConnectionName" Classes="strong mono" Text="{Binding Name}" />
          <TextBlock x:Name="Provider" Classes="caption" Text="{Binding Provider}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="Cost" Text="{Binding Cost}" />
          <TextBlock x:Name="Tokens" Classes="caption" Text="{Binding Tokens}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="Unpriced"
                 Classes="caption"
                 Text="{Binding Unpriced}"
                 IsVisible="{Binding Unpriced, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock x:Name="Caps" Classes="caption" Text="{Binding Caps}" />
      <ItemsControl x:Name="Limits" ItemsSource="{Binding Limits}" />
    </StackPanel>
  </Border>
</UserControl>

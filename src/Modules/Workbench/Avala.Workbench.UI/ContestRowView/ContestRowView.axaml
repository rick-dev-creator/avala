<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sidebar="using:Avala.Workbench.Sidebar"
             x:Class="Avala.Workbench.UI.ContestRowView"
             x:ClassModifier="internal"
             x:DataType="sidebar:IContestRowViewModel"
             ClipToBounds="False"
             Classes.selected="{Binding IsSelected}">
  <Design.DataContext>
    <sidebar:DesignContestRowViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="TextBlock#Title">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ContentControl#Dot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="Button#Toggle">
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button#Toggle Path">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
    <ContentControl x:Name="Dot"
                    ClipToBounds="False"
                    Content="{Binding Dot}"
                    VerticalAlignment="Center" />
    <TextBlock x:Name="Title"
               Grid.Column="1"
               Text="{Binding Title}"
               TextTrimming="CharacterEllipsis"
               VerticalAlignment="Center" />
    <TextBlock x:Name="Fact"
               Grid.Column="2"
               Classes="caption"
               Margin="10,0,0,0"
               MaxWidth="150"
               Text="{Binding Fact}"
               TextTrimming="CharacterEllipsis"
               VerticalAlignment="Center" />
    <Border x:Name="PendingBadge"
            Grid.Column="3"
            Classes="badge"
            MinWidth="16"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            ToolTip.Tip="Decisions waiting for you"
            IsVisible="{Binding HasPendingDecisions}">
      <TextBlock x:Name="Pending" Text="{Binding PendingDecisions}" HorizontalAlignment="Center" />
    </Border>
    <Button x:Name="Toggle"
            Grid.Column="4"
            VerticalAlignment="Center"
            Command="{Binding ToggleCommand}"
            ToolTip.Tip="Show or hide the candidates"
            AutomationProperties.Name="Show or hide the candidates">
      <Panel>
        <Path x:Name="Collapsed" Data="{StaticResource IconChevronRight}" IsVisible="{Binding !IsExpanded}" />
        <Path x:Name="Expanded" Data="{StaticResource IconChevronDown}" IsVisible="{Binding IsExpanded}" />
      </Panel>
    </Button>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             x:Class="Avala.Workbench.UI.CanvasView"
             x:ClassModifier="internal"
             x:DataType="conversation:CanvasViewModel">
  <Border BorderThickness="1" BorderBrush="#33FFFFFF" CornerRadius="8" Padding="12">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding MediaType}" Opacity="0.6" />
      </StackPanel>
      <SelectableTextBlock Text="{Binding Content}" FontFamily="monospace" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>

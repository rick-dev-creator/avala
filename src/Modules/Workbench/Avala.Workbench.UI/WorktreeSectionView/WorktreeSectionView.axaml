<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:privacy="using:Avala.Components.UI.Privacy"
             xmlns:inspector="using:Avala.Workbench.Inspector"
             xmlns:ui="using:Avala.Components.UI"
             x:Class="Avala.Workbench.UI.WorktreeSectionView"
             x:ClassModifier="internal"
             x:DataType="inspector:IWorktreeSectionViewModel">
  <Design.DataContext>
    <inspector:DesignWorktreeSectionViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="TextBlock.value, SelectableTextBlock.value">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
  </UserControl.Styles>
  <ui:Fold x:Name="Section" Header="Worktree" Fact="{Binding Fact}">
    <StackPanel Margin="28,0,12,12" Spacing="7">
      <TextBlock x:Name="Loading" Classes="caption" theme:Motion.Loop="Pulse" Text="Reading…" IsVisible="{Binding !IsLoaded}" />
      <StackPanel x:Name="ScratchRepository" Spacing="4" IsVisible="{Binding IsScratch}">
        <DockPanel>
          <Border DockPanel.Dock="Left"
                  Classes="tag"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Started without a repository: this job runs in a scratch repository in Avala's data folder, kept after the job">
            <TextBlock Text="Scratch" />
          </Border>
          <Button x:Name="OpenFolder"
                  DockPanel.Dock="Right"
                  Classes="link"
                  HorizontalAlignment="Right"
                  Padding="6,2"
                  Content="Open folder"
                  ToolTip.Tip="Open the scratch repository in the file manager"
                  Command="{Binding OpenFolderCommand}" />
        </DockPanel>
        <SelectableTextBlock x:Name="Repository" Classes="value" Margin="0" TextAlignment="Left" TextWrapping="Wrap" Text="{Binding Repository}" />
        <TextBlock x:Name="FolderProblem"
                   Classes="caption attention"
                   TextWrapping="Wrap"
                   Text="{Binding FolderProblem}"
                   IsVisible="{Binding FolderProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Base, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="caption secondary" Text="Branch" />
        <TextBlock x:Name="Branch" Grid.Column="1" Classes="value" TextTrimming="CharacterEllipsis" Text="{Binding Branch}" />
      </Grid>
      <TextBlock x:Name="NoWorktree"
                 Classes="caption secondary"
                 Text="{Binding Branch}"
                 IsVisible="{Binding Base, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Base, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="caption secondary" Text="Base" />
        <TextBlock x:Name="Base" Grid.Column="1" Classes="value" Text="{Binding Base}" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !!Path.Value.Length}">
        <TextBlock Classes="caption secondary" Text="Path" />
        <SelectableTextBlock x:Name="Path" Grid.Column="1" Classes="value" TextWrapping="Wrap" privacy:PersonalDetails.Text="{Binding Path}" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Ports, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="caption secondary" Text="Ports" />
        <TextBlock x:Name="Ports" Grid.Column="1" Classes="value" Text="{Binding Ports}" />
      </Grid>
    </StackPanel>
  </ui:Fold>
</UserControl>

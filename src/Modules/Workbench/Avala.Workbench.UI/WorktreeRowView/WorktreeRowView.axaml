<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="using:Avala.Workbench.Resources"
             x:Class="Avala.Workbench.UI.WorktreeRowView"
             x:ClassModifier="internal"
             x:DataType="resources:IWorktreeRowViewModel">
  <Design.DataContext>
    <resources:DesignWorktreeRowViewModel />
  </Design.DataContext>
  <DockPanel Margin="0,9">
    <Button x:Name="Open" DockPanel.Dock="Right" Classes="link" Margin="12,0,0,0" Padding="0" Content="Open" IsVisible="{Binding CanOpen}" Command="{Binding OpenCommand}" VerticalAlignment="Center" ToolTip.Tip="Open this job" />
    <TextBlock x:Name="Amount" DockPanel.Dock="Right" Margin="16,0,0,0" FontSize="{DynamicResource FontSizeMono}" Text="{Binding Amount}" VerticalAlignment="Center" />
    <StackPanel Spacing="2" VerticalAlignment="Center">
      <TextBlock x:Name="Title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="Detail" Classes="caption" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </DockPanel>
</UserControl>

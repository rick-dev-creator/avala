<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:usage="using:Avala.Workbench.Usage"
             x:Class="Avala.Workbench.UI.JobMeterView"
             x:ClassModifier="internal"
             x:DataType="usage:IJobMeterViewModel">
  <Design.DataContext>
    <usage:DesignJobMeterViewModel />
  </Design.DataContext>
  <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1" Padding="0,11">
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="Auto" SharedSizeGroup="Cost" />
      </Grid.ColumnDefinitions>
      <DockPanel>
        <TextBlock x:Name="Carve" DockPanel.Dock="Right" Classes="caption" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Carve}" IsVisible="{Binding Carve, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock x:Name="Interventions"
                   DockPanel.Dock="Right"
                   Classes="caption attention"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   Text="{Binding Held}"
                   IsVisible="{Binding Interventions}" />
        <TextBlock x:Name="Title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock x:Name="Connection" Grid.Column="1" Classes="caption" Text="{Binding Connection}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <Panel Grid.Column="2" VerticalAlignment="Center" IsVisible="{Binding HasCap}">
        <ProgressBar x:Name="Used" Classes="bar" Classes.attention="{Binding IsNearCap}" Value="{Binding Used}" VerticalAlignment="Center" />
        <ProgressBar Classes="marker" Height="10" Value="1" />
      </Panel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock x:Name="Cost" FontSize="{DynamicResource FontSizeMono}" Text="{Binding Cost}" />
        <TextBlock x:Name="Cap" Classes="tertiary" FontSize="{DynamicResource FontSizeMono}" Text="{Binding Cap, StringFormat=' / {0}'}" IsVisible="{Binding HasCap}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>

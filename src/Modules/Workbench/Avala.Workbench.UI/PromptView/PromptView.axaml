<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:states="using:Avala.Components.UI.States"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             xmlns:markdown="using:Avala.Components.UI.Markdown"
             xmlns:copying="using:Avala.Components.UI.Copying"
             x:Class="Avala.Workbench.UI.PromptView"
             x:ClassModifier="internal"
             x:DataType="conversation:IPromptViewModel"
             Classes="hover-host"
             theme:Motion.Enter="Arrive"
             Classes.person="{Binding IsFromPerson}"
             Margin="0,10,0,0"
             Classes.found="{Binding Found, Converter={x:Static states:EnumIs.Any}, ConverterParameter='Match,Current'}"
             Classes.current="{Binding Found, Converter={x:Static states:EnumIs.Any}, ConverterParameter='Current'}">
  <Design.DataContext>
    <conversation:DesignPromptViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Border#Bubble">
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusBlock}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border#Bubble.person">
      <Setter Property="Background" Value="{DynamicResource FillBubbleBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusBubble}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="StackPanel#Actions">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector=":is(UserControl).person StackPanel#Heading, :is(UserControl).person StackPanel#Actions">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="SelectableTextBlock#Text">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeReading}" />
      <Setter Property="LineHeight" Value="23" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="4">
    <StackPanel x:Name="Heading"
                Orientation="Horizontal"
                Spacing="6"
                HorizontalAlignment="Left"
                IsVisible="{Binding ShowsOrigin}">
      <TextBlock x:Name="Origin" Classes="caption" Text="{Binding Origin}" />
      <TextBlock Classes="caption" Text="·" />
      <TextBlock x:Name="Outcome" Classes="caption" Text="{Binding Outcome}" />
    </StackPanel>
    <Border x:Name="Bubble"
            Classes.person="{Binding IsFromPerson}"
            MaxWidth="560"
            Padding="14,10"
            IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Panel>
        <SelectableTextBlock x:Name="Text" Text="{Binding Text}" IsVisible="{Binding IsFromPerson}" />
        <markdown:MarkdownText x:Name="Brief" Classes="compact" Markdown="{Binding Text}" IsVisible="{Binding !IsFromPerson}" />
      </Panel>
    </Border>
    <StackPanel x:Name="Actions"
                Classes="hover-actions"
                Margin="0,-2,-5,-2"
                IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <copying:CopyButton x:Name="Copy"
                          Command="{Binding CopyCommand}"
                          IsCopied="{Binding IsCopied}"
                          ToolTip.Tip="Copy"
                          AutomationProperties.Name="Copy the message" />
      <Button x:Name="Edit"
              Classes="glyph mini"
              Command="{Binding EditCommand}"
              IsVisible="{Binding CanEdit}"
              ToolTip.Tip="Edit in the composer"
              AutomationProperties.Name="Edit the message in the composer">
        <Path Classes="icon" Data="{StaticResource IconEdit}" />
      </Button>
      <Button x:Name="Retry"
              Classes="glyph mini"
              Command="{Binding RetryCommand}"
              IsVisible="{Binding CanResend}"
              ToolTip.Tip="Send again"
              AutomationProperties.Name="Send the message again">
        <Path Classes="icon" Data="{StaticResource IconRetry}" />
      </Button>
    </StackPanel>
  </StackPanel>
</UserControl>

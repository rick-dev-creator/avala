<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Avala.Workbench.Settings"
             x:Class="Avala.Workbench.UI.MachineConnectionView"
             x:ClassModifier="internal"
             x:DataType="settings:MachineConnectionViewModel">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock Text="{Binding Name}" />
    <TextBlock Text="default" Opacity="0.6" IsVisible="{Binding IsDefault}" />
    <TextBlock Text="{Binding Provider}" Opacity="0.6" />
    <TextBlock Text="{Binding Source}" Opacity="0.6" />
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fleet="using:Avala.Workbench.FleetActivity"
             xmlns:privacy="using:Avala.Components.UI.Privacy"
             x:Class="Avala.Workbench.UI.FleetJobRowView"
             x:ClassModifier="internal"
             x:DataType="fleet:IFleetJobRowViewModel">
  <Design.DataContext>
    <fleet:DesignFleetJobRowViewModel />
  </Design.DataContext>
  <StackPanel Spacing="2" Margin="8,4">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock x:Name="InstanceText" privacy:PersonalDetails.Text="{Binding Instance}" />
      <TextBlock x:Name="StateText" Classes="caption" Text="{Binding State}" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="SpendingText" Classes="caption" Text="{Binding Spending}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>

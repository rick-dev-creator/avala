<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="using:Avala.Workbench.Resources"
             x:Class="Avala.Workbench.UI.OrphanView"
             x:ClassModifier="internal"
             x:DataType="resources:OrphanViewModel">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock Text="{Binding At}" Opacity="0.6" />
    <TextBlock Text="{Binding Disposal}" />
    <ItemsControl ItemsSource="{Binding Processes}" />
  </StackPanel>
</UserControl>

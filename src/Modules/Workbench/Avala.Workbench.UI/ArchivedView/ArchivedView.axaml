<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:archive="using:Avala.Workbench.Archive"
             x:Class="Avala.Workbench.UI.ArchivedView"
             x:ClassModifier="internal"
             x:DataType="archive:IArchivedViewModel">
  <Design.DataContext>
    <archive:DesignArchivedViewModel />
  </Design.DataContext>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="pageHeader">
      <DockPanel>
        <TextBlock x:Name="Summary" DockPanel.Dock="Right" Classes="caption" Text="{Binding Summary}" VerticalAlignment="Center" />
        <TextBlock x:Name="Title" Classes="pageTitle" Text="{Binding Title}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ContentControl x:Name="ReadProblem" DockPanel.Dock="Top" Margin="24,16,24,0" Content="{Binding ReadProblem}" IsVisible="{Binding ReadProblem.IsShown}" />
    <Panel>
      <StackPanel x:Name="Empty"
                  Spacing="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding !HasArchived}">
        <Path Classes="icon" Width="36" Height="36" StrokeThickness="1.2" Stroke="{DynamicResource TextTertiaryBrush}" Data="{StaticResource IconArchive}" HorizontalAlignment="Center" />
        <TextBlock Classes="secondary" Text="{Binding Empty}" HorizontalAlignment="Center" />
      </StackPanel>
      <ScrollViewer IsVisible="{Binding HasArchived}">
        <ItemsControl x:Name="Groups" ItemsSource="{Binding Groups}" Margin="24,28,24,48" MaxWidth="820">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="22" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="archive:ArchivedGroup">
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0,0,6">
                  <TextBlock Classes="strong" Text="{Binding Name}" />
                  <TextBlock Classes="caption" Text="{Binding Count}" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>

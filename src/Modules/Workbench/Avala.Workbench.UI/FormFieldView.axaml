<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="using:Avala.Workbench.Cards"
             x:Class="Avala.Workbench.UI.FormFieldView"
             x:ClassModifier="internal"
             x:DataType="cards:FormFieldViewModel">
  <StackPanel Spacing="4">
    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding Choices}" />
    <TextBox Text="{Binding Text}" IsVisible="{Binding AcceptsFreeText}" />
    <CheckBox Content="Confirm" IsChecked="{Binding Confirmed}" />
  </StackPanel>
</UserControl>

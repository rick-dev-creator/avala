<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             xmlns:copying="using:Avala.Components.UI.Copying"
             xmlns:focusing="using:Avala.Components.UI.Focusing"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.ComposerView"
             x:ClassModifier="internal"
             x:DataType="conversation:IComposerViewModel">
  <Design.DataContext>
    <conversation:DesignComposerViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Border#Field">
      <Setter Property="Background" Value="{DynamicResource SurfaceComposerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeFloatBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowComposer}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#Field:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorStrongBrush}" />
    </Style>
    <Style Selector="Button.stop">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    </Style>
    <Style Selector="Button.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillGhostHoverBrush}" />
    </Style>
    <Style Selector="Button.send Path.icon">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
      <Setter Property="StrokeThickness" Value="1.8" />
    </Style>
    <Style Selector="TextBox#Draft">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="6">
    <TextBlock x:Name="Error"
               Classes="caption failure"
               Margin="16,0"
               TextWrapping="Wrap"
               Text="{Binding Error}"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Grid x:Name="QueuedNote"
          ColumnDefinitions="*,Auto"
          Margin="16,0"
          IsVisible="{Binding Queued, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Spacing="2">
        <TextBlock x:Name="QueuedCaption" Classes="caption" Text="{Binding QueuedCaption}" />
        <TextBlock x:Name="QueuedText"
                   Classes="secondary"
                   TextWrapping="Wrap"
                   MaxLines="3"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding Queued}" />
      </StackPanel>
      <Button x:Name="Withdraw"
              Grid.Column="1"
              Classes="quiet"
              VerticalAlignment="Top"
              Content="Withdraw"
              Command="{Binding WithdrawCommand}"
              AutomationProperties.Name="Withdraw the queued message" />
    </Grid>
    <Grid x:Name="ColdNote"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="8"
          Margin="16,0"
          IsVisible="{Binding ColdNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Path Classes="icon" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource IconUsage}" />
      <TextBlock x:Name="ColdText"
                 Grid.Column="1"
                 Classes="caption"
                 TextWrapping="Wrap"
                 Text="{Binding ColdNote}" />
      <Button x:Name="Compact"
              Grid.Column="2"
              Classes="quiet"
              VerticalAlignment="Top"
              Content="Compact first"
              Command="{Binding CompactCommand}"
              IsVisible="{Binding CanCompact}"
              AutomationProperties.Name="Compact the conversation before sending" />
    </Grid>
    <Border x:Name="Field"
            states:Dropping.Command="{Binding Attachments.DropCommand}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusCard}"
            Padding="16,8,8,8">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto">
        <ContentControl x:Name="Attachments" Grid.ColumnSpan="4" Margin="-8,0,0,4" Content="{Binding Attachments}" IsVisible="{Binding Attachments.HasAttachments}" />
        <TextBox x:Name="Draft"
                 Grid.Row="1"
                 states:Pasting.Command="{Binding Attachments.PasteCommand}"
                 Classes="bare"
                 VerticalAlignment="Center"
                 Text="{Binding Draft}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MaxHeight="180"
                 PlaceholderText="{Binding Placeholder}"
                 focusing:Refocus.Signal="{Binding Edits}"
                 AutomationProperties.Name="Message">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Down" Command="{Binding Mentions.NextCommand}" />
            <KeyBinding Gesture="Up" Command="{Binding Mentions.PreviousCommand}" />
            <KeyBinding Gesture="Up" Command="{Binding RecallEarlierCommand}" />
            <KeyBinding Gesture="Down" Command="{Binding RecallLaterCommand}" />
            <KeyBinding Gesture="Enter" Command="{Binding Mentions.ChooseCommand}" />
            <KeyBinding Gesture="Tab" Command="{Binding Mentions.ChooseCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding Mentions.DismissCommand}" />
            <KeyBinding Gesture="{x:Static copying:Hotkeys.Enter}" Command="{Binding EnterCommand}" />
            <KeyBinding Gesture="{x:Static copying:Hotkeys.CommandEnter}" Command="{Binding SendCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding InterruptCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Popup x:Name="MentionsPopup"
               Grid.Row="1"
               PlacementTarget="Field"
               Placement="TopEdgeAlignedLeft"
               VerticalOffset="-6"
               IsLightDismissEnabled="False"
               IsOpen="{Binding Mentions.IsOpen}">
          <ContentControl x:Name="Mentions" Content="{Binding Mentions}" />
        </Popup>
        <Button x:Name="Attach"
                Grid.Row="1"
                Grid.Column="1"
                Classes="glyph"
                Margin="8,0,0,0"
                VerticalAlignment="Bottom"
                Command="{Binding Attachments.AttachCommand}"
                IsVisible="{Binding Attachments.CanAttach}"
                ToolTip.Tip="Attach files, or drop or paste them here"
                AutomationProperties.Name="Attach files">
          <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconAttach}" />
        </Button>
        <ContentControl x:Name="ComposerHarness"
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Bottom"
                        Content="{Binding Harness}" />
        <Panel Grid.Row="1" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Bottom">
          <Button x:Name="Send"
                  Classes="send"
                  Command="{Binding SendCommand}"
                  IsVisible="{Binding ShowsSend}"
                  ToolTip.Tip="{Binding SendHint}"
                  AutomationProperties.Name="Send">
            <Path Classes="icon" Data="{StaticResource IconSend}" />
          </Button>
          <Button x:Name="Interrupt"
                  Classes="stop"
                  Command="{Binding InterruptCommand}"
                  IsVisible="{Binding ShowsStop}"
                  ToolTip.Tip="Stop (Esc) · the session stays open"
                  AutomationProperties.Name="Stop">
            <Panel Width="30" Height="30">
              <Ellipse x:Name="Track" StrokeThickness="2" Stroke="{DynamicResource SeparatorBrush}" />
              <Arc x:Name="Progress"
                   theme:Motion.Loop="Spin"
                   StrokeThickness="2"
                   StrokeLineCap="Round"
                   StartAngle="-90"
                   SweepAngle="90"
                   Stroke="{DynamicResource TextSecondaryBrush}" />
              <Border Width="10" Height="10" CornerRadius="{DynamicResource RadiusTag}" Background="{DynamicResource TextPrimaryBrush}" />
            </Panel>
          </Button>
        </Panel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>

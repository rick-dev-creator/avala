<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Avala.Workbench.Overview"
             x:Class="Avala.Workbench.UI.DelegationNodeView"
             x:ClassModifier="internal"
             x:DataType="overview:IDelegationNodeViewModel">
  <Design.DataContext>
    <overview:DesignDelegationNodeViewModel />
  </Design.DataContext>
  <Border Classes="quiet" Padding="12,8">
    <StackPanel Spacing="2">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock x:Name="Depth" Classes="caption" Text="{Binding Depth, StringFormat='L{0}'}" Margin="0,0,8,0" />
        <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Status" Grid.Column="2" Classes="caption" Text="{Binding Status}" Margin="8,0,0,0" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="Harness" Classes="caption" Text="{Binding Harness}" />
        <TextBlock x:Name="Connection" Classes="caption mono" Text="{Binding Connection}" />
        <TextBlock x:Name="Activity" Classes="caption secondary" Text="{Binding Activity}" />
        <TextBlock x:Name="Spent" Classes="caption" Text="{Binding Spent}" />
        <TextBlock x:Name="Carve" Classes="caption" Text="{Binding Carve, StringFormat='of {0}'}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Avala.Workbench.Overview"
             xmlns:graphs="using:Avala.Components.UI.Graphs"
             xmlns:elapsed="using:Avala.Components.UI.Elapsed"
             x:Class="Avala.Workbench.UI.DelegationNodeView"
             x:ClassModifier="internal"
             x:DataType="overview:IDelegationNodeViewModel"
             graphs:Graph.Depth="{Binding Place.Depth}"
             graphs:Graph.Edge="{Binding Place.Edge}">
  <Design.DataContext>
    <overview:DesignDelegationNodeViewModel IsOpen="True" />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Button#Fold Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="Arc#Ring">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Arc#Ring.attention">
      <Setter Property="Stroke" Value="{DynamicResource AttentionBrush}" />
    </Style>
  </UserControl.Styles>
  <Border x:Name="Card"
          Classes="node"
          Classes.attention="{Binding Place.IsWaiting}"
          Classes.alert="{Binding Place.IsAlert}"
          Classes.settled="{Binding Place.IsSettled}"
          Classes.viewing="{Binding IsViewing}"
          Width="280"
          Padding="12,10"
          theme:Motion.Enter="Gentle">
    <StackPanel Spacing="6">
      <Button x:Name="Row"
              Classes="bare"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              AutomationProperties.Name="{Binding Title}"
              Command="{Binding ToggleCommand}">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Border x:Name="Badge" Classes="tag" Width="24" Height="24" Padding="0" VerticalAlignment="Top" ToolTip.Tip="{Binding Harness}">
              <TextBlock x:Name="Initials" Text="{Binding Harness, Converter={x:Static graphs:Graph.Initials}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock x:Name="Title" Classes="medium" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="Harness" Classes="hint" Text="{Binding Harness}" IsVisible="{Binding Harness, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="hint" Text="·" IsVisible="{Binding Harness, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock x:Name="Connection" Classes="hint" Text="{Binding Connection}" TextTrimming="CharacterEllipsis" MaxWidth="110" />
              </StackPanel>
            </StackPanel>
            <ContentControl x:Name="State" Grid.Column="2" Content="{Binding Place}" VerticalAlignment="Top" />
          </Grid>
          <TextBlock x:Name="Doing" Classes="caption secondary" Text="{Binding Doing}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
      <DockPanel>
        <Button x:Name="Fold"
                DockPanel.Dock="Right"
                Classes="bare"
                Padding="4,0"
                IsVisible="{Binding Place.HasBranches}"
                AutomationProperties.Name="Fold or unfold its sub-agents"
                Command="{Binding Place.FoldCommand}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock x:Name="Branches" Classes="hint" Text="{Binding Place.Branches}" />
            <Panel Width="9" Height="9" VerticalAlignment="Center">
              <Path Classes="icon" Width="9" Height="9" Data="{StaticResource IconChevronRight}" IsVisible="{Binding Place.IsFolded}" />
              <Path Classes="icon" Width="9" Height="9" Data="{StaticResource IconChevronDown}" IsVisible="{Binding !Place.IsFolded}" />
            </Panel>
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock x:Name="Spent" Classes="hint medium" Text="{Binding Spent}" IsVisible="{Binding Spent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="hint" Text="·" IsVisible="{Binding Spent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <elapsed:ElapsedText x:Name="Elapsed" Classes="hint" Since="{Binding Since}" IsVisible="{Binding IsTiming}" />
          <TextBlock x:Name="Took" Classes="hint" Text="{Binding Took}" IsVisible="{Binding !IsTiming}" />
        </StackPanel>
      </DockPanel>
      <StackPanel x:Name="Details" Spacing="8" IsVisible="{Binding IsOpen}">
        <Border x:Name="RoleTag" Classes="tag" HorizontalAlignment="Left" IsVisible="{Binding Role, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock x:Name="Role" Text="{Binding Role}" />
        </Border>
        <ItemsControl x:Name="Recent" ItemsSource="{Binding Recent}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <StackPanel x:Name="ContextGauge"
                    Orientation="Horizontal"
                    Spacing="5"
                    IsVisible="{Binding Context.IsShown}"
                    ToolTip.Tip="{Binding Context.Left, StringFormat='{}{0} of the context window left'}">
          <Panel Width="12" Height="12" VerticalAlignment="Center">
            <Ellipse Stroke="{DynamicResource HubTrackBrush}" StrokeThickness="2.2" />
            <Arc x:Name="Ring"
                 Classes.attention="{Binding Context.IsNear}"
                 StartAngle="-90"
                 SweepAngle="{Binding Context.Used, Converter={x:Static graphs:Graph.Degrees}}"
                 StrokeThickness="2.2"
                 StrokeLineCap="Round" />
          </Panel>
          <TextBlock x:Name="ContextLeft" Classes="hint" Text="{Binding Context.Left, StringFormat='{}{0} context left'}" VerticalAlignment="Center" />
        </StackPanel>
        <DockPanel>
          <TextBlock x:Name="Tokens" DockPanel.Dock="Right" Classes="hint" Margin="8,0,0,0" Text="{Binding Tokens}" IsVisible="{Binding Tokens, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ProgressBar x:Name="Share" Classes="bar" Height="3" Value="{Binding SpentShare}" VerticalAlignment="Center" IsVisible="{Binding HasCarve}" ToolTip.Tip="{Binding Spend}" />
        </DockPanel>
        <TextBlock x:Name="Compacted" Classes="hint" Text="Compacted during its last turn" IsVisible="{Binding Context.Compacted}" />
        <ContentControl x:Name="Peek" Content="{Binding Peek}" IsVisible="{Binding IsPeeking}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
          <ToggleButton x:Name="PeekToggle"
                        Classes="quiet"
                        Content="Peek"
                        IsChecked="{Binding IsPeeking, Mode=OneWay}"
                        Command="{Binding PeekCommand}"
                        ToolTip.Tip="Follow this job's conversation here" />
          <Button x:Name="OpenConversation"
                  Classes="quiet"
                  Content="Open conversation"
                  Command="{Binding OpenCommand}"
                  CommandParameter="{Binding Job}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

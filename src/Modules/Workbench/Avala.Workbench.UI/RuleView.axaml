<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Avala.Workbench.Settings"
             x:Class="Avala.Workbench.UI.RuleView"
             x:ClassModifier="internal"
             x:DataType="settings:RuleViewModel">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock Text="{Binding Origin}" Opacity="0.6" Width="90" />
    <TextBlock Text="{Binding Name}" />
    <TextBlock Text="{Binding Kind}" Opacity="0.6" />
    <TextBlock Text="{Binding Target}" FontFamily="monospace" />
    <TextBlock Text="{Binding Scope}" Opacity="0.6" />
    <TextBlock Text="{Binding Answer}" />
  </StackPanel>
</UserControl>

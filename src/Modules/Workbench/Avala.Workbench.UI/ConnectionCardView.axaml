<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Avala.Workbench.Overview"
             x:Class="Avala.Workbench.UI.ConnectionCardView"
             x:ClassModifier="internal"
             x:DataType="overview:ConnectionCardViewModel">
  <Border Padding="12" Margin="0,0,0,8" CornerRadius="8" BorderThickness="1" BorderBrush="Gray">
    <StackPanel Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
        <TextBlock Text="default" Opacity="0.6" IsVisible="{Binding IsDefault}" />
      </StackPanel>
      <TextBlock Text="{Binding Provider}" Opacity="0.7" />
      <TextBlock Text="{Binding Account}" Opacity="0.7" />
      <TextBlock Text="{Binding Cost}" />
      <ItemsControl ItemsSource="{Binding Limits}" />
      <ItemsControl ItemsSource="{Binding Agents}" />
    </StackPanel>
  </Border>
</UserControl>

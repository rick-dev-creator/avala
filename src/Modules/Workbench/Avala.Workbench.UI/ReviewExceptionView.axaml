<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:review="using:Avala.Workbench.Review"
             x:Class="Avala.Workbench.UI.ReviewExceptionView"
             x:ClassModifier="internal"
             x:DataType="review:ReviewExceptionViewModel">
  <StackPanel Spacing="2" Margin="0,4">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Detail}" FontFamily="monospace" Opacity="0.7" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>

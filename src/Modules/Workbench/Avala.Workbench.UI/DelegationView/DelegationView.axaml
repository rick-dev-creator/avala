<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Avala.Workbench.Overview"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.DelegationView"
             x:ClassModifier="internal"
             x:DataType="overview:IDelegationViewModel">
  <Design.DataContext>
    <overview:DesignDelegationViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Border#Filters">
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
    </Style>
    <Style Selector="ComboBox.filter">
      <Setter Property="MinWidth" Value="150" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border x:Name="Filters" DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="24,12">
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Border Classes="segments" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ShowActive"
                    Classes="segment"
                    Classes.selected="{Binding Scope, Converter={x:Static states:EnumIs.Any}, ConverterParameter='Active'}"
                    Content="{Binding ActiveLabel}"
                    Command="{Binding ScopeCommand}"
                    CommandParameter="{x:Static overview:DelegationScope.Active}" />
            <Button x:Name="ShowFinished"
                    Classes="segment"
                    Classes.selected="{Binding Scope, Converter={x:Static states:EnumIs.Any}, ConverterParameter='Finished'}"
                    Content="{Binding FinishedLabel}"
                    Command="{Binding ScopeCommand}"
                    CommandParameter="{x:Static overview:DelegationScope.Finished}" />
            <Button x:Name="ShowAll"
                    Classes="segment"
                    Classes.selected="{Binding Scope, Converter={x:Static states:EnumIs.Any}, ConverterParameter='All'}"
                    Content="All"
                    Command="{Binding ScopeCommand}"
                    CommandParameter="{x:Static overview:DelegationScope.All}" />
          </StackPanel>
        </Border>
        <ComboBox x:Name="Repository"
                  Classes="filter"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Repository"
                  ItemsSource="{Binding Repositories}"
                  SelectedItem="{Binding Repository, Converter={x:Static states:Kept.Selection}}" />
        <ComboBox x:Name="Connection"
                  Classes="filter"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Connection"
                  ItemsSource="{Binding Connections}"
                  SelectedItem="{Binding Connection, Converter={x:Static states:Kept.Selection}}" />
      </WrapPanel>
    </Border>
    <ContentControl x:Name="ReadProblem" DockPanel.Dock="Top" Margin="24,12,24,0" Content="{Binding ReadProblem}" IsVisible="{Binding ReadProblem.IsShown}" />
    <Panel>
      <Border x:Name="NoOrchestrators"
              Classes="empty"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding !Trees.Count}">
        <StackPanel Spacing="6" HorizontalAlignment="Center">
          <TextBlock x:Name="Empty" Classes="strong" HorizontalAlignment="Center" Text="{Binding Empty}" />
          <TextBlock Classes="caption"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="340"
                     Text="When a job hands work to sub-agents, its tree appears here with the budget carved for each child." />
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="Canvas" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !!Trees.Count}">
        <ItemsControl x:Name="Trees" Margin="24,18" ItemsSource="{Binding Trees}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="14" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:overview="using:Avala.Workbench.Overview"
             xmlns:graphs="using:Avala.Components.UI.Graphs"
             xmlns:elapsed="using:Avala.Components.UI.Elapsed"
             x:Class="Avala.Workbench.UI.SubagentView"
             x:ClassModifier="internal"
             x:DataType="overview:ISubagentViewModel"
             graphs:Graph.Depth="{Binding Place.Depth}"
             graphs:Graph.Edge="{Binding Place.Edge}">
  <Design.DataContext>
    <overview:DesignSubagentViewModel Meter="6 tool uses · 18.2k tokens" />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Border#Badge Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
  </UserControl.Styles>
  <Border x:Name="Card"
          Classes="node"
          Classes.attention="{Binding Place.IsWaiting}"
          Classes.alert="{Binding Place.IsAlert}"
          Classes.settled="{Binding Place.IsSettled}"
          Width="280"
          Padding="12,10"
          theme:Motion.Enter="Gentle">
    <StackPanel Spacing="6">
      <Button x:Name="Head"
              Classes="bare"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              AutomationProperties.Name="{Binding Name, StringFormat='Sub-agent: {0}'}"
              ToolTip.Tip="Show the tools it ran"
              Command="{Binding ToggleCommand}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <Border x:Name="Badge" Classes="tag" Width="24" Height="24" Padding="0" VerticalAlignment="Top">
            <Path Classes="icon" Width="12" Height="12" Data="{StaticResource IconSubagent}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="1">
            <TextBlock x:Name="AgentName" Classes="medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Kind" Classes="hint" Text="{Binding Place.KindText}" />
          </StackPanel>
          <ContentControl x:Name="State" Grid.Column="2" Content="{Binding Place}" VerticalAlignment="Top" />
        </Grid>
      </Button>
      <TextBlock x:Name="Activity"
                 Classes="caption secondary"
                 Text="{Binding Activity}"
                 TextWrapping="Wrap"
                 MaxLines="2"
                 TextTrimming="CharacterEllipsis"
                 IsVisible="{Binding Activity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock x:Name="Note"
                 Classes="caption note"
                 Classes.waiting="{Binding Place.IsWaiting}"
                 Classes.alert="{Binding Place.IsAlert}"
                 Text="{Binding Note}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasNote}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="Meter" Classes="hint" Text="{Binding Meter}" IsVisible="{Binding Meter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="hint" Text="·" IsVisible="{Binding IsTiming}" />
        <elapsed:ElapsedText x:Name="Elapsed" Classes="hint" Since="{Binding Since}" IsVisible="{Binding IsTiming}" />
      </StackPanel>
      <ItemsControl x:Name="Trail" ItemsSource="{Binding Trail}" IsVisible="{Binding IsOpen}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="hint" Text="{Binding}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>

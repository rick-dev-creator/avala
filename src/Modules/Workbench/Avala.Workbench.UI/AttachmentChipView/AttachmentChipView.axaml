<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             xmlns:states="using:Avala.Components.UI.States"
             x:Class="Avala.Workbench.UI.AttachmentChipView"
             x:ClassModifier="internal"
             x:DataType="conversation:IAttachmentChipViewModel"
             states:Realized.Command="{Binding ShowCommand}">
  <Design.DataContext>
    <conversation:DesignAttachmentChipViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Button.glyph Path.icon">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>
    <Style Selector="Border#Chip">
      <Setter Property="Background" Value="{DynamicResource FillSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderTagBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusButton}" />
    </Style>
    <Style Selector="TextBlock#Kind">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border#Thumb">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Background" Value="{DynamicResource FillCodeBrush}" />
    </Style>
  </UserControl.Styles>
  <Border x:Name="Chip" BorderThickness="1" Padding="4,4,6,4" Margin="0,0,6,6" ToolTip.Tip="{Binding Name}">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Border x:Name="Thumb" Width="28" Height="28" ClipToBounds="True">
        <Panel>
          <Image x:Name="Picture" Stretch="UniformToFill" Source="{Binding Picture, Converter={x:Static states:Pictures.Shown}}" IsVisible="{Binding IsImage}" />
          <TextBlock x:Name="Kind" FontSize="{DynamicResource FontSizeSection}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Kind}" IsVisible="{Binding !IsImage}" />
        </Panel>
      </Border>
      <TextBlock x:Name="AttachmentName" Classes="caption" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Name}" />
      <Button x:Name="Remove"
              Classes="glyph"
              Command="{Binding RemoveCommand}"
              IsVisible="{Binding CanRemove}"
              ToolTip.Tip="Remove"
              AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}">
        <Path Classes="icon" Width="10" Height="10" Data="{StaticResource IconCross}" />
      </Button>
    </StackPanel>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             x:Class="Avala.Workbench.UI.TurnEndView"
             x:ClassModifier="internal"
             x:DataType="conversation:TurnEndViewModel">
  <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.6">
    <TextBlock Text="{Binding Summary}" />
    <TextBlock Text="{Binding Tokens, StringFormat='{}{0} tokens'}" />
    <TextBlock Text="{Binding Cost}" />
  </StackPanel>
</UserControl>

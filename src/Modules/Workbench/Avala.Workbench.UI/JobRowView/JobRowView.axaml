<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sidebar="using:Avala.Workbench.Sidebar"
             xmlns:states="using:Avala.Components.UI.States"
             xmlns:elapsed="using:Avala.Components.UI.Elapsed"
             xmlns:theme="using:Avala.Components.UI.Theme"
             x:Class="Avala.Workbench.UI.JobRowView"
             x:ClassModifier="internal"
             x:DataType="sidebar:IJobRowViewModel"
             ClipToBounds="False"
             theme:Brackets.OnHover="True"
             Classes.child="{Binding IsChild}"
             Classes.selected="{Binding IsSelected}"
             Classes.ended="{Binding Status, Converter={x:Static states:EnumIs.Any}, ConverterParameter='Approved,Discarded'}">
  <Design.DataContext>
    <sidebar:DesignJobRowViewModel />
  </Design.DataContext>
  <UserControl.ContextFlyout>
    <MenuFlyout>
      <MenuItem x:Name="MoveTo" Header="Move to" ItemsSource="{Binding MoveTargets}" IsVisible="{Binding CanMove}">
        <MenuItem.Icon>
          <Path Classes="icon" Data="{StaticResource IconFolder}" />
        </MenuItem.Icon>
        <MenuItem.ItemContainerTheme>
          <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="sidebar:MoveTarget">
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="Command" Value="{Binding Move}" />
            <Setter Property="Icon">
              <Template>
                <Panel>
                  <Path Classes="icon" Data="{StaticResource IconFolder}" IsVisible="{Binding !IsNew}" />
                  <Path Classes="icon" Data="{StaticResource IconPlus}" IsVisible="{Binding IsNew}" />
                </Panel>
              </Template>
            </Setter>
          </ControlTheme>
        </MenuItem.ItemContainerTheme>
      </MenuItem>
      <MenuItem x:Name="Archive" Header="Archive" Command="{Binding ArchiveCommand}" IsVisible="{Binding CanArchive}">
        <MenuItem.Icon>
          <Path Classes="icon" Data="{StaticResource IconArchive}" />
        </MenuItem.Icon>
      </MenuItem>
    </MenuFlyout>
  </UserControl.ContextFlyout>
  <UserControl.Styles>
    <Style Selector="TextBlock#Title">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector=":is(UserControl).ended TextBlock#Title">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="ContentControl#Dot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector=":is(UserControl).child TextBlock#Title">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeMono}" />
    </Style>
    <Style Selector=":is(UserControl).child ContentControl#Dot">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector=":is(UserControl).child.selected TextBlock#Title">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector=":is(UserControl).ended.selected TextBlock#Title">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector=":is(UserControl).ended Border#FactSlot">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <ContainerQuery Name="JobRow" Query="max-width:240">
      <Style Selector="Border#FactSlot">
        <Setter Property="MaxWidth" Value="90" />
      </Style>
    </ContainerQuery>
    <ContainerQuery Name="JobRow" Query="max-width:180">
      <Style Selector="Border#FactSlot">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Container.Name="JobRow" Container.Sizing="Width">
    <ContentControl x:Name="Dot"
                    ClipToBounds="False"
                    Content="{Binding Dot}"
                    VerticalAlignment="Center" />
    <TextBlock x:Name="Title"
               Grid.Column="1"
               Text="{Binding Title}"
               TextTrimming="CharacterEllipsis"
               VerticalAlignment="Center" />
    <Border x:Name="FactSlot" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
      <TextBlock x:Name="Fact"
                 Classes="caption"
                 MaxWidth="104"
                 Text="{Binding Fact}"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
    </Border>
    <elapsed:ElapsedText x:Name="Elapsed"
                         Grid.Column="3"
                         Classes="caption"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         Since="{Binding Since}"
                         IsVisible="{Binding ShowsElapsed}" />
    <Path x:Name="OnPhone"
          Grid.Column="4"
          Classes="icon"
          Width="11"
          Height="11"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Stroke="{DynamicResource AccentBrush}"
          Data="{StaticResource IconPhone}"
          ToolTip.Tip="On your phone"
          AutomationProperties.Name="On your phone"
          IsVisible="{Binding IsOnPhone}" />
    <Path x:Name="Drafted"
          Grid.Column="5"
          Classes="icon"
          Width="11"
          Height="11"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Stroke="{DynamicResource TextTertiaryBrush}"
          Data="{StaticResource IconEdit}"
          ToolTip.Tip="Unsent draft"
          AutomationProperties.Name="Unsent draft"
          IsVisible="{Binding HasDraft}" />
    <Border x:Name="PendingBadge"
            Grid.Column="6"
            Classes="badge"
            MinWidth="16"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            ToolTip.Tip="Decisions waiting for you"
            IsVisible="{Binding HasPendingDecisions}">
      <TextBlock x:Name="Pending" Text="{Binding PendingDecisions}" HorizontalAlignment="Center" />
    </Border>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             x:Class="Avala.Workbench.UI.RestartView"
             x:ClassModifier="internal"
             x:DataType="conversation:IRestartViewModel"
             theme:Motion.Enter="Fade"
             Margin="0,10">
  <Design.DataContext>
    <conversation:DesignRestartViewModel />
  </Design.DataContext>
  <StackPanel Spacing="6">
    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
      <Border Classes="separator" VerticalAlignment="Center" MinWidth="24" />
      <TextBlock x:Name="Note"
                 Grid.Column="1"
                 Classes="caption"
                 MaxWidth="480"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Text="{Binding Note}" />
      <Border Grid.Column="2" Classes="separator" VerticalAlignment="Center" MinWidth="24" />
    </Grid>
    <TextBlock x:Name="Lost"
               Classes="caption attention"
               MaxWidth="480"
               HorizontalAlignment="Center"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Text="{Binding Lost}"
               IsVisible="{Binding HasLost}" />
  </StackPanel>
</UserControl>

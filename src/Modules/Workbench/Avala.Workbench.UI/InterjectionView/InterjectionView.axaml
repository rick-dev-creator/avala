<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:states="using:Avala.Components.UI.States"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             x:Class="Avala.Workbench.UI.InterjectionView"
             x:ClassModifier="internal"
             x:DataType="conversation:IInterjectionViewModel"
             theme:Motion.Enter="Arrive"
             Margin="0,10"
             Classes.found="{Binding Found, Converter={x:Static states:EnumIs.Any}, ConverterParameter='Match,Current'}"
             Classes.current="{Binding Found, Converter={x:Static states:EnumIs.Any}, ConverterParameter='Current'}">
  <Design.DataContext>
    <conversation:DesignInterjectionViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Border#Bubble">
      <Setter Property="Background" Value="{DynamicResource FillBubbleBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusBubble}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="SelectableTextBlock#Text">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeReading}" />
      <Setter Property="LineHeight" Value="23" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="4">
    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
      <Path x:Name="Device" Classes="icon" Width="11" Height="11" Data="{StaticResource IconPhone}" VerticalAlignment="Center" IsVisible="{Binding IsFromDevice}" />
      <TextBlock x:Name="Note" Classes="caption" Text="{Binding Note}" />
    </StackPanel>
    <Border x:Name="Bubble" MaxWidth="560" Padding="14,10">
      <SelectableTextBlock x:Name="Text" Text="{Binding Text}" />
    </Border>
    <ItemsControl x:Name="Attachments" HorizontalAlignment="Right" ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel HorizontalAlignment="Right" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </StackPanel>
</UserControl>

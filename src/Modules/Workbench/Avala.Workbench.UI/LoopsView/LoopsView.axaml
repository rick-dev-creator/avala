<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:triggers="using:Avala.Workbench.Triggers"
             x:Class="Avala.Workbench.UI.LoopsView"
             x:ClassModifier="internal"
             x:DataType="triggers:ILoopsViewModel">
  <Design.DataContext>
    <triggers:DesignLoopsViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="ItemsControl.rows > ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="ItemsControl.rows > ContentPresenter:nth-child(1)">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="8">
    <TextBlock x:Name="LoopsTitle" Classes="section" Text="{Binding Loops.Count, StringFormat='Loops · {0}'}" />
    <TextBlock x:Name="LoopError" Classes="caption failure" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Border x:Name="NoLoops" Classes="empty" Padding="18,16" IsVisible="{Binding !Loops.Count}">
      <TextBlock TextWrapping="Wrap" Text="No loop has run on this computer. A trigger whose target is loop starts one when it fires." />
    </Border>
    <Border Classes="grouped" IsVisible="{Binding !!Loops.Count}">
      <ItemsControl x:Name="Loops" Classes="rows" Margin="16,0" ItemsSource="{Binding Loops}" />
    </Border>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:choice="using:Avala.Workbench.RepositoryChoice"
             x:Class="Avala.Workbench.UI.CloneRepositoryView"
             x:ClassModifier="internal"
             x:DataType="choice:ICloneRepositoryViewModel">
  <Design.DataContext>
    <choice:DesignCloneRepositoryViewModel />
  </Design.DataContext>
  <Border Classes="quiet" Padding="12,10">
    <StackPanel Spacing="8">
      <TextBlock Classes="section" Text="Clone a repository" />
      <TextBox x:Name="CloneUrl"
               Text="{Binding Url}"
               IsEnabled="{Binding !IsCloning}"
               PlaceholderText="https://github.com/owner/name.git or git@github.com:owner/name.git"
               AutomationProperties.Name="Address of the repository to clone">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding CloneCommand}" />
          <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBlock x:Name="CloneParent"
                   Classes="caption"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{Binding Parent, StringFormat='Into {0}'}" />
        <Button x:Name="ChooseCloneParent"
                Grid.Column="1"
                Classes="ghost"
                Content="Choose…"
                ToolTip.Tip="Pick the folder the clone goes in"
                IsEnabled="{Binding !IsCloning}"
                Command="{Binding ChooseParentCommand}" />
      </Grid>
      <TextBox x:Name="CloneName"
               Text="{Binding Name}"
               IsEnabled="{Binding !IsCloning}"
               PlaceholderText="Name of the folder"
               AutomationProperties.Name="Name of the folder of the clone" />
      <StackPanel x:Name="CloneProgress" Spacing="6" IsVisible="{Binding IsCloning}">
        <ProgressBar IsIndeterminate="True" />
        <TextBlock x:Name="CloneStatus" Classes="caption" TextWrapping="Wrap" Text="{Binding Status}" />
      </StackPanel>
      <TextBlock x:Name="CloneError"
                 Classes="caption failure"
                 TextWrapping="Wrap"
                 Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="Clone" Classes="primary" Content="Clone" Command="{Binding CloneCommand}" />
        <Button x:Name="CancelClone" Content="Cancel" Command="{Binding CancelCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

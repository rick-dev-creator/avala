<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:usage="using:Avala.Workbench.Usage"
             x:Class="Avala.Workbench.UI.UsageWindowView"
             x:ClassModifier="internal"
             x:DataType="usage:UsageWindowViewModel">
  <StackPanel Spacing="2" Margin="0,0,0,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Cost}" />
      <TextBlock Text="{Binding Tokens}" Opacity="0.6" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Text="{Binding Input, StringFormat='input {0:N0}'}" FontSize="12" />
      <TextBlock Text="{Binding Output, StringFormat='output {0:N0}'}" FontSize="12" />
      <TextBlock Text="{Binding CacheRead, StringFormat='cache read {0:N0}'}" FontSize="12" />
      <TextBlock Text="{Binding CacheWrite, StringFormat='cache write {0:N0}'}" FontSize="12" />
      <TextBlock Text="{Binding Reasoning, StringFormat='reasoning {0:N0}'}" FontSize="12" />
    </StackPanel>
    <TextBlock Text="{Binding Turns}" Opacity="0.6" FontSize="12" />
    <TextBlock Text="{Binding Unpriced}" Opacity="0.6" FontSize="12" />
  </StackPanel>
</UserControl>

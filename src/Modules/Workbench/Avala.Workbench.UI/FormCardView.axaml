<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="using:Avala.Workbench.Cards"
             x:Class="Avala.Workbench.UI.FormCardView"
             x:ClassModifier="internal"
             x:DataType="cards:FormCardViewModel">
  <Border BorderThickness="1" BorderBrush="#66F5A623" CornerRadius="8" Padding="12">
    <StackPanel Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Verdict}" Opacity="0.6" />
      </StackPanel>
      <TextBlock Text="{Binding Context}" TextWrapping="Wrap" />
      <StackPanel Spacing="6" IsVisible="{Binding AwaitsYou}">
        <ItemsControl ItemsSource="{Binding Fields}" />
        <TextBox Text="{Binding Note}" PlaceholderText="A note for the agent if you decline" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Answer" Command="{Binding SubmitCommand}" />
          <Button Content="Decline" Command="{Binding DeclineCommand}" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="{Binding Error}" Foreground="#E5484D" />
    </StackPanel>
  </Border>
</UserControl>

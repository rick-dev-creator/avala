<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:theme="using:Avala.Components.UI.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:privacy="using:Avala.Components.UI.Privacy"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             xmlns:states="using:Avala.Components.UI.States"
             xmlns:copying="using:Avala.Components.UI.Copying"
             x:Class="Avala.Workbench.UI.ToolView"
             x:ClassModifier="internal"
             x:DataType="conversation:IToolViewModel"
             theme:Motion.Enter="Arrive"
             Classes.running="{Binding IsRunning}"
             Classes.failed="{Binding Failed}"
             Margin="0,1">
  <Design.DataContext>
    <conversation:DesignToolViewModel />
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="Path#Icon">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>
    <Style Selector="TextBlock#Title">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock#Title.code">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCode}" />
    </Style>
    <Style Selector="SelectableTextBlock.output">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeOutput}" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button#Toggle.previews Grid">
      <Setter Property="Margin" Value="0,0,30,0" />
    </Style>
    <Style Selector="Button#OpenPreview">
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="Button#OpenPreview:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button#CopyOutput">
      <Setter Property="Margin" Value="0,-4,-4,0" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="Border#Details:pointerover Button#CopyOutput, Button#CopyOutput:copied">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button#CopyOutput:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="2">
    <Panel>
      <Button x:Name="Toggle"
              Classes="line"
              Classes.previews="{Binding ShowsPreview}"
              Command="{Binding ToggleCommand}"
              AutomationProperties.Name="{Binding Title}">
        <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="10">
          <Path x:Name="Icon"
                Classes="icon"
                VerticalAlignment="Center"
                Data="{Binding Kind, Converter={x:Static states:ThemeIcon.Named}, ConverterParameter=Icon}"
                IsVisible="{Binding !IsRunning}" />
          <Arc x:Name="Spinner"
               Width="12"
               Height="12"
               StartAngle="0"
               SweepAngle="270"
               Stroke="{DynamicResource TextSecondaryBrush}"
               StrokeThickness="1.5"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               IsVisible="{Binding IsRunning}"
               theme:Motion.Loop="Spin"
               theme:Motion.When="{Binding IsRunning}" />
          <TextBlock x:Name="Title"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     Classes.code="{Binding IsCode}"
                     privacy:PersonalDetails.Scrubbed="{Binding Title}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="Outcome"
                     Grid.Column="2"
                     Classes="caption"
                     Classes.failure="{Binding Failed}"
                     VerticalAlignment="Center"
                     Text="{Binding Outcome}"
                     IsVisible="{Binding ShowsOutcome}" />
        </Grid>
      </Button>
      <Button x:Name="OpenPreview"
              Classes="glyph mini"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Command="{Binding Preview.OpenCommand}"
              IsVisible="{Binding ShowsPreview}"
              ToolTip.Tip="{Binding Preview.Hint}"
              AutomationProperties.Name="{Binding Preview.Hint}">
        <Path Classes="icon" Data="{Binding Preview.Kind, Converter={x:Static states:ThemeIcon.Named}, ConverterParameter=IconPreview}" />
      </Button>
      <Popup x:Name="ChangesPopover"
             IsOpen="{Binding Changes.IsOpen}"
             PlacementTarget="{Binding #Toggle}"
             Placement="BottomEdgeAlignedLeft"
             VerticalOffset="4"
             ShouldUseOverlayLayer="True"
             IsLightDismissEnabled="True"
             WindowManagerAddShadowHint="False">
        <ContentControl x:Name="Changes" theme:Motion.Enter="Pop" Content="{Binding Changes}" />
      </Popup>
    </Panel>
    <ContentControl x:Name="Preview" Content="{Binding Preview}" IsVisible="{Binding ShowsPreview}" />
    <Border x:Name="Details"
            theme:Motion.Enter="Fold"
            theme:Motion.When="{Binding IsExpanded}"
            Background="{DynamicResource FillQuietBrush}"
            CornerRadius="{DynamicResource RadiusButton}"
            Padding="34,8,10,10"
            Margin="0,0,0,4"
            IsVisible="{Binding IsExpanded}">
      <Panel>
        <StackPanel Spacing="6" Margin="0,0,22,0">
          <SelectableTextBlock x:Name="Input"
                               Classes="output"
                               Text="{Binding Input}"
                               IsVisible="{Binding Input, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <SelectableTextBlock x:Name="Output"
                               Classes="output"
                               Text="{Binding Output}"
                               IsVisible="{Binding Output, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock x:Name="NoOutput"
                     Classes="caption"
                     Text="No output."
                     IsVisible="{Binding Output, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
        </StackPanel>
        <copying:CopyButton x:Name="CopyOutput"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding CopyCommand}"
                            IsCopied="{Binding IsCopied}"
                            IsVisible="{Binding Output, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            ToolTip.Tip="Copy"
                            AutomationProperties.Name="Copy the output" />
      </Panel>
    </Border>
  </StackPanel>
</UserControl>

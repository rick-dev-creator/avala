<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversation="using:Avala.Workbench.Conversation"
             x:Class="Avala.Workbench.UI.ConversationView"
             x:ClassModifier="internal"
             x:DataType="conversation:IConversationViewModel">
  <Design.DataContext>
    <conversation:DesignConversationViewModel />
  </Design.DataContext>
  <DockPanel>
    <ContentControl x:Name="Composer"
                    DockPanel.Dock="Bottom"
                    Margin="28,0,28,20"
                    MaxWidth="{DynamicResource ReadingWidth}"
                    Content="{Binding Composer}" />
    <Panel>
      <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Entries"
                      ItemsSource="{Binding Entries}"
                      Margin="28,18,28,14"
                      MaxWidth="{DynamicResource ReadingWidth}" />
      </ScrollViewer>
      <StackPanel x:Name="Quiet"
                  Spacing="8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding !Entries.Count}">
        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
          <Ellipse Classes="think-dot" Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" />
          <Ellipse Classes="think-dot second" Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" />
          <Ellipse Classes="think-dot third" Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <TextBlock Classes="caption" Text="Nothing said yet. The conversation appears here as the agent works." />
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>

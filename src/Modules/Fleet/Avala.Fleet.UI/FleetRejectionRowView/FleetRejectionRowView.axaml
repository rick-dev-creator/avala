<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Avala.Fleet.Settings"
             x:Class="Avala.Fleet.UI.FleetRejectionRowView"
             x:ClassModifier="internal"
             x:DataType="settings:IFleetRejectionRowViewModel">
  <Design.DataContext>
    <settings:DesignFleetRejectionRowViewModel />
  </Design.DataContext>
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock x:Name="WhenText" Classes="caption" Text="{Binding When}" />
    <TextBlock x:Name="KindText" Classes="caption mono" Text="{Binding Kind}" />
    <TextBlock x:Name="ReasonText" Classes="caption" Text="{Binding Reason}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>

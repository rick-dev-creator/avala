<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tasks="using:Avala.Tasks"
             x:Class="Avala.Tasks.UI.TasksView"
             x:ClassModifier="internal"
             x:DataType="tasks:TasksViewModel">
  <DockPanel Margin="32">
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding Title}"
               FontSize="24"
               FontWeight="SemiBold"
               Margin="0,0,0,16" />
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBox Text="{Binding Draft}" />
      <Button Grid.Column="1"
              Content="Add"
              Command="{Binding AddCommand}"
              Margin="8,0,0,0" />
    </Grid>
    <ListBox ItemsSource="{Binding Items}" Background="Transparent" />
  </DockPanel>
</UserControl>

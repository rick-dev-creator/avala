<Window xmlns="https://github.com/avaloniaui"
        xmlns:theme="using:Avala.Components.UI.Theme"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Avala.Shell"
        xmlns:sdk="using:Avala.Sdk"
        xmlns:states="using:Avala.Components.UI.States"
        xmlns:ui="using:Avala.Components.UI"
        xmlns:copying="using:Avala.Components.UI.Copying"
        x:Class="Avala.Host.ShellView"
        x:ClassModifier="internal"
        x:DataType="shell:IShellViewModel"
        Title="Avala"
        Icon="avares://Avala.Host/Assets/avala.ico"
        Width="1440"
        Height="900"
        MinWidth="360"
        MinHeight="480"
        Background="Transparent"
        TransparencyLevelHint="Mica, AcrylicBlur, None">
  <Window.KeyBindings>
    <KeyBinding Gesture="{x:Static copying:Hotkeys.Sidebar}" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="{x:Static copying:Hotkeys.SidebarBackslash}" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="{x:Static copying:Hotkeys.FocusMode}" Command="{Binding ToggleFocusCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
  </Window.KeyBindings>
  <Design.DataContext>
    <shell:DesignShellViewModel />
  </Design.DataContext>
  <Window.Styles>
    <Style Selector="ListBox#PageNavigation ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontFamily" Value="{DynamicResource HudFont}" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ListBox#PageNavigation ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox#PageNavigation ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox#PageNavigation ListBoxItem Path.icon">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>
    <Style Selector="Panel#SidebarPane">
      <Setter Property="Width" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    </Style>
    <Style Selector="Panel#SidebarPane.shown" x:DataType="shell:IShellViewModel">
      <Setter Property="Width" Value="{Binding SidebarWidth}" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
    </Style>
    <Style Selector="Panel#SidebarPane.drawer">
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="ZIndex" Value="2" />
    </Style>
    <Style Selector="Grid#Body.above">
      <Setter Property="ZIndex" Value="2" />
    </Style>
    <Style Selector="Panel#InspectorPane">
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="Panel#InspectorBody">
      <Setter Property="Width" Value="{DynamicResource InspectorWidth}" />
    </Style>
    <Style Selector="Border#InspectorSpace">
      <Setter Property="Width" Value="0" />
    </Style>
    <Style Selector="Border#InspectorSpace.docked">
      <Setter Property="Width" Value="{DynamicResource InspectorWidth}" />
    </Style>
    <Style Selector="Panel#InspectorPane">
      <Setter Property="Width" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    </Style>
    <Style Selector="Panel#InspectorPane.shown">
      <Setter Property="Width" Value="{DynamicResource InspectorWidth}" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
    </Style>
    <Style Selector="Panel#InspectorPane.floating Panel#InspectorBody" x:DataType="shell:IShellViewModel">
      <Setter Property="Width" Value="{Binding WindowWidth}" />
    </Style>
    <Style Selector="Panel#InspectorPane.shown.floating" x:DataType="shell:IShellViewModel">
      <Setter Property="Width" Value="{Binding WindowWidth}" />
    </Style>
    <Style Selector="Panel#SidebarPane[(theme|Motion.IsReduced)=False]:not(.resizing), Panel#InspectorPane[(theme|Motion.IsReduced)=False]:not(.floating), Border#InspectorSpace[(theme|Motion.IsReduced)=False]">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="0.22,1,0.36,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.grip">
      <Setter Property="Width" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="Border#FocusHint">
      <Setter Property="Background" Value="{DynamicResource SurfaceFloatBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeFloatBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowFloat}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
      <Setter Property="Padding" Value="{DynamicResource PaddingHint}" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border#FocusHint.shown[(theme|Motion.IsReduced)=False]">
      <Style.Animations>
        <Animation Duration="0:0:2.4">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="8%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="70%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border#FocusHint.shown[(theme|Motion.IsReduced)=True]">
      <Style.Animations>
        <Animation Duration="0:0:2.4">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="99%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="StackPanel#WindowControls Path.icon">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>
    <Style Selector="ItemsControl#InspectorRegion ui|Fold:expanded /template/ Border#PART_Frame">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style Selector="ItemsControl#InspectorRegion ui|Fold /template/ ContentPresenter#PART_Header">
      <Setter Property="FontFamily" Value="{DynamicResource HudFont}" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
  </Window.Styles>
  <Panel states:Widths.Report="{Binding FitCommand}">
    <Grid x:Name="Body" ColumnDefinitions="Auto,*,Auto" Classes.above="{Binding IsDrawerOpen}">
      <Button x:Name="DrawerScrim"
              Grid.ColumnSpan="3"
              Classes="scrim"
              ZIndex="1"
              IsVisible="{Binding IsDrawerOpen}"
              Command="{Binding ToggleSidebarCommand}"
              AutomationProperties.Name="Close the sidebar" />
      <Panel x:Name="SidebarPane"
             ClipToBounds="True"
             Classes.shown="{Binding IsSidebarShown}"
             Classes.drawer="{Binding IsNarrow}"
             MaxWidth="{Binding SidebarMaxWidth}"
             IsVisible="{Binding HasSidebar}"
             states:Resizer.Command="{Binding ResizeSidebarCommand}"
             states:Resizer.Committed="{Binding RememberSidebarCommand}"
             states:Resizer.Reset="{Binding ResetSidebarWidthCommand}">
        <Panel x:Name="SidebarBody" Width="{Binding SidebarWidth}" HorizontalAlignment="Right" Background="Transparent">
          <Border Classes="panel" IsHitTestVisible="False" />
          <DockPanel>
            <Grid x:Name="Titlebar"
                  DockPanel.Dock="Top"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="54,20,10,10">
              <Image x:Name="BrandMark"
                     Width="22"
                     Height="22"
                     VerticalAlignment="Center"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     Source="avares://Avala.Components.UI/Assets/Ava/mark.png" />
              <TextBlock Grid.Column="1"
                         Margin="8,0,0,0"
                         Text="AVALA"
                         Classes="hud brand"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <ItemsControl x:Name="ToolbarRegion"
                            Grid.Column="2"
                            ItemsSource="{Binding Toolbar.Items}"
                            VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Grid>
            <StackPanel x:Name="Footer" DockPanel.Dock="Bottom">
              <Border Classes="separator" />
              <StackPanel Margin="10" Spacing="2">
                <ItemsControl x:Name="SidebarFooterRegion"
                              ItemsSource="{Binding SidebarFooter.Items}"
                              IsVisible="{Binding SidebarFooter.HasItems}"
                              Margin="0,0,0,8">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ListBox x:Name="PageNavigation"
                         theme:Cursor.Slides="True"
                         IsVisible="{Binding HasNavigation}"
                         ItemsSource="{Binding NavigationPages}"
                         SelectedItem="{Binding SelectedPage, Converter={x:Static states:Kept.Selection}}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="sdk:IPage">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="icon"
                              Data="{Binding Icon, Converter={x:Static states:ThemeIcon.Named}}"
                              IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </StackPanel>
            <ScrollViewer x:Name="SidebarScroller">
              <ItemsControl x:Name="SidebarRegion" Margin="10,4,10,10" ItemsSource="{Binding Sidebar.Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
          <Border Classes="edge" HorizontalAlignment="Right" />
          <Border x:Name="SidebarGrip"
                  Classes="grip"
                  HorizontalAlignment="Right"
                  ToolTip.Tip="Drag to resize, double-click to reset"
                  AutomationProperties.Name="Resize sidebar" />
        </Panel>
      </Panel>

      <Border x:Name="ContentPane"
              Grid.Column="1"
              Classes="window"
              IsEnabled="{Binding !IsContentCovered}"
              theme:Reading.Follows="True"
              theme:Chrome.IsBare="{Binding !IsSidebarShown}"
              theme:Chrome.IsFocusMode="{Binding IsFocused}">
        <Panel>
          <theme:GridBackdrop x:Name="Backdrop" />
          <ui:Stage x:Name="ContentRegion" Keeps="16" Content="{Binding SelectedPage}" />
          <Border x:Name="EmptyContent"
                  Classes="empty"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding SelectedPage, Converter={x:Static ObjectConverters.IsNull}}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="Nothing to show yet" Classes="strong" HorizontalAlignment="Center" />
              <TextBlock Classes="caption" Text="Plugins add their pages to this window." HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Panel>
      </Border>

      <Border x:Name="InspectorSpace" Grid.Column="2" Classes.docked="{Binding IsInspectorDocked}" />
    </Grid>
    <Panel x:Name="InspectorPane"
           HorizontalAlignment="Right"
           ClipToBounds="True"
           Classes.shown="{Binding IsInspectorShown}"
           Classes.floating="{Binding IsInspectorFloating}">
      <Panel x:Name="InspectorBody" HorizontalAlignment="Left">
        <Border Classes="panel" IsHitTestVisible="False" />
        <Border Classes="edge" HorizontalAlignment="Left" />
        <ScrollViewer>
          <StackPanel Margin="14,16" Spacing="6">
            <DockPanel Margin="10,2,4,8">
              <Button x:Name="CloseInspector"
                      DockPanel.Dock="Right"
                      Classes="glyph"
                      IsVisible="{Binding IsInspectorFloating}"
                      Command="{Binding DismissInspectorCommand}"
                      AutomationProperties.Name="Close the inspector">
                <Path Classes="icon" Data="{StaticResource IconCross}" />
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="section" Text="Inspector" VerticalAlignment="Center" />
                <TextBlock Classes="jp" Text="状態" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="InspectorRegion" ItemsSource="{Binding Inspector.Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Panel>
    <StackPanel x:Name="WindowControls"
                IsVisible="{Binding !IsFocused}"
                Orientation="Horizontal"
                Spacing="2"
                Margin="12,16,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
      <Button x:Name="ToggleSidebar"
              Classes="glyph"
              Command="{Binding ToggleSidebarCommand}"
              IsVisible="{Binding HasSidebar}"
              ToolTip.Tip="{Binding Source={x:Static copying:Hotkeys.SidebarLabel}, StringFormat='Sidebar ({0})'}"
              AutomationProperties.Name="Toggle sidebar">
        <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconSidebar}" />
      </Button>
    </StackPanel>
    <Border x:Name="FocusHint"
            Classes.shown="{Binding IsFocused}"
            IsVisible="{Binding IsFocused}"
            IsHitTestVisible="False"
            Margin="0,14,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
      <TextBlock Classes="caption" Text="{Binding Source={x:Static copying:Hotkeys.FocusModeLabel}, StringFormat='Focus · {0} to exit'}" />
    </Border>
    <ItemsControl x:Name="OverlayRegion" ItemsSource="{Binding Overlay.Items}" IsVisible="{Binding Overlay.HasItems}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Panel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </Panel>
</Window>

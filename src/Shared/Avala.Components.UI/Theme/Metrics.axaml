<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <CornerRadius x:Key="RadiusControl">6</CornerRadius>
  <CornerRadius x:Key="RadiusButton">8</CornerRadius>
  <CornerRadius x:Key="RadiusRow">10</CornerRadius>
  <CornerRadius x:Key="RadiusCard">14</CornerRadius>
  <CornerRadius x:Key="RadiusSheet">20</CornerRadius>
  <CornerRadius x:Key="RadiusDevicePhone">58</CornerRadius>
  <CornerRadius x:Key="RadiusDevicePhoneScreen">46</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceAndroid">42</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceAndroidScreen">32</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceTablet">34</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceTabletScreen">16</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceClassic">44</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceFold">40</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceFoldScreen">28</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceHome">23</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceSpeaker">2.5</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceIsland">15</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceLens">7</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceLensSmall">3.5</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceButtonRight">0,2,2,0</CornerRadius>
  <CornerRadius x:Key="RadiusDeviceButtonLeft">2,0,0,2</CornerRadius>
  <CornerRadius x:Key="RadiusPill">99</CornerRadius>
  <CornerRadius x:Key="RadiusItem">12</CornerRadius>
  <CornerRadius x:Key="RadiusPopover">16</CornerRadius>
  <CornerRadius x:Key="RadiusTag">4</CornerRadius>
  <CornerRadius x:Key="RadiusChoice">9</CornerRadius>
  <CornerRadius x:Key="RadiusBlock">12</CornerRadius>
  <CornerRadius x:Key="RadiusBubble">14,14,4,14</CornerRadius>

  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">24</x:Double>
  <x:Double x:Key="Space6">32</x:Double>
  <x:Double x:Key="Space7">48</x:Double>

  <Thickness x:Key="PaddingRow">10,7</Thickness>
  <Thickness x:Key="PaddingCard">16</Thickness>
  <Thickness x:Key="PaddingPill">9,3</Thickness>
  <Thickness x:Key="PaddingHint">12,5</Thickness>
  <Thickness x:Key="PaddingTip">10,7</Thickness>
  <Thickness x:Key="PaddingMenuItem">8,5</Thickness>
  <Thickness x:Key="MarginMenuItem">4,0</Thickness>
  <Thickness x:Key="MarginMenuHeader">0,0,16,0</Thickness>
  <Thickness x:Key="MarginMenuSeparator">12,4</Thickness>

  <x:Double x:Key="SidebarWidth">260</x:Double>
  <x:Double x:Key="ListPaneWidth">220</x:Double>
  <x:Double x:Key="InspectorWidth">320</x:Double>
  <x:Double x:Key="ReadingWidth">720</x:Double>
  <x:Double x:Key="MenuMinWidth">200</x:Double>
  <x:Double x:Key="MenuMaxWidth">320</x:Double>
  <x:Double x:Key="TipWidth">300</x:Double>
  <x:Double x:Key="TipMaxWidth">360</x:Double>
  <Thickness x:Key="ChromeLeading">0</Thickness>
  <Thickness x:Key="ChromeClearance">0</Thickness>
  <Thickness x:Key="PageHeaderPadding">24,12</Thickness>

  <x:Double x:Key="FontSizeDisplay">26</x:Double>
  <x:Double x:Key="FontSizeTitle">22</x:Double>
  <x:Double x:Key="FontSizeHeading">15</x:Double>
  <x:Double x:Key="FontSizeReading">14</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeMono">12.5</x:Double>
  <x:Double x:Key="FontSizeCaption">12</x:Double>
  <x:Double x:Key="FontSizeHint">11.5</x:Double>
  <x:Double x:Key="FontSizeSection">11</x:Double>
  <x:Double x:Key="FontSizeTag">10</x:Double>
  <x:Double x:Key="FontSizeCode">12</x:Double>
  <x:Double x:Key="FontSizeOutput">11.5</x:Double>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <BoxShadows x:Key="ShadowHairline">0 0 0 1 #0FFFFFFF</BoxShadows>
      <BoxShadows x:Key="ShadowCard">inset 0 0.5 0 0 #0FFFFFFF, 0 1 2 0 #66000000, 0 8 20 -8 #80000000</BoxShadows>
      <BoxShadows x:Key="ShadowFloat">inset 0 0.5 0 0 #14FFFFFF, 0 2 8 0 #4D000000, 0 24 48 -12 #A6000000</BoxShadows>
      <BoxShadows x:Key="ShadowPopover">inset 0 0.5 0 0 #14FFFFFF, 0 2 10 0 #59000000, 0 32 64 -16 #BF000000</BoxShadows>
      <BoxShadows x:Key="ShadowSheet">inset 0 0.5 0 0 #14FFFFFF, 0 4 16 0 #59000000, 0 40 80 -20 #BF000000</BoxShadows>
      <BoxShadows x:Key="ShadowRaised">inset 0 0.5 0 0 #0FFFFFFF, 0 18 36 -16 #A6000000</BoxShadows>
      <BoxShadows x:Key="ShadowComposer">inset 0 0.5 0 0 #14FFFFFF, 0 20 40 -16 #99000000</BoxShadows>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <BoxShadows x:Key="ShadowHairline">0 0 0 1 #12000000</BoxShadows>
      <BoxShadows x:Key="ShadowCard">0 0 0 1 #0A000000, 0 1 2 0 #0F000000, 0 8 20 -8 #1F000000</BoxShadows>
      <BoxShadows x:Key="ShadowFloat">0 0 0 1 #0A000000, 0 2 8 0 #12000000, 0 24 48 -12 #2E000000</BoxShadows>
      <BoxShadows x:Key="ShadowPopover">0 0 0 1 #0F000000, 0 2 10 0 #14000000, 0 32 64 -16 #38000000</BoxShadows>
      <BoxShadows x:Key="ShadowSheet">0 0 0 1 #0F000000, 0 4 16 0 #14000000, 0 40 80 -20 #3D000000</BoxShadows>
      <BoxShadows x:Key="ShadowRaised">0 0 0 1 #0A000000, 0 18 36 -16 #2E000000</BoxShadows>
      <BoxShadows x:Key="ShadowComposer">0 0 0 1 #0F000000, 0 20 40 -16 #2E000000</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:Avala.Components.UI"
                    xmlns:theme="using:Avala.Components.UI.Theme">
  <ControlTheme x:Key="{x:Type ui:Portrait}" TargetType="ui:Portrait">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="64" />
    <Setter Property="Background" Value="{DynamicResource FillSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Frame"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                theme:Chamfer.Size="{StaticResource ChamferControl}">
          <Viewbox Stretch="Uniform">
            <Panel Name="Figure" Width="52" Height="64" theme:Motion.Loop="Breathe">
              <Canvas Name="Silhouette" Width="52" Height="64">
                <Path Name="Hair" Fill="{TemplateBinding Foreground}" Data="M12,30 C10,14 18,8 26,8 C34,8 42,14 40,30 L41,40 C38,42 35,41 34,38 L18,38 C17,41 14,42 11,40 Z" />
                <Path Name="Neck" Fill="{TemplateBinding Foreground}" Opacity="0.7" Data="M22,36 L30,36 L30,47 L22,47 Z" />
                <Path Name="Shoulders" Fill="{TemplateBinding Foreground}" Data="M5,64 C6,53 14,48 22,46 L30,46 C38,48 46,53 47,64 Z" />
                <Path Name="Face" Fill="{DynamicResource SurfacePanelBrush}" Data="M17,24 C17,16 21,13 26,13 C31,13 35,16 35,24 C35,31 31,37 26,37 C21,37 17,31 17,24 Z" />
                <Path Name="Bangs" Fill="{TemplateBinding Foreground}" Data="M16,23 C16,14 21,10 26,10 C31,10 36,14 36,23 C34,19 31,16 29,15 C28,18 25,20 21,19 C19,20 17,21 16,23 Z" />
                <Path Name="Choker" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.4" Data="M22,42 L30,42" />
                <Path Name="Eyes" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.4" StrokeLineCap="Round" Data="M20.5,26 L24,26 M28,26 L31.5,26" />
                <Path Name="Mouth" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" StrokeLineCap="Round" Data="M24.5,32 L27.5,32" />
              </Canvas>
            </Panel>
          </Viewbox>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.small">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="27" />
    </Style>
    <Style Selector="^:asking">
      <Setter Property="BorderBrush" Value="{DynamicResource AttentionBrush}" />
    </Style>
    <Style Selector="^:asking /template/ Path#Eyes">
      <Setter Property="Data" Value="M22.2,24.8 L22.2,26.6 M29.8,24.8 L29.8,26.6 M28,22.6 L31.6,21.6" />
    </Style>
    <Style Selector="^:asking /template/ Path#Mouth">
      <Setter Property="Data" Value="M25.2,31.8 Q26,33.4 26.8,31.8 Q26,30.4 25.2,31.8" />
    </Style>
    <Style Selector="^:worried">
      <Setter Property="BorderBrush" Value="{DynamicResource FailureBrush}" />
    </Style>
    <Style Selector="^:worried /template/ Path#Eyes">
      <Setter Property="Data" Value="M20.5,25.2 L24,26.4 M28,26.4 L31.5,25.2" />
    </Style>
    <Style Selector="^:worried /template/ Path#Mouth">
      <Setter Property="Data" Value="M24,32.8 Q26,31.2 28,32.8" />
    </Style>
    <Style Selector="^:pleased">
      <Setter Property="BorderBrush" Value="{DynamicResource VerifiedBrush}" />
    </Style>
    <Style Selector="^:pleased /template/ Path#Eyes">
      <Setter Property="Data" Value="M20.5,26.4 Q22.2,24.2 24,26.4 M28,26.4 Q29.7,24.2 31.5,26.4" />
    </Style>
    <Style Selector="^:pleased /template/ Path#Mouth">
      <Setter Property="Data" Value="M23.5,31.2 Q26,33.8 28.5,31.2" />
    </Style>
  </ControlTheme>
</ResourceDictionary>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:Avala.Components.UI"
                    xmlns:theme="using:Avala.Components.UI.Theme">
  <ControlTheme x:Key="FoldHeader" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusRow}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Back"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ui:Fold}" TargetType="ui:Fold">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusRow}" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Frame"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
          </Border.Transitions>
          <StackPanel>
            <ToggleButton Name="PART_Toggle"
                          Theme="{StaticResource FoldHeader}"
                          Padding="{TemplateBinding Padding}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Viewbox Name="PART_Lead" Classes="chevron" Margin="0,0,8,0">
                  <Path Classes="chevron" />
                </Viewbox>
                <ContentPresenter Name="PART_Header"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}" />
                <TextBlock Name="PART_Fact"
                           Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{TemplateBinding Fact}"
                           IsVisible="{TemplateBinding Fact, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Viewbox Name="PART_Trail"
                         Grid.Column="3"
                         Classes="chevron"
                         Margin="10,0,0,0"
                         IsVisible="False">
                  <Path Classes="chevron" />
                </Viewbox>
              </Grid>
            </ToggleButton>
            <ContentPresenter Name="PART_Body"
                              RenderTransformOrigin="50%,0%"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding IsExpanded}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Viewbox.chevron">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^ /template/ Path.chevron">
      <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:expanded /template/ Path.chevron">
      <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
    </Style>
    <Style Selector="^:expanded[(theme|Motion.IsReduced)=False] /template/ Path.chevron">
      <Style.Animations>
        <Animation Duration="0:0:0.24" Easing="0.34,1.4,0.64,1" FillMode="Both">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="-90" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:expanded">
      <Setter Property="Background" Value="{DynamicResource FillQuietBrush}" />
    </Style>
    <Style Selector="^:expanded[(theme|Motion.IsReduced)=False] /template/ ContentPresenter#PART_Body">
      <Style.Animations>
        <Animation Duration="0:0:0.22" Easing="0.34,1.4,0.64,1" FillMode="Both">
          <KeyFrame Cue="0%">
            <Setter Property="ScaleTransform.ScaleY" Value="1.4" />
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^.trailing /template/ Viewbox#PART_Lead">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.trailing /template/ Viewbox#PART_Trail">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.attention /template/ TextBlock#PART_Fact">
      <Setter Property="Foreground" Value="{DynamicResource AttentionBrush}" />
    </Style>
    <Style Selector="^.code /template/ TextBlock#PART_Fact">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="^.failure /template/ TextBlock#PART_Fact">
      <Setter Property="Foreground" Value="{DynamicResource FailureBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>

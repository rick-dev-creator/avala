<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="SurfaceWindowColor">#101114</Color>
      <Color x:Key="SurfacePanelColor">#18191D</Color>
      <Color x:Key="SurfaceFloatColor">#212228</Color>
      <Color x:Key="PanelTintColor">#1E1F24</Color>
      <Color x:Key="FloatTintColor">#282930</Color>
      <Color x:Key="AccentColor">#8DA2FB</Color>
      <Color x:Key="AttentionColor">#E5A13A</Color>
      <Color x:Key="FailureColor">#EF6461</Color>

      <SolidColorBrush x:Key="SurfaceWindowBrush" Color="#101114" />
      <SolidColorBrush x:Key="SurfacePanelBrush" Color="#18191D" />
      <SolidColorBrush x:Key="SurfaceFloatBrush" Color="#212228" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1C1D22" />
      <SolidColorBrush x:Key="SurfaceSelectedTabBrush" Color="#2E2F36" />
      <SolidColorBrush x:Key="FillSubtleBrush" Color="#0AFFFFFF" />
      <SolidColorBrush x:Key="FillQuietBrush" Color="#09FFFFFF" />
      <SolidColorBrush x:Key="FillHoverBrush" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="FillGhostHoverBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="FillSelectedBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="FillCodeBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="FillWellBrush" Color="#4D000000" />
      <SolidColorBrush x:Key="FillInputBrush" Color="#40000000" />
      <SolidColorBrush x:Key="MeterTrackBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="MeterTickBrush" Color="#66FFFFFF" />
      <SolidColorBrush x:Key="MeterTickNearBrush" Color="#99FFFFFF" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDEF" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A3AD" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#80808A" />
      <SolidColorBrush x:Key="TextDisabledBrush" Color="#4E4E56" />
      <SolidColorBrush x:Key="DotDoneBrush" Color="#45454D" />
      <SolidColorBrush x:Key="DotPendingBrush" Color="#5A5A63" />

      <SolidColorBrush x:Key="SeparatorBrush" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="SeparatorStrongBrush" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="EdgeBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="EdgeFloatBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="BorderControlBrush" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="BorderInputBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="BorderPillBrush" Color="#1AFFFFFF" />

      <SolidColorBrush x:Key="AccentBrush" Color="#8DA2FB" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#B3C1FF" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#148DA2FB" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#0F1220" />
      <SolidColorBrush x:Key="AttentionBrush" Color="#E5A13A" />
      <SolidColorBrush x:Key="AttentionBorderBrush" Color="#59E5A13A" />
      <SolidColorBrush x:Key="OnAttentionBrush" Color="#1B1407" />
      <SolidColorBrush x:Key="FailureBrush" Color="#EF6461" />
      <SolidColorBrush x:Key="FailureBorderBrush" Color="#59EF6461" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#6108080A" />
      <SolidColorBrush x:Key="ScrimSheetBrush" Color="#9908080A" />
      <SolidColorBrush x:Key="RingBrush" Color="#2EFFFFFF" />
      <SolidColorBrush x:Key="SurfacePopoverBrush" Color="#282930" />

      <SolidColorBrush x:Key="FillBubbleBrush" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="FillRowSelectedBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="#17181C" />
      <SolidColorBrush x:Key="SurfaceComposerBrush" Color="#C7282930" />
      <SolidColorBrush x:Key="BorderCardBrush" Color="#17FFFFFF" />
      <SolidColorBrush x:Key="BorderBlockBrush" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="BorderNodeBrush" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="BorderTagBrush" Color="#38FFFFFF" />
      <SolidColorBrush x:Key="AccentSelectedBrush" Color="#148DA2FB" />
      <LinearGradientBrush x:Key="ShimmerMaskBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Offset="0" Color="#00FFFFFF" />
        <GradientStop Offset="0.5" Color="#FFFFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
      </LinearGradientBrush>

      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#8DA2FB" />
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#8DA2FB" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#B3C1FF" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#8DA2FB" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0F1220" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0F1220" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0F1220" />
      <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#0AFFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#80808A" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#A3A3AD" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#8DA2FB" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#B3C1FF" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#8DA2FB" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#0F1220" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="SurfaceWindowColor">#FBFBFC</Color>
      <Color x:Key="SurfacePanelColor">#F3F3F6</Color>
      <Color x:Key="SurfaceFloatColor">#FFFFFF</Color>
      <Color x:Key="PanelTintColor">#EEEEF2</Color>
      <Color x:Key="FloatTintColor">#FFFFFF</Color>
      <Color x:Key="AccentColor">#4458CC</Color>
      <Color x:Key="AttentionColor">#A86400</Color>
      <Color x:Key="FailureColor">#C2362F</Color>

      <SolidColorBrush x:Key="SurfaceWindowBrush" Color="#FBFBFC" />
      <SolidColorBrush x:Key="SurfacePanelBrush" Color="#F3F3F6" />
      <SolidColorBrush x:Key="SurfaceFloatBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceSelectedTabBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="FillSubtleBrush" Color="#08000000" />
      <SolidColorBrush x:Key="FillQuietBrush" Color="#06000000" />
      <SolidColorBrush x:Key="FillHoverBrush" Color="#0A000000" />
      <SolidColorBrush x:Key="FillGhostHoverBrush" Color="#0D000000" />
      <SolidColorBrush x:Key="FillSelectedBrush" Color="#10000000" />
      <SolidColorBrush x:Key="FillCodeBrush" Color="#0B000000" />
      <SolidColorBrush x:Key="FillWellBrush" Color="#0D000000" />
      <SolidColorBrush x:Key="FillInputBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="MeterTrackBrush" Color="#12000000" />
      <SolidColorBrush x:Key="MeterTickBrush" Color="#4D000000" />
      <SolidColorBrush x:Key="MeterTickNearBrush" Color="#80000000" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5E5E66" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#76767E" />
      <SolidColorBrush x:Key="TextDisabledBrush" Color="#B4B4BA" />
      <SolidColorBrush x:Key="DotDoneBrush" Color="#C4C4CA" />
      <SolidColorBrush x:Key="DotPendingBrush" Color="#A8A8B0" />

      <SolidColorBrush x:Key="SeparatorBrush" Color="#12000000" />
      <SolidColorBrush x:Key="SeparatorStrongBrush" Color="#21000000" />
      <SolidColorBrush x:Key="EdgeBrush" Color="#10000000" />
      <SolidColorBrush x:Key="EdgeFloatBrush" Color="#14000000" />
      <SolidColorBrush x:Key="BorderControlBrush" Color="#21000000" />
      <SolidColorBrush x:Key="BorderInputBrush" Color="#1F000000" />
      <SolidColorBrush x:Key="BorderPillBrush" Color="#1C000000" />

      <SolidColorBrush x:Key="AccentBrush" Color="#4458CC" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#3546B0" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1A4458CC" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AttentionBrush" Color="#A86400" />
      <SolidColorBrush x:Key="AttentionBorderBrush" Color="#59A86400" />
      <SolidColorBrush x:Key="OnAttentionBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="FailureBrush" Color="#C2362F" />
      <SolidColorBrush x:Key="FailureBorderBrush" Color="#4DC2362F" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#2E1D1D1F" />
      <SolidColorBrush x:Key="ScrimSheetBrush" Color="#521D1D1F" />
      <SolidColorBrush x:Key="RingBrush" Color="#1F000000" />
      <SolidColorBrush x:Key="SurfacePopoverBrush" Color="#FFFFFF" />

      <SolidColorBrush x:Key="FillBubbleBrush" Color="#0D000000" />
      <SolidColorBrush x:Key="FillRowSelectedBrush" Color="#10000000" />
      <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceComposerBrush" Color="#EBFFFFFF" />
      <SolidColorBrush x:Key="BorderCardBrush" Color="#14000000" />
      <SolidColorBrush x:Key="BorderBlockBrush" Color="#12000000" />
      <SolidColorBrush x:Key="BorderNodeBrush" Color="#1C000000" />
      <SolidColorBrush x:Key="BorderTagBrush" Color="#2E000000" />
      <SolidColorBrush x:Key="AccentSelectedBrush" Color="#144458CC" />
      <LinearGradientBrush x:Key="ShimmerMaskBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Offset="0" Color="#00FFFFFF" />
        <GradientStop Offset="0.5" Color="#FFFFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
      </LinearGradientBrush>

      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#4458CC" />
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#4458CC" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#3546B0" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#4458CC" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#0D000000" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#76767E" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#5E5E66" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#4458CC" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#3546B0" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#4458CC" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

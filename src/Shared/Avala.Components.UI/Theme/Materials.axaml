<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="using:Avala.Components.UI.Theme">
  <Style Selector="ProgressBar.segmented">
    <Setter Property="OpacityMask">
      <DrawingBrush TileMode="Tile" DestinationRect="0,0,6,1" Stretch="None" AlignmentX="Left" AlignmentY="Top">
        <DrawingBrush.Drawing>
          <GeometryDrawing Brush="Black" Geometry="M0,0 H4 V1 H0 Z" />
        </DrawingBrush.Drawing>
      </DrawingBrush>
    </Setter>
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ProgressBar.segmented[(theme|Motion.IsReduced)=False]">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Value" Duration="0:0:0.6" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="theme|GridBackdrop">
    <Setter Property="LineBrush" Value="{DynamicResource GridLineBrush}" />
    <Setter Property="Spacing" Value="{StaticResource GridSpacing}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="Border.window">
    <Setter Property="Background" Value="{DynamicResource SurfaceWindowBrush}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
  </Style>

  <Style Selector="Border.edge">
    <Setter Property="Background" Value="{DynamicResource EdgeBrush}" />
    <Setter Property="Width" Value="1" />
  </Style>

  <Style Selector="Border.separator">
    <Setter Property="Background" Value="{DynamicResource EdgeBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="theme:Chamfer.Size" Value="{StaticResource ChamferCard}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusRow}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
  </Style>

  <Style Selector="Border.float">
    <Setter Property="theme:Chamfer.Size" Value="{StaticResource ChamferCard}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceFloatBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeFloatBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowFloat}" />
    <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
  </Style>

  <Style Selector="Border.quiet">
    <Setter Property="theme:Chamfer.Size" Value="{StaticResource ChamferCard}" />
    <Setter Property="Background" Value="{DynamicResource FillQuietBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusRow}" />
  </Style>

  <Style Selector="Border.well">
    <Setter Property="Background" Value="{DynamicResource FillWellBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusButton}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Border.empty">
    <Setter Property="theme:Chamfer.Size" Value="{StaticResource ChamferCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderPillBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
    <Setter Property="Padding" Value="16,28" />
  </Style>
  <Style Selector="Border.placeholder">
    <Setter Property="Height" Value="8" />
    <Setter Property="Width" Value="132" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
  </Style>
</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:graphs="using:Avala.Components.UI.Graphs"
        xmlns:theme="using:Avala.Components.UI.Theme">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="EdgeFlowingBrush" Color="#59FFFFFF" />
          <SolidColorBrush x:Key="EdgeAttentionBrush" Color="#80FFB547" />
          <SolidColorBrush x:Key="EdgeWaitingBrush" Color="#59FFB547" />
          <SolidColorBrush x:Key="EdgeQuietBrush" Color="#3DFFFFFF" />
          <SolidColorBrush x:Key="NodeBrush" Color="#FF1A1F27" />
          <SolidColorBrush x:Key="NodeBorderBrush" Color="#17FFFFFF" />
          <SolidColorBrush x:Key="NodeTipBrush" Color="#F01A1F27" />
          <SolidColorBrush x:Key="HubCoreBrush" Color="#11151B" />
          <SolidColorBrush x:Key="HubTrackBrush" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="MeterMarkerBrush" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="MeterMarkerQuietBrush" Color="#66FFFFFF" />
          <SolidColorBrush x:Key="SurfaceSectionBrush" Color="#09FFFFFF" />
          <SolidColorBrush x:Key="BorderSectionBrush" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="BorderProposedBrush" Color="#38FFFFFF" />
          <SolidColorBrush x:Key="ShareStrongBrush" Color="#9BA3AA" />
          <SolidColorBrush x:Key="ShareMiddleBrush" Color="#7A838B" />
          <SolidColorBrush x:Key="ShareQuietBrush" Color="#3A4148" />
          <SolidColorBrush x:Key="ShareFaintBrush" Color="#545C64" />
          <BoxShadows x:Key="ShadowNode">0 12 28 -12 #B3000000</BoxShadows>
          <BoxShadows x:Key="ShadowHub">0 0 0 1 #12FFFFFF, 0 24 48 -16 #B3000000</BoxShadows>
          <BoxShadows x:Key="ShadowTip">0 16 32 -10 #B3000000</BoxShadows>
          <BoxShadows x:Key="ShadowOrchestrator">0 20 40 -16 #BF000000</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="EdgeFlowingBrush" Color="#73000000" />
          <SolidColorBrush x:Key="EdgeAttentionBrush" Color="#A6744800" />
          <SolidColorBrush x:Key="EdgeWaitingBrush" Color="#73744800" />
          <SolidColorBrush x:Key="EdgeQuietBrush" Color="#59000000" />
          <SolidColorBrush x:Key="NodeBrush" Color="#FFF3F0E8" />
          <SolidColorBrush x:Key="NodeBorderBrush" Color="#17000000" />
          <SolidColorBrush x:Key="NodeTipBrush" Color="#F7F3F0E8" />
          <SolidColorBrush x:Key="HubCoreBrush" Color="#E6E1D4" />
          <SolidColorBrush x:Key="HubTrackBrush" Color="#2E000000" />
          <SolidColorBrush x:Key="MeterMarkerBrush" Color="#99000000" />
          <SolidColorBrush x:Key="MeterMarkerQuietBrush" Color="#4D000000" />
          <SolidColorBrush x:Key="SurfaceSectionBrush" Color="#06000000" />
          <SolidColorBrush x:Key="BorderSectionBrush" Color="#12000000" />
          <SolidColorBrush x:Key="BorderProposedBrush" Color="#2E000000" />
          <SolidColorBrush x:Key="ShareStrongBrush" Color="#5E584C" />
          <SolidColorBrush x:Key="ShareMiddleBrush" Color="#6F685B" />
          <SolidColorBrush x:Key="ShareQuietBrush" Color="#BDB6A6" />
          <SolidColorBrush x:Key="ShareFaintBrush" Color="#A39C8C" />
          <BoxShadows x:Key="ShadowNode">0 0 0 1 #0A000000, 0 12 28 -12 #33000000</BoxShadows>
          <BoxShadows x:Key="ShadowHub">0 0 0 1 #12000000, 0 24 48 -16 #33000000</BoxShadows>
          <BoxShadows x:Key="ShadowTip">0 0 0 1 #0F000000, 0 16 32 -10 #33000000</BoxShadows>
          <BoxShadows x:Key="ShadowOrchestrator">0 0 0 1 #0F000000, 0 20 40 -16 #3D000000</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static theme:Themes.Tide}">
          <SolidColorBrush x:Key="EdgeAttentionBrush" Color="#80FFC857" />
          <SolidColorBrush x:Key="EdgeWaitingBrush" Color="#59FFC857" />
          <SolidColorBrush x:Key="NodeBrush" Color="#FF132B36" />
          <SolidColorBrush x:Key="NodeTipBrush" Color="#F0132B36" />
          <SolidColorBrush x:Key="HubCoreBrush" Color="#0B1C24" />
          <SolidColorBrush x:Key="ShareStrongBrush" Color="#8FB7B8" />
          <SolidColorBrush x:Key="ShareMiddleBrush" Color="#6A9799" />
          <SolidColorBrush x:Key="ShareQuietBrush" Color="#2C4A50" />
          <SolidColorBrush x:Key="ShareFaintBrush" Color="#45666B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static theme:Themes.Unit}">
          <SolidColorBrush x:Key="EdgeAttentionBrush" Color="#80FFB000" />
          <SolidColorBrush x:Key="EdgeWaitingBrush" Color="#59FFB000" />
          <SolidColorBrush x:Key="NodeBrush" Color="#FF221A30" />
          <SolidColorBrush x:Key="NodeTipBrush" Color="#F0221A30" />
          <SolidColorBrush x:Key="HubCoreBrush" Color="#151020" />
          <SolidColorBrush x:Key="ShareStrongBrush" Color="#A89BB8" />
          <SolidColorBrush x:Key="ShareMiddleBrush" Color="#85789A" />
          <SolidColorBrush x:Key="ShareQuietBrush" Color="#3B3248" />
          <SolidColorBrush x:Key="ShareFaintBrush" Color="#584D68" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static theme:Themes.Ash}">
          <SolidColorBrush x:Key="EdgeAttentionBrush" Color="#80D9A55A" />
          <SolidColorBrush x:Key="EdgeWaitingBrush" Color="#59D9A55A" />
          <SolidColorBrush x:Key="NodeBrush" Color="#FF262421" />
          <SolidColorBrush x:Key="NodeTipBrush" Color="#F0262421" />
          <SolidColorBrush x:Key="HubCoreBrush" Color="#1A1917" />
          <SolidColorBrush x:Key="ShareStrongBrush" Color="#A39E95" />
          <SolidColorBrush x:Key="ShareMiddleBrush" Color="#857F77" />
          <SolidColorBrush x:Key="ShareQuietBrush" Color="#3E3B37" />
          <SolidColorBrush x:Key="ShareFaintBrush" Color="#58544E" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static theme:Themes.Bloom}">
          <SolidColorBrush x:Key="EdgeAttentionBrush" Color="#A68F5500" />
          <SolidColorBrush x:Key="EdgeWaitingBrush" Color="#738F5500" />
          <SolidColorBrush x:Key="NodeBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="NodeTipBrush" Color="#F7FFFFFF" />
          <SolidColorBrush x:Key="HubCoreBrush" Color="#F5EDEE" />
          <SolidColorBrush x:Key="ShareStrongBrush" Color="#6E5A62" />
          <SolidColorBrush x:Key="ShareMiddleBrush" Color="#7E6A72" />
          <SolidColorBrush x:Key="ShareQuietBrush" Color="#D9C9CF" />
          <SolidColorBrush x:Key="ShareFaintBrush" Color="#BFAEB5" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static theme:Themes.Signal}">
          <SolidColorBrush x:Key="EdgeAttentionBrush" Color="#80FFD000" />
          <SolidColorBrush x:Key="EdgeWaitingBrush" Color="#59FFD000" />
          <SolidColorBrush x:Key="NodeBrush" Color="#FF1A1A1A" />
          <SolidColorBrush x:Key="NodeTipBrush" Color="#F01A1A1A" />
          <SolidColorBrush x:Key="HubCoreBrush" Color="#0A0A0A" />
          <SolidColorBrush x:Key="ShareStrongBrush" Color="#D6D6D6" />
          <SolidColorBrush x:Key="ShareMiddleBrush" Color="#B0B0B0" />
          <SolidColorBrush x:Key="ShareQuietBrush" Color="#5A5A5A" />
          <SolidColorBrush x:Key="ShareFaintBrush" Color="#808080" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <CornerRadius x:Key="RadiusNode">2</CornerRadius>
      <CornerRadius x:Key="RadiusSection">2</CornerRadius>
      <CornerRadius x:Key="RadiusOrchestrator">3</CornerRadius>
      <x:Double x:Key="FontSizeTitleSmall">14</x:Double>
      <x:Double x:Key="FontSizeFigure">22</x:Double>
      <x:Double x:Key="FontSizeNode">12.5</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="graphs|HubGraphPanel, graphs|AgentTreePanel, graphs|C4GraphPanel">
    <Setter Property="graphs:EdgeBrushes.Flowing" Value="{DynamicResource EdgeFlowingBrush}" />
    <Setter Property="graphs:EdgeBrushes.Attention" Value="{DynamicResource EdgeAttentionBrush}" />
    <Setter Property="graphs:EdgeBrushes.Waiting" Value="{DynamicResource EdgeWaitingBrush}" />
    <Setter Property="graphs:EdgeBrushes.Failure" Value="{DynamicResource FailureBrush}" />
    <Setter Property="graphs:EdgeBrushes.Quiet" Value="{DynamicResource EdgeQuietBrush}" />
  </Style>

  <Style Selector="graphs|AgentTreePanel">
    <Setter Property="JointBrush" Value="{DynamicResource NodeBrush}" />
  </Style>

  <Style Selector="graphs|HubGraphPanel[(theme|Motion.IsReduced)=False], graphs|C4GraphPanel[(theme|Motion.IsReduced)=False]">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="graphs:EdgeBrushes.Phase" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="graphs:EdgeBrushes.Phase" Value="-20" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Button.hud">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.hud.wide">
    <Setter Property="Width" Value="48" />
  </Style>
  <Style Selector="Button.hud:disabled Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextDisabledBrush}" />
  </Style>
  <Style Selector="Button.hud:disabled TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
  </Style>
  <Style Selector="Button.hud.play">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <Style Selector="graphs|C4GraphPanel">
    <Setter Property="LabelBrush" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="LabelPlateBrush" Value="{DynamicResource NodeBrush}" />
    <Setter Property="LabelSize" Value="{DynamicResource FontSizeHint}" />
    <Setter Property="FrameLabelBrush" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="BadgeBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BadgeTextBrush" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="graphs:EdgeBrushes.Flowing" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Border.grouped">
    <Setter Property="Background" Value="{DynamicResource SurfaceSectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSectionBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSection}" />
  </Style>

  <Style Selector="Border.node">
    <Setter Property="Background" Value="{DynamicResource NodeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NodeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusNode}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowNode}" />
  </Style>
  <Style Selector="Border.node.attention">
    <Setter Property="BorderBrush" Value="{DynamicResource AttentionBorderBrush}" />
  </Style>
  <Style Selector="Border.node.viewing">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Rectangle.subagent">
    <Setter Property="Stroke" Value="{DynamicResource BorderTagBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="3,2" />
    <Setter Property="RadiusX" Value="11" />
    <Setter Property="RadiusY" Value="11" />
  </Style>
  <Style Selector="Rectangle.subagent.waiting">
    <Setter Property="Stroke" Value="{DynamicResource AttentionBorderBrush}" />
  </Style>

  <Style Selector="Border.node.inside">
    <Setter Property="Background" Value="{DynamicResource FillSubtleBrush}" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="Border.node.cross">
    <Setter Property="BorderThickness" Value="1,3,1,1" />
  </Style>
  <Style Selector="Border.node.alert">
    <Setter Property="BorderBrush" Value="{DynamicResource FailureBorderBrush}" />
  </Style>
  <Style Selector="Border.node.settled">
    <Setter Property="Opacity" Value="0.72" />
  </Style>
  <Style Selector="Border.node[(theme|Motion.IsReduced)=False]">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.32" Easing="0.22,1,0.36,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.state">
    <Setter Property="Background" Value="{DynamicResource FillSubtleBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Border.state[(theme|Motion.IsReduced)=False]">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.state TextBlock[(theme|Motion.IsReduced)=False]">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.state TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeHint}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.state :is(Shape)">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.state.working">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>
  <Style Selector="Border.state.working TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.state.working :is(Shape)">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.state.waiting">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AttentionBorderBrush}" />
  </Style>
  <Style Selector="Border.state.waiting TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AttentionBrush}" />
  </Style>
  <Style Selector="Border.state.waiting :is(Shape)">
    <Setter Property="Stroke" Value="{DynamicResource AttentionBrush}" />
  </Style>
  <Style Selector="Border.state.alert">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FailureBorderBrush}" />
  </Style>
  <Style Selector="Border.state.alert TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FailureBrush}" />
  </Style>
  <Style Selector="Border.state.alert :is(Shape)">
    <Setter Property="Stroke" Value="{DynamicResource FailureBrush}" />
  </Style>
  <Style Selector="TextBlock.note.waiting">
    <Setter Property="Foreground" Value="{DynamicResource AttentionBrush}" />
  </Style>
  <Style Selector="TextBlock.note.alert">
    <Setter Property="Foreground" Value="{DynamicResource FailureBrush}" />
  </Style>

  <Style Selector="Border.tag.proposed">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderProposedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Padding" Value="6,1" />
  </Style>

  <Style Selector="Border.pageHeader">
    <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{DynamicResource PageHeaderPadding}" />
  </Style>

  <Style Selector="Border.pageHeader[(theme|Chrome.IsFocusMode)=True]">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitleSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector="TextBlock.figure">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeFigure}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.44" />
    <Setter Property="LineHeight" Value="28" />
  </Style>
  <Style Selector="TextBlock.node">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNode}" />
  </Style>
  <Style Selector="TextBlock.hint.mono">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
    <Setter Property="LineHeight" Value="16" />
  </Style>
  <Style Selector="TextBlock.caption.mono">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeHint}" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>

  <Style Selector="Button.link.emphasis">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
  </Style>
  <Style Selector="Button.link.emphasis:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
  </Style>

  <Style Selector="ProgressBar.bar">
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource MeterTrackBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ProgressBar.bar.thick">
    <Setter Property="Height" Value="6" />
  </Style>
  <Style Selector="ProgressBar.bar.attention">
    <Setter Property="Foreground" Value="{DynamicResource AttentionBrush}" />
  </Style>
  <Style Selector="ProgressBar.marker">
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="Transparent" />
  </Style>
  <Style Selector="ProgressBar.marker /template/ Border#PART_Indicator">
    <Setter Property="BorderBrush" Value="{DynamicResource MeterMarkerQuietBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1.5,0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ProgressBar.marker.attention /template/ Border#PART_Indicator">
    <Setter Property="BorderBrush" Value="{DynamicResource MeterMarkerBrush}" />
  </Style>

  <Style Selector="Border.segments">
    <Setter Property="Background" Value="{DynamicResource FillWellBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusButton}" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Button.segment">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMono}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.segment.selected">
    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedTabBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.segment.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedTabBrush}" />
  </Style>

  <Style Selector="Button.swatch">
    <Setter Property="Padding" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
  </Style>
  <Style Selector="Button.swatch.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.swatch.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.swatch-face">
    <Setter Property="Width" Value="96" />
    <Setter Property="Height" Value="58" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource SurfaceWindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.swatch-line">
    <Setter Property="Height" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.swatch-dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
  </Style>

  <Style Selector="Button.bare">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="0.34,1.4,0.64,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.bare:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.03)" />
  </Style>
  <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.bare:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>


  <Style Selector="Expander.disclosure">
    <Style.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ExpanderChevronForeground" Color="#80808A" />
            <SolidColorBrush x:Key="ExpanderChevronForegroundPointerOver" Color="#EDEDEF" />
            <SolidColorBrush x:Key="ExpanderChevronForegroundPressed" Color="#EDEDEF" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#0A000000" />
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#10000000" />
            <SolidColorBrush x:Key="ExpanderChevronForeground" Color="#76767E" />
            <SolidColorBrush x:Key="ExpanderChevronForegroundPointerOver" Color="#1D1D1F" />
            <SolidColorBrush x:Key="ExpanderChevronForegroundPressed" Color="#1D1D1F" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="Transparent" />
      </ResourceDictionary>
    </Style.Resources>
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSectionBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSection}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
</Styles>

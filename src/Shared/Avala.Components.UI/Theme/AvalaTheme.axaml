<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Avala.Components.UI/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://Avala.Components.UI/Theme/Metrics.axaml" />
        <ResourceInclude Source="avares://Avala.Components.UI/Theme/Icons.axaml" />
        <ResourceInclude Source="avares://Avala.Components.UI/Theme/Fold.axaml" />
        <ResourceInclude Source="avares://Avala.Components.UI/Theme/Portrait.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <FluentTheme>
    <FluentTheme.Palettes>
      <ColorPaletteResources x:Key="Dark"
                             Accent="#FF3B55"
                             RegionColor="#0B0E12"
                             BaseHigh="#E9E6DF"
                             ErrorText="#FF5468" />
      <ColorPaletteResources x:Key="Light"
                             Accent="#B3122E"
                             RegionColor="#DCD6C7"
                             BaseHigh="#36322A"
                             ErrorText="#A8102A" />
    </FluentTheme.Palettes>
  </FluentTheme>
  <StyleInclude Source="avares://Avala.Components.UI/Theme/Typography.axaml" />
  <StyleInclude Source="avares://Avala.Components.UI/Theme/Materials.axaml" />
  <StyleInclude Source="avares://Avala.Components.UI/Theme/Motion.axaml" />
  <StyleInclude Source="avares://Avala.Components.UI/Theme/Controls.axaml" />
  <StyleInclude Source="avares://Avala.Components.UI/Theme/Graphs.axaml" />
  <StyleInclude Source="avares://Avala.Components.UI/Theme/Marks.axaml" />
</Styles>

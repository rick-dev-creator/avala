<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mv="using:MarkView.Avalonia"
        xmlns:markdown="using:Avala.Components.UI.Markdown">
  <StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml" />
  <Style Selector="mv|MarkdownViewer">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector=":is(TextBlock).markdown-paragraph">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).markdown-h1">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).markdown-h2">
    <Setter Property="Margin" Value="0,12,0,6" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).markdown-h3, :is(TextBlock).markdown-h4, :is(TextBlock).markdown-h5, :is(TextBlock).markdown-h6">
    <Setter Property="Margin" Value="0,10,0,4" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeReading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.markdown-code-block">
    <Setter Property="Background" Value="{DynamicResource FillWellBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusButton}" />
  </Style>
  <Style Selector="Border.markdown-code-block TextBlock, Border.markdown-code-block SelectableTextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMono}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.markdown-code">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,0,24,0" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="Border.markdown-code-block TextBlock.code-language">
    <Setter Property="Margin" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeHint}" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="Grid.code-header">
    <Setter Property="Margin" Value="0,-6,-8,4" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Button.code-action">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="Border.markdown-code-block:pointerover Button.code-action, Button.code-copy:copied, Button.code-action:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.code-action:pointerover, Button.code-action.on">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(StackPanel).reading :is(TextBlock).markdown-paragraph">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeReading}" />
    <Setter Property="LineHeight" Value="23" />
  </Style>
  <Style Selector=":is(StackPanel).compact :is(TextBlock).markdown-h1, :is(StackPanel).compact :is(TextBlock).markdown-h2, :is(StackPanel).compact :is(TextBlock).markdown-h3, :is(StackPanel).compact :is(TextBlock).markdown-h4, :is(StackPanel).compact :is(TextBlock).markdown-h5, :is(StackPanel).compact :is(TextBlock).markdown-h6">
    <Setter Property="Margin" Value="0,10,0,2" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ScrollViewer.markdown-table-scroller">
    <Setter Property="Margin" Value="0,2,0,2" />
  </Style>
  <Style Selector="Border.markdown-alert">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource FillQuietBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusButton}" />
    <Setter Property="Padding" Value="12,8,12,8" />
    <Setter Property="Margin" Value="0,2,0,2" />
  </Style>
  <Style Selector="Border.markdown-alert-warning">
    <Setter Property="BorderBrush" Value="{DynamicResource AttentionBrush}" />
  </Style>
  <Style Selector="Border.markdown-alert-caution">
    <Setter Property="BorderBrush" Value="{DynamicResource FailureBrush}" />
  </Style>
  <Style Selector="Border.markdown-alert TextBlock.markdown-alert-header">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector="Border.markdown-alert-warning TextBlock.markdown-alert-header">
    <Setter Property="Foreground" Value="{DynamicResource AttentionBrush}" />
  </Style>
  <Style Selector="Border.markdown-alert-caution TextBlock.markdown-alert-header">
    <Setter Property="Foreground" Value="{DynamicResource FailureBrush}" />
  </Style>
  <Style Selector=":is(StackPanel).markdown-footnote-group">
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style Selector=":is(StackPanel).markdown-footnote-group :is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="markdown|MathFormula.markdown-math">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.markdown-math-source">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMono}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="markdown|MathFormula.markdown-math-block">
    <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeReading}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,6,0,6" />
  </Style>
  <Style Selector="Run.markdown-code-inline">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMono}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource FillCodeBrush}" />
  </Style>
  <Style Selector="Border.markdown-blockquote">
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorStrongBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.markdown-table-cell, Border.markdown-table-header">
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
  </Style>
  <Style Selector="Border.markdown-table-header">
    <Setter Property="Background" Value="{DynamicResource FillSubtleBrush}" />
  </Style>
  <Style Selector="HyperlinkButton.markdown-link">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Separator.markdown-thematic-break">
    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
  </Style>
</Styles>
